{
  "name": "atmosphereconf",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "sites/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @atmosphereconf/2027 dev",
    "build": "pnpm --filter @atmosphereconf/2027 build",
    "start": "pnpm --filter @atmosphereconf/2027 start",
    "preview": "pnpm --filter @atmosphereconf/2027 preview",
    "astro": "pnpm --filter @atmosphereconf/2027 astro",
    "format": "pnpm --filter @atmosphereconf/2027 format",
    "sync-schedule": "pnpm --filter @atmosphereconf/2026 sync-schedule",
    "test": "pnpm --filter @atmosphereconf/2026 test",
    "test:visual": "pnpm --filter @atmosphereconf/2026 test:visual",
    "test:visual:ui": "pnpm --filter @atmosphereconf/2026 test:visual:ui",
    "test:visual:update": "pnpm --filter @atmosphereconf/2026 test:visual:update",
    "test:visual:report": "pnpm --filter @atmosphereconf/2026 test:visual:report",
    "dev:2026": "pnpm --filter @atmosphereconf/2026 dev",
    "build:2026": "pnpm --filter @atmosphereconf/2026 build",
    "start:2026": "pnpm --filter @atmosphereconf/2026 start",
    "preview:2026": "pnpm --filter @atmosphereconf/2026 preview",
    "astro:2026": "pnpm --filter @atmosphereconf/2026 astro",
    "format:2026": "pnpm --filter @atmosphereconf/2026 format",
    "sync-schedule:2026": "pnpm --filter @atmosphereconf/2026 sync-schedule",
    "test:2026": "pnpm --filter @atmosphereconf/2026 test",
    "test:visual:2026": "pnpm --filter @atmosphereconf/2026 test:visual",
    "test:visual:ui:2026": "pnpm --filter @atmosphereconf/2026 test:visual:ui",
    "test:visual:update:2026": "pnpm --filter @atmosphereconf/2026 test:visual:update",
    "test:visual:report:2026": "pnpm --filter @atmosphereconf/2026 test:visual:report",
    "dev:2027": "pnpm --filter @atmosphereconf/2027 dev",
    "build:2027": "pnpm --filter @atmosphereconf/2027 build",
    "start:2027": "pnpm --filter @atmosphereconf/2027 start",
    "preview:2027": "pnpm --filter @atmosphereconf/2027 preview",
    "astro:2027": "pnpm --filter @atmosphereconf/2027 astro",
    "build:all": "pnpm -r --parallel build"
  },
  "overrides": {
    "@atproto-labs/fetch-node": "^0.3.7",
    "@atproto-labs/handle-resolver-node": "^0.2.8"
  },
  "allowScripts": {
    "esbuild": true
  },
  "packageManager": "pnpm@12.14.0"
}
