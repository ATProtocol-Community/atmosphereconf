    "dev:2026": "npm --workspace @atmosphereconf/2026 run dev --",
    "build:2026": "npm --workspace @atmosphereconf/2026 run build --",
    "start:2026": "npm --workspace @atmosphereconf/2026 run start --",
    "preview:2026": "npm --workspace @atmosphereconf/2026 run preview --",
    "astro:2026": "npm --workspace @atmosphereconf/2026 run astro --",
