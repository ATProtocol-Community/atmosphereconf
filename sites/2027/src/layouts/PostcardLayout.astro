---
import ThemeSwitcher from "../components/ThemeSwitcher.astro";
import "../styles/airmail.css";

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
const cloudShapes = [
	"M30 88C12 88 4 77 4 64C4 49 15 39 30 39C33 22 46 13 62 17C73 -1 105 0 116 22C135 16 151 28 152 42C172 42 185 52 185 67C185 81 174 90 159 90Z",
	"M31 83C12 84 3 72 5 58C6 44 18 36 32 37C34 21 49 14 64 20C71 5 92 1 107 11C115 16 120 24 122 33C140 25 158 35 160 49C177 48 187 59 184 72C182 87 165 93 150 86C140 99 121 101 107 89C92 103 70 99 61 87C48 96 36 91 31 83Z",
	"M27 87C12 87 4 77 4 64C4 50 16 39 32 40C29 24 42 13 58 18C67 0 94 0 108 12C115 18 119 25 120 32C138 29 154 40 154 54C171 53 183 63 182 76C181 90 167 95 152 88C141 103 123 99 115 88Z",
];
const clouds = [
	{ shape: 0, width: 140, top: "7%", duration: 67, delay: 12, rest: 12 },
	{ shape: 1, width: 160, top: "88%", duration: 73, delay: 48, rest: 65 },
	...Array.from({ length: 6 }, (_, index) => ({
		shape: index % cloudShapes.length,
		width: [150, 185, 125, 165, 140, 180][index],
		top: `calc(var(--picture-top, 180px) + var(--picture-height, 600px) * ${[0.12, 0.32, 0.48, 0.23, 0.42, 0.16][index]})`,
		duration: 60,
		delay: index * 10,
		rest: [12, 28, 42, 58, 72, 85][index],
	})),
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<link rel="icon" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@10..48,75..100,400..800&family=DM+Sans:opsz,wght@9..40,400..800&family=Outfit:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content="/og.png" />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="en" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<!-- Astro streams the page, so the first frame can land before the
		     card has fully arrived. The flip snapshots that frame, which then
		     shows a blank card. Holding rendering until the card is parsed
		     keeps the snapshot whole. -->
		<link rel="expect" href="#postcard" blocking="render" />
		<script is:inline>
			// The postcard only flips on the way forward. Going back through
			// history just swaps pages. Has to be inline in <head> so the
			// listener exists before the new page's first frame.
			window.addEventListener("pagereveal", (event) => {
				if (
					event.viewTransition &&
					window.navigation?.activation?.navigationType === "traverse"
				) {
					event.viewTransition.skipTransition();
				}
				// On short screens the page scrolls, and a fresh page would
				// start at the top and yank the card out from under the flip.
				// Pick up where the last page left off instead. History
				// navigations restore their own scroll, so they skip this.
				const scroll = sessionStorage.getItem("2027:scroll");
				sessionStorage.removeItem("2027:scroll");
				if (event.viewTransition && scroll !== null) {
					// Instant, or the site's smooth scrolling would glide down
					// from the top mid-flip.
					window.scrollTo({ top: Number(scroll), behavior: "instant" });
				}
			});
			// "← Back to…" links are regular navigations to the browser, but
			// they should feel like going back, so they don't flip either.
			let backLinkClicked = false;
			document.addEventListener("click", (event) => {
				backLinkClicked = !!event.target.closest?.("a[data-no-flip]");
			});
			window.addEventListener("pageswap", (event) => {
				if (!event.viewTransition) return;
				if (backLinkClicked) {
					event.viewTransition.skipTransition();
					return;
				}
				if (event.activation?.navigationType !== "traverse") {
					sessionStorage.setItem("2027:scroll", String(window.scrollY));
				}
			});
		</script>
		<slot name="head" />
		<script is:inline>
			// After the head slot, so a page can read the previous visit
			// before this overwrites it with the current one.
			try {
				localStorage.setItem("2027:last-visit", new Date().toISOString());
			} catch {
				// no storage access, nothing to remember
			}
		</script>
	</head>
	<body data-palette="sky" data-direction="editorial">
		<script is:inline>
			// Runs before the page paints, so the stored palette is already on
			// <body> by the first frame.
			try {
				const stored = localStorage.getItem("2027:page-theme");
				if (stored) {
					document.documentElement.dataset.theme = stored;
					document.body.dataset.palette = stored;
				}
			} catch {
				// no storage access, keep the server-rendered default
			}
		</script>
		<div class="page-sky" aria-hidden="true">
			{
				clouds.map((cloud) => (
					<svg
						class="cloud"
						viewBox="0 0 190 105"
						style={`--cloud-top: ${cloud.top}; --cloud-width: ${cloud.width}px; --cloud-duration: ${cloud.duration}s; --cloud-delay: -${cloud.delay}s; --cloud-rest: ${cloud.rest}%;`}
					>
						<path d={cloudShapes[cloud.shape]} />
					</svg>
				))
			}
		</div>
		<a class="skip-link" href="#postcard">Skip to postcard</a>
		<header class="masthead">
			<a class="wordmark" href="/" aria-label="AtmosphereConf home"
				>AtmosphereConf <small>2027</small></a
			>
			<ThemeSwitcher />
		</header>
		<main><slot /></main>
	</body>
</html>

<script>
	const picture = document.querySelector<HTMLElement>(".picture");
	const sky = document.querySelector<HTMLElement>(".page-sky");
	if (picture && sky) {
		const alignClouds = () => {
			const frame = picture.getBoundingClientRect();
			const field = sky.getBoundingClientRect();
			sky.style.setProperty("--picture-top", `${frame.top - field.top}px`);
			sky.style.setProperty("--picture-height", `${frame.height}px`);
		};
		const cloudLayout = new ResizeObserver(alignClouds);
		cloudLayout.observe(document.body);
		cloudLayout.observe(picture);
		const header = document.querySelector(".masthead");
		if (header) cloudLayout.observe(header);
		alignClouds();
	}
</script>

<style>
	:global(html) {
		height: 100%;
	}
	:global(body) {
		position: relative;
		display: grid;
		height: 100vh;
		min-height: 100vh;
		height: 100dvh;
		min-height: 100dvh;
		grid-template-rows: 92px minmax(0, 1fr);
	}
	.page-sky {
		position: absolute;
		inset: 0;
		z-index: 0;
		overflow: hidden;
		pointer-events: none;
	}
	.cloud {
		position: absolute;
		top: var(--cloud-top);
		left: 0;
		width: var(--cloud-width);
		height: auto;
		fill: var(--paper);
		opacity: 0.55;
		animation: drift var(--cloud-duration) linear var(--cloud-delay) infinite;
	}
	@keyframes drift {
		from {
			left: 0;
			transform: translateX(-100%);
		}
		to {
			left: 100%;
			transform: translateX(0);
		}
	}
	:global(.masthead) {
		position: relative;
		grid-column: 1;
		grid-row: 1;
		z-index: 2;
		height: 92px;
		min-height: 92px;
		container-type: inline-size;
	}
	:global(main) {
		position: relative;
		grid-column: 1;
		grid-row: 1 / -1;
		display: grid;
		min-height: 0;
		place-items: center;
		padding-block: 0;
		z-index: 1;
	}
	:global(.visually-hidden) {
		display: none;
	}
	/* Too short to center the card over the masthead without the two
	   colliding, so stack it below and let the page scroll. Threshold
	   matches the one in PostcardFrame. */
	@media (min-width: 661px) and (max-height: 840px) {
		:global(body) {
			height: auto;
		}
		:global(main) {
			grid-row: 2;
			padding-bottom: 32px;
		}
	}
	@media (max-width: 660px) {
		.cloud:nth-child(4),
		.cloud:nth-child(6),
		.cloud:nth-child(8) {
			display: none;
		}
		:global(body) {
			height: auto;
			grid-template-rows: 80px auto;
		}
		:global(main) {
			grid-row: unset;
			min-height: calc(100vh - 80px);
			min-height: calc(100dvh - 80px);
			align-items: safe center;
			padding-bottom: 15px;
		}
		:global(.masthead) {
			height: 80px;
			min-height: 80px;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.cloud {
			left: var(--cloud-rest);
			animation: none;
		}
	}
</style>
