---
import ThemeSwitcher from "../components/theme/ThemeSwitcher.astro";
import { cloudShapes } from "../components/lib/cloud-shapes";
import ThemeInit from "../components/theme/ThemeInit.astro";
import "../styles/airmail.css";
import "../styles/heading-anchors.css";
import { ogImageUrl, type OgImage } from "../og/pages";

interface Props {
	title: string;
	description: string;
	ogImage?: OgImage;
}

const { title, description, ogImage = "home" } = Astro.props;
const clouds = [
	{ shape: 0, width: 140, top: "7%", duration: 67, delay: 12, rest: 12 },
	{ shape: 1, width: 160, top: "88%", duration: 73, delay: 48, rest: 65 },
	...Array.from({ length: 6 }, (_, index) => ({
		shape: index % cloudShapes.length,
		width: [150, 185, 125, 165, 140, 180][index],
		top: `calc(var(--picture-top, 180px) + var(--picture-height, 600px) * ${[0.12, 0.32, 0.48, 0.23, 0.42, 0.16][index]})`,
		duration: 60,
		delay: index * 10,
		rest: [12, 28, 42, 58, 72, 85][index],
	})),
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<link rel="icon" href="/favicon-32.png" sizes="32x32" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@10..48,75..100,400..800&family=DM+Sans:opsz,wght@9..40,400..800&family=Outfit:wght@400;500;600;700;800&family=Kaushan+Script&family=Pacifico&family=Yellowtail&family=Leckerli+One&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageUrl(ogImage, Astro)} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="en" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<!-- Astro streams the page, so the first frame can land before the
		     card has fully arrived. The flip snapshots that frame, which then
		     shows a blank card. Holding rendering until the card is parsed
		     keeps the snapshot whole. -->
		<link rel="expect" href="#postcard" blocking="render" />
		<script is:inline>
			// The postcard only flips on the way forward. Going back through
			// history just swaps pages. Has to be inline in <head> so the
			// listener exists before the new page's first frame.
			window.addEventListener("pagereveal", (event) => {
				if (
					event.viewTransition &&
					window.navigation?.activation?.navigationType === "traverse"
				) {
					event.viewTransition.skipTransition();
				}
				// On short screens the page scrolls, and a fresh page would
				// start at the top and yank the card out from under the flip.
				// Pick up where the last page left off instead. History
				// navigations restore their own scroll, so they skip this.
				const scroll = sessionStorage.getItem("2027:scroll");
				sessionStorage.removeItem("2027:scroll");
				if (event.viewTransition && scroll !== null) {
					// Instant, or the site's smooth scrolling would glide down
					// from the top mid-flip.
					window.scrollTo({ top: Number(scroll), behavior: "instant" });
				}
			});
			// "← Back to…" links are regular navigations to the browser, but
			// they should feel like going back, so they don't flip either.
			let backLinkClicked = false;
			document.addEventListener("click", (event) => {
				backLinkClicked = !!event.target.closest?.("a[data-no-flip]");
			});
			window.addEventListener("pageswap", (event) => {
				if (!event.viewTransition) return;
				if (backLinkClicked) {
					event.viewTransition.skipTransition();
					return;
				}
				if (event.activation?.navigationType !== "traverse") {
					sessionStorage.setItem("2027:scroll", String(window.scrollY));
				}
			});
		</script>
		<slot name="head" />
	</head>
	<body data-palette="sky" data-direction="editorial">
		<ThemeInit />
		<div class="page-sky" aria-hidden="true">
			{
				clouds.map((cloud) => (
					<svg
						class="cloud"
						viewBox="0 0 190 105"
						style={`--cloud-top: ${cloud.top}; --cloud-width: ${cloud.width}px; --cloud-duration: ${cloud.duration}s; --cloud-delay: -${cloud.delay}s; --cloud-rest: ${cloud.rest}%;`}
					>
						<path d={cloudShapes[cloud.shape]} />
					</svg>
				))
			}
		</div>
		<a class="skip-link" href="#postcard">Skip to postcard</a>
		<header class="masthead">
			<a class="wordmark" href="/" aria-label="AtmosphereConf home"
				>AtmosphereConf <small>2027</small></a
			>
			<div class="masthead-actions">
				<ThemeSwitcher />
				<a
					class="github-link"
					href="https://github.com/ATProtocol-Community/atmosphereconf"
					aria-label="AtmosphereConf GitHub repository"
					title="GitHub repository"
				>
					<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path
							d="M12 .75a11.25 11.25 0 0 0-3.558 21.923c.563.104.768-.244.768-.543 0-.267-.01-.974-.015-1.912-3.13.68-3.791-1.508-3.791-1.508-.512-1.3-1.25-1.646-1.25-1.646-1.023-.7.078-.686.078-.686 1.13.08 1.725 1.16 1.725 1.16 1.006 1.724 2.64 1.226 3.283.938.102-.729.394-1.226.715-1.508-2.499-.284-5.126-1.25-5.126-5.565 0-1.23.44-2.233 1.16-3.02-.116-.284-.503-1.428.11-2.977 0 0 .945-.303 3.094 1.153A10.79 10.79 0 0 1 12 6.18c.956.004 1.918.13 2.817.379 2.148-1.456 3.092-1.153 3.092-1.153.615 1.549.228 2.693.112 2.977.722.787 1.158 1.79 1.158 3.02 0 4.327-2.631 5.278-5.138 5.557.404.349.765 1.034.765 2.084 0 1.504-.014 2.717-.014 3.086 0 .302.202.652.774.542A11.25 11.25 0 0 0 12 .75Z"
						></path>
					</svg>
				</a>
			</div>
		</header>
		<main><slot /></main>
	</body>
</html>

<script>
	import "../components/lib/heading-anchors";
	if (window.self === window.top) {
		document.querySelector<HTMLElement>("[data-focus-on-load]")?.focus();
	}

	const picture = document.querySelector<HTMLElement>(".picture");
	const sky = document.querySelector<HTMLElement>(".page-sky");
	if (picture && sky) {
		const alignClouds = () => {
			const frame = picture.getBoundingClientRect();
			const field = sky.getBoundingClientRect();
			sky.style.setProperty("--picture-top", `${frame.top - field.top}px`);
			sky.style.setProperty("--picture-height", `${frame.height}px`);
		};
		const cloudLayout = new ResizeObserver(alignClouds);
		cloudLayout.observe(document.body);
		cloudLayout.observe(picture);
		const header = document.querySelector(".masthead");
		if (header) cloudLayout.observe(header);
		alignClouds();
	}
</script>

<style>
	.masthead-actions {
		display: flex;
		align-items: center;
		gap: 12px;
		flex: 0 0 170px;
	}
	.github-link {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 28px;
		height: 28px;
		flex: none;
		border-radius: 50%;
	}
	.github-link svg {
		width: 22px;
		height: 22px;
	}
	.github-link:focus-visible {
		outline: 2px solid var(--ink);
		outline-offset: 2px;
	}
	@container (max-width: 480px) {
		.masthead-actions {
			flex-basis: 64px;
			gap: 8px;
		}
	}
	@container (max-width: 320px) {
		.wordmark {
			font-size: 22px;
		}
	}
	:global(html) {
		height: 100%;
	}
	:global(body) {
		position: relative;
		display: grid;
		height: 100vh;
		min-height: 100vh;
		height: 100dvh;
		min-height: 100dvh;
		grid-template-rows: 92px minmax(0, 1fr);
	}
	.page-sky {
		position: absolute;
		inset: 0;
		z-index: 0;
		overflow: hidden;
		pointer-events: none;
	}
	.cloud {
		position: absolute;
		top: var(--cloud-top);
		left: 0;
		width: var(--cloud-width);
		height: auto;
		fill: var(--paper);
		opacity: 0.55;
		animation: drift var(--cloud-duration) linear var(--cloud-delay) infinite;
	}
	@keyframes drift {
		from {
			left: 0;
			transform: translateX(-100%);
		}
		to {
			left: 100%;
			transform: translateX(0);
		}
	}
	:global(.masthead) {
		position: relative;
		grid-column: 1;
		grid-row: 1;
		z-index: 2;
		height: 92px;
		min-height: 92px;
		container-type: inline-size;
	}
	:global(main) {
		position: relative;
		grid-column: 1;
		grid-row: 1 / -1;
		display: grid;
		min-height: 0;
		place-items: center;
		padding-block: 0;
		z-index: 1;
	}
	:global(.visually-hidden) {
		display: none;
	}
	/* Too short to center the card over the masthead without the two
	   colliding, so stack it below and let the page scroll. Threshold
	   matches the one in PostcardFrame. */
	@media (min-width: 661px) and (max-height: 840px) {
		:global(body) {
			height: auto;
		}
		:global(main) {
			grid-row: 2;
			padding-bottom: 32px;
		}
	}
	@media (max-width: 660px) {
		.cloud:nth-child(4),
		.cloud:nth-child(6),
		.cloud:nth-child(8) {
			display: none;
		}
		:global(body) {
			height: auto;
			grid-template-rows: 80px auto;
		}
		:global(main) {
			grid-row: unset;
			min-height: calc(100vh - 80px);
			min-height: calc(100dvh - 80px);
			align-items: safe center;
			padding-bottom: 15px;
		}
		:global(.masthead) {
			height: 80px;
			min-height: 80px;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.cloud {
			left: var(--cloud-rest);
			animation: none;
		}
	}
</style>
