---
import { event } from "../../data/science";
import RevealWords from "../site//RevealWords.astro";

interface Props {
	reveal?: boolean;
	class?: string;
}

const { reveal = false, class: className } = Astro.props;

/** Dates and venue as a definition list, sized for the hero and invite sections. */
const term = "eyebrow text-[10px] md:text-sm/4";
const value =
	"mt-2 font-display text-sm/6 uppercase md:mt-4 md:text-lg/10 lg:text-xl/10";
---

<dl
	class:list={[
		"mb-7 flex flex-wrap justify-center gap-6 text-left md:mb-10 md:gap-12 lg:gap-20",
		className,
	]}
>
	<div>
		<dt class={term}>
			{reveal ? <RevealWords text="Two days" /> : "Two days"}
		</dt><dd class={value}>
			{reveal ? <RevealWords text={event.dates} /> : event.dates}
		</dd>
	</div><div>
		<dt class={term}>
			{reveal ? <RevealWords text="Where" /> : "Where"}
		</dt><dd class={value}>
			{reveal ? <RevealWords text={event.venue} /> : event.venue}
		</dd>
	</div><div>
		<dt class={term}>
			{reveal ? <RevealWords text="Side event at" /> : "Side event at"}
		</dt><dd class={value}>
			{reveal ? <RevealWords text="AtmosphereConf" /> : "AtmosphereConf"}
		</dd>
	</div>
</dl>
