---
import puffy from "../../../images/clouds/puffy.svg?url";
import long from "../../../images/clouds/long.svg?url";
import atscienceMark from "../../../images/logo/atscience-mark.svg?url";
import sciosMark from "../../../images/logo/scios-mark.svg?url";

const organizers = [
	{
		name: "ATScience",
		mark: atscienceMark,
		establishedYear: "2025",
		href: "https://atproto.science/",
		domain: "atproto.science",
		description:
			"ATScience builds communities and tools for publishing, curating, sharing and discussing research online with AT Protocol and other decentralized protocols.",
	},
	{
		name: "IOSP",
		mark: sciosMark,
		establishedYear: "2024",
		href: "https://www.iosp.science/",
		domain: "iosp.science",
		description:
			"Institute of Open Science Practices (IOSP) brings researchers and the people building open science infrastructure together to work on shared problems.",
	},
];
---

<section
	id="organizers"
	class="relative isolate overflow-hidden sky-gradient"
	aria-labelledby="organizers-title"
>
	<div class="pointer-events-none absolute inset-0 -z-1" aria-hidden="true">
		<img
			class="absolute top-12 -right-12 h-auto w-60 opacity-40 md:w-90"
			src={puffy}
			alt=""
			width="451"
			height="196"
			loading="lazy"
		/>
		<img
			class="absolute bottom-12 -left-32 h-auto w-100 opacity-70 md:w-150"
			src={long}
			alt=""
			width="735"
			height="272"
			loading="lazy"
		/>
	</div>
	<div class="wrap py-16 md:py-20 lg:py-30">
		<h2 class="text-center title text-white" id="organizers-title">
			Organizers
		</h2>
		<div
			class="mx-auto mt-12 grid max-w-275 grid-cols-[minmax(0,1fr)] gap-14 px-3 md:mt-16 md:grid-cols-2 md:gap-10 md:px-4 lg:gap-16"
		>
			{
				organizers.map((organizer) => (
					<article class="organizer-stack relative isolate flex text-navy">
						<div class="organizer-paper relative z-1 w-full rounded-md bg-cream p-6 lg:p-8">
							<h3 class="organizer-name display text-lg/8 lg:text-[22px]/[1.7]">
								{organizer.name}
							</h3>
							<p class="organizer-description max-w-[40ch] text-[17px]/[1.6] text-slate">
								{organizer.description}
							</p>
							<div class="organizer-postage relative w-20 self-start justify-self-end lg:w-24">
								<div class="organizer-postmark absolute top-16 -left-6 z-1 flex size-14 -rotate-12 flex-col items-center justify-center rounded-full border-2 border-azure bg-cream text-center text-[9px]/3 font-semibold tracking-[0.06em] text-azure uppercase lg:top-20 lg:-left-8 lg:size-16 lg:text-[10px]">
									<span>Est.</span>
									<span class="text-sm/5 lg:text-base/6">
										{organizer.establishedYear}
									</span>
								</div>
								<div class="rotate-6" aria-hidden="true">
									<div class="organizer-stamp flex aspect-[4/5] items-center justify-center p-5">
										<span
											class="organizer-mark block aspect-square w-full"
											style={{ "--organizer-mark": `url("${organizer.mark}")` }}
										/>
									</div>
								</div>
							</div>
							<div class="organizer-link border-t border-dashed border-line pt-3">
								<a
									class="inline-flex min-h-11 items-center gap-2 text-base font-semibold text-blue underline-offset-4 hover:underline"
									href={organizer.href}
								>
									{organizer.domain} <span aria-hidden="true">▸</span>
								</a>
							</div>
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>

<style>
	.organizer-paper {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 80px;
		grid-template-areas: "name postage" "description description" "link link";
		grid-template-rows: auto 1fr auto;
		gap: 16px;
	}

	.organizer-name {
		grid-area: name;
	}

	.organizer-description {
		grid-area: description;
	}

	.organizer-postage {
		grid-area: postage;
		min-height: 120px;
	}

	.organizer-link {
		grid-area: link;
		margin-top: 4px;
	}

	@media (width >= 1024px) {
		.organizer-postage {
			min-height: 152px;
		}
	}

	@media (width >= 1100px) {
		.organizer-paper {
			grid-template-columns: minmax(0, 1fr) 112px;
			grid-template-areas: "name postage" "description postage" "link link";
			column-gap: 24px;
		}
	}

	/* Perforation treatment from postcard/stamps/Stamp.astro. */
	.organizer-stamp {
		position: relative;
		color: var(--color-cream);
		background: var(--color-blue);
		mask:
			radial-gradient(circle at 50% 0, transparent 3px, #000 3.5px) 0 0 / 12px
				100%,
			radial-gradient(circle at 50% 100%, transparent 3px, #000 3.5px) 0 0 /
				12px 100%,
			radial-gradient(circle at 0 50%, transparent 3px, #000 3.5px) 0 0 / 100%
				12px,
			radial-gradient(circle at 100% 50%, transparent 3px, #000 3.5px) 0 0 /
				100% 12px;
		mask-composite: intersect;
	}

	.organizer-mark {
		background: currentColor;
		mask: var(--organizer-mark) center / contain no-repeat;
	}

	.organizer-stamp::before {
		content: "";
		position: absolute;
		inset: 8px;
		border: 1px solid color-mix(in oklch, currentColor 55%, transparent);
	}

	.organizer-stack {
		box-shadow: 0 36px 72px -28px rgb(0 25 65 / 0.6);
	}

	.organizer-stack::before,
	.organizer-stack::after {
		content: "";
		position: absolute;
		inset: 0;
		z-index: -1;
		border-radius: 6px;
		background: var(--color-cream);
		box-shadow: 0 18px 36px -22px rgb(0 25 65 / 0.45);
	}

	.organizer-stack::before {
		transform: translate(-8px, 8px) rotate(-2.6deg);
	}

	.organizer-stack::after {
		z-index: -2;
		transform: translate(6px, 14px) rotate(2deg);
	}

	.organizer-stack:nth-child(2)::before {
		transform: translate(8px, 8px) rotate(2.6deg);
	}

	.organizer-stack:nth-child(2)::after {
		transform: translate(-6px, 14px) rotate(-2deg);
	}
</style>
