<science-back-to-top>
	<a href="#page-top" tabindex="-1">
		<span aria-hidden="true">↑</span> Back to top
	</a>
</science-back-to-top>

<script>
	class ScienceBackToTop extends HTMLElement {
		connectedCallback() {
			const link = this.querySelector("a")!;
			let previousY = window.scrollY;
			let travel = 0;
			let revealed = false;
			const controller = new AbortController();
			this.cleanup = () => controller.abort();

			const update = () => {
				// Clamp Safari's overscroll so bouncing at either edge isn't intent.
				const maxY = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
				const y = Math.max(0, Math.min(window.scrollY, maxY));
				const delta = previousY - y;
				previousY = y;
				const eligible = y > window.innerHeight * 2;

				if (!eligible) {
					travel = 0;
					revealed = false;
				} else if (delta !== 0) {
					travel = Math.sign(delta) === Math.sign(travel) ? travel + delta : delta;
					if (travel >= 80) revealed = true;
					if (travel <= -24) revealed = false;
				}

				this.toggleAttribute("data-revealed", revealed);
				// Opacity, rather than visibility, lets keyboard focus reveal the link.
				link.tabIndex = eligible ? 0 : -1;
			};

			window.addEventListener("scroll", update, { passive: true, signal: controller.signal });
			window.addEventListener("resize", update, { signal: controller.signal });
			link.addEventListener("click", () => {
				// Keep native hash navigation, but move focus as well as the viewport.
				document.getElementById("page-top")?.focus({ preventScroll: true });
			}, { signal: controller.signal });
			update();
		}

		cleanup?: () => void;

		disconnectedCallback() {
			this.cleanup?.();
		}
	}

	if (!customElements.get("science-back-to-top")) {
		customElements.define("science-back-to-top", ScienceBackToTop);
	}
</script>

<style>
	science-back-to-top a {
		position: fixed;
		z-index: 20;
		right: max(20px, env(safe-area-inset-right));
		bottom: calc(20px + env(safe-area-inset-bottom));
		display: inline-flex;
		align-items: center;
		gap: 8px;
		min-height: 44px;
		padding: 10px 18px;
		border: 1px solid var(--color-navy);
		border-radius: 999px;
		background: var(--color-cream);
		color: var(--color-navy);
		font-size: 14px;
		font-weight: 500;
		line-height: 1.4;
		opacity: 0;
		transform: translateY(8px);
		pointer-events: none;
		transition: opacity 160ms ease-out, transform 160ms ease-out;
	}

	science-back-to-top[data-revealed] a,
	science-back-to-top a:focus {
		opacity: 1;
		transform: translateY(0);
		pointer-events: auto;
	}

	science-back-to-top a:hover {
		background: var(--color-navy);
		color: var(--color-cream);
	}

	@media (prefers-reduced-motion: reduce) {
		science-back-to-top a {
			transform: none;
			transition: none;
		}
	}
</style>
