---
import iosp from "../../../images/illustrations/iosp-stamp.png";
import atscience from "../../../images/illustrations/atscience-stamp.png";
import postmark from "../../../images/postmark.svg?url";
import DrinkingGoose from "../../../images/guus/drinking.svg";
---

<section
	data-intro
	class="wrap relative grid grid-cols-[minmax(0,1fr)] gap-9 pt-16 max-lg:pb-12 max-md:overflow-x-clip md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] md:pt-20 lg:min-h-190 lg:pt-30"
	aria-labelledby="intro-title"
>
	<div class="contents md:block">
		<h2 class="title" id="intro-title">
			Two days on<br /> open <span class="text-gradient">science</span>
		</h2>
		<div
			class="relative order-3 mx-auto h-70 w-85 md:order-0 md:mx-0 md:mt-17.5 md:-mb-17.5 md:h-92.5 md:w-117.5 md:max-w-full md:origin-top-left md:scale-80 lg:mb-0 lg:scale-100"
		>
			<img
				data-photo="left"
				class="absolute top-6.25 left-0 w-[53%] md:w-61.25"
				src={atscience.src}
				alt="The audience at the Vancouver ATScience event for AtmosphereConf 2026"
				width={atscience.width}
				height={atscience.height}
				loading="lazy"
			/>
			<img
				data-photo="right"
				class="absolute top-0 left-[44%] w-[53%] md:left-55 md:w-61.25"
				src={iosp.src}
				alt="A participant at the IOSP 2026 conference in Leiden"
				width={iosp.width}
				height={iosp.height}
				loading="lazy"
			/>
			<img
				data-postmark
				class="absolute bottom-0 left-[38%] w-[56%] md:left-47.5 md:w-62.5"
				src={postmark}
				alt=""
				width="250"
				height="125"
				loading="lazy"
			/>
		</div>
	</div>
	<div class="text-slate md:pt-10">
		<p>
			<span class="font-bold text-pretty">ATScience teams up with the Institute of Open Science Practices (IOSP)</span> for two days on the tools, communities, infrastructure and institutions shaping the future of open science, and on the gaps we still need to fill together.
		</p>
		<p class="mt-8">
			<span class="font-bold text-pretty">ATProto</span> gives open science a shared network: decentralized, interoperable and resilient, where researchers own their identities, connections and data.
		</p>
		<p class="mt-8">
			<span class="font-bold text-pretty">Newcomers are welcome.</span> You don't need to be building on — or even have heard of — ATProto. Join us and meet the community.
		</p>
	</div>
	<DrinkingGoose
		data-scene="ticket-drinking"
		data-intro-goose
		class="pointer-events-none absolute right-5 -bottom-2 z-10 h-auto w-33.75 origin-bottom -scale-x-150 scale-y-150 max-lg:hidden md:right-6 md:w-43.25"
		aria-hidden="true"
	/>
</section>

<style>
	[data-intro] :global([data-intro-goose]) {
		translate: -10px 43px;
	}

	[data-intro] :global([data-intro-goose] > path:first-child) {
		display: none;
	}

	:global(html[data-motion])
		[data-intro]:not([data-reveal="in"])
		img[data-photo],
	:global(html[data-motion])
		[data-intro]:not([data-reveal="in"])
		img[data-postmark] {
		opacity: 0;
	}

	:global(html[data-motion])
		[data-intro][data-reveal="in"]
		img[data-photo="left"] {
		animation:
			intro-place-left 700ms var(--ease-soft) backwards,
			intro-bump 220ms ease-out 1040ms backwards;
	}

	:global(html[data-motion])
		[data-intro][data-reveal="in"]
		img[data-photo="right"] {
		animation:
			intro-place-right 700ms var(--ease-soft) 150ms backwards,
			intro-bump 220ms ease-out 1040ms backwards;
	}

	:global(html[data-motion]) [data-intro][data-reveal="in"] img[data-postmark] {
		animation: intro-stamp 400ms var(--ease-hit) 800ms backwards;
	}

	@keyframes intro-place-left {
		from {
			opacity: 0;
			transform: translate(-48px, 56px) rotate(-10deg);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	@keyframes intro-place-right {
		from {
			opacity: 0;
			transform: translate(48px, 56px) rotate(10deg);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	@keyframes intro-stamp {
		0% {
			opacity: 0;
			transform: scale(1.6) rotate(-8deg);
		}
		60% {
			opacity: 1;
			transform: scale(0.97) rotate(1deg);
			animation-timing-function: cubic-bezier(0.34, 1.56, 0.64, 1);
		}
		100% {
			opacity: 1;
			transform: scale(1);
		}
	}

	@keyframes intro-bump {
		40% {
			transform: translateY(3px);
		}
	}
</style>

<script>
	import { onEnterViewport } from "../lib/motion";

	const intro = document.querySelector<HTMLElement>("[data-intro]");
	if (intro) {
		onEnterViewport(intro, () => {
			intro.dataset.reveal = "in";
		});
	}
</script>
