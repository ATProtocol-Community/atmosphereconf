---
import puffy from "../../../images/clouds/puffy.svg?url";
import long from "../../../images/clouds/long.svg?url";

const organizers = [
	{
		name: "ATScience",
		establishedYear: "2025",
		href: "https://atproto.science/",
		domain: "atproto.science",
		description:
			"ATScience builds communities and tools for publishing, curating, sharing and discussing research online with AT Protocol and other decentralized protocols.",
	},
	{
		name: "IOSP",
		establishedYear: "2024",
		href: "https://www.iosp.science/",
		domain: "iosp.science",
		description:
			"IOSP brings researchers and the people building open science infrastructure together to work on shared problems.",
	},
];
---

<section
	id="organizers"
	class="relative isolate overflow-hidden sky-gradient"
	aria-labelledby="organizers-title"
>
	<div class="pointer-events-none absolute inset-0 -z-1" aria-hidden="true">
		<img
			class="absolute top-12 -right-12 h-auto w-60 opacity-40 md:w-90"
			src={puffy}
			alt=""
			width="451"
			height="196"
			loading="lazy"
		/>
		<img
			class="absolute bottom-12 -left-32 h-auto w-100 opacity-70 md:w-150"
			src={long}
			alt=""
			width="735"
			height="272"
			loading="lazy"
		/>
	</div>
	<div class="wrap py-16 md:py-20 lg:py-30">
		<h2 class="text-center title text-white" id="organizers-title">
			Organizers
		</h2>
		<div
			class="mx-auto mt-12 grid max-w-275 grid-cols-[minmax(0,1fr)] gap-14 px-3 md:mt-16 md:grid-cols-2 md:gap-10 md:px-4 lg:gap-16"
		>
			{
				organizers.map((organizer) => (
					<article class="organizer-stack relative isolate flex text-navy">
						<div class="relative z-1 flex w-full flex-col rounded-md bg-cream p-6 md:p-7 lg:p-10">
							<div class="relative min-h-44 border-b border-dashed border-line lg:min-h-48">
								<h3 class="absolute top-6 left-0 display text-base/7 md:text-lg/8 lg:text-2xl/9">
									{organizer.name}
								</h3>
								{/* Founding years are layout placeholders, not verified dates. */}
								<div class="absolute right-14 bottom-6 z-1 flex size-20 -rotate-12 flex-col items-center justify-center rounded-full border-2 border-azure bg-cream/80 text-center font-semibold text-azure lg:right-18">
									<span class="text-[9px]/3 tracking-[0.06em] uppercase">
										Est.
									</span>
									<span class="text-base/6">
										c. {organizer.establishedYear}
									</span>
									<span class="text-[8px]/3 uppercase">Placeholder</span>
								</div>
								<div
									class="absolute top-0 right-0 w-20 rotate-6 md:w-24 lg:w-28"
									aria-hidden="true"
								>
									<div class="organizer-stamp flex aspect-[4/5] flex-col items-center justify-center gap-3 bg-white p-3 text-blue">
										{/* Replace the name with the supplied organization logo. */}
										<span class="text-[10px] font-semibold md:text-xs lg:text-sm">
											{organizer.name}
										</span>
										<span class="text-center text-[8px]/3 tracking-[0.06em] uppercase">
											Logo placeholder
										</span>
									</div>
								</div>
							</div>
							<p class="mt-6 mb-8 max-w-[40ch] text-base/7 text-slate lg:mb-10 lg:text-lg/7">
								{organizer.description}
							</p>
							<div class="mt-auto border-t border-line pt-5">
								<a
									class="inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-blue underline-offset-4 hover:underline md:text-base"
									href={organizer.href}
								>
									{organizer.domain} <span aria-hidden="true">▸</span>
								</a>
							</div>
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>

<style>
	/* Perforation treatment from postcard/stamps/Stamp.astro. */
	.organizer-stamp {
		position: relative;
		mask:
			radial-gradient(circle at 50% 0, transparent 3px, #000 3.5px) 0 0 / 12px
				100%,
			radial-gradient(circle at 50% 100%, transparent 3px, #000 3.5px) 0 0 /
				12px 100%,
			radial-gradient(circle at 0 50%, transparent 3px, #000 3.5px) 0 0 / 100%
				12px,
			radial-gradient(circle at 100% 50%, transparent 3px, #000 3.5px) 0 0 /
				100% 12px;
		mask-composite: intersect;
	}

	.organizer-stamp::before {
		content: "";
		position: absolute;
		inset: 8px;
		border: 1px solid var(--color-line);
	}

	.organizer-stack {
		box-shadow: 0 36px 72px -28px rgb(0 25 65 / 0.6);
	}

	.organizer-stack::before,
	.organizer-stack::after {
		content: "";
		position: absolute;
		inset: 0;
		z-index: -1;
		border-radius: 6px;
		background: var(--color-cream);
		box-shadow: 0 18px 36px -22px rgb(0 25 65 / 0.45);
	}

	.organizer-stack::before {
		transform: translate(-8px, 8px) rotate(-2.6deg);
	}

	.organizer-stack::after {
		z-index: -2;
		transform: translate(6px, 14px) rotate(2deg);
	}

	.organizer-stack:nth-child(2)::before {
		transform: translate(8px, 8px) rotate(2.6deg);
	}

	.organizer-stack:nth-child(2)::after {
		transform: translate(-6px, 14px) rotate(-2deg);
	}
</style>
