---
import bazaarPlaceholder from "../../../images/illustrations/demo-bazaar-temp.png?url";
import "../home/goose-animations.css";

// Each row: heading on the left, content on the right (stacked on phones).
const heading = "display text-2xl/[1.5] md:text-[32px]/[1.5]";
const card = "rounded-xl bg-cream p-5 md:p-7 lg:p-8";
const cardTitle = "font-display text-lg/[1.5] uppercase";
---

<section class="bg-white" aria-labelledby="formats-title">
	<div
		class="wrap flex max-w-[1120px] flex-col gap-8 pt-12 pb-0 md:gap-10 md:pt-15 md:pb-4 lg:pt-20 lg:pb-6"
	>
		<h2 class={heading} id="formats-title">Four ways to contribute</h2>
		<ul class="grid grid-cols-1 gap-3 md:grid-cols-3 md:gap-5">
			<li class={card}>
				<h3 class="eyebrow">Regular</h3>
				<p class:list={[cardTitle, "mt-4"]}>
					25 minutes <span class="text-azure">Talk</span>
				</p>
				<p class="mt-3 text-sm/6">
					Includes 5 minutes for Q&A. A standard session for deeper stories,
					demos, or discussions.
				</p>
			</li>
			<li class={card}>
				<h3 class="eyebrow">Short</h3>
				<p class:list={[cardTitle, "mt-4"]}>
					10 minutes <span class="text-azure">Lightning talk</span>
				</p>
				<p class="mt-3 text-sm/6">
					Includes 5 minutes for Q&A. Great for new ideas, quick demos, or
					concise updates.
				</p>
			</li>
			<li class={card}>
				<h3 class="eyebrow">Hands-on</h3>
				<p class:list={[cardTitle, "mt-4"]}>
					90 minutes <span class="text-azure">Workshop</span>
				</p>
				<p class="mt-3 text-sm/6">
					A longer session for hands-on building, planning, or sharing deeper
					knowledge.
				</p>
			</li>
		</ul>
		<div
			class="-mt-5 grid items-center gap-6 rounded-xl bg-navy p-6 text-white md:p-8 min-[800px]:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] min-[800px]:gap-x-12 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)] lg:p-10"
		>
			<div>
				<h3 class="text-[13px]/5 font-medium tracking-[0.03em] uppercase">
					Show and tell
				</h3>
				<p class="mt-4 font-display text-xl/[1.5] uppercase">
					2 hours <span class="text-yellow">Demo Bazaar</span>
				</p>
				<p class="mt-3 max-w-[65ch] text-base/6 lg:max-w-none">
					The hall turns into a market of standing tables. Bring the tool you
					built, a dataset, a poster, or an experiment, and show your work to
					the people walking past your table.
				</p>
			</div>
			<!-- This can be removed if launching before image is ready -->
			<div
				class="relative aspect-[5/2] w-full justify-self-center min-[800px]:aspect-auto min-[800px]:h-full min-[800px]:justify-self-end"
			>
				<img
					src={bazaarPlaceholder}
					alt=""
					class="absolute inset-0 h-full w-full object-contain min-[800px]:object-right"
					width="1440"
					height="498"
					loading="lazy"
				/>
			</div>
		</div>
		<p class="text-base/6 text-slate md:-mt-2">
			Submit through the AtmosphereConf form and choose <span
				class="font-bold text-pretty">ATScience</span
			> as your track. <span class="md:whitespace-nowrap"
				>We follow the main conference's <a
					href="/speak#selection-title"
					class="text-navy underline underline-offset-4 hover:text-azure"
					>deadlines and selection process</a
				>.</span
			>
		</p>
	</div>
</section>
