	[data-scene="ticket-walking"] [data-part="leg-front"] {
		animation: walk-leg-front 1s linear infinite var(--play);
	}
	[data-scene="ticket-walking"] [data-part="foot-front"] {
		animation: walk-foot-front 1s linear infinite var(--play);
	}

	[data-scene="ticket-walking"] [data-part="leg-back"] {
		animation: walk-leg-back 1s linear infinite var(--play);
