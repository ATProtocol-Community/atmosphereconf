---
import type { SvgComponent } from "astro/types";

interface Props {
	name: string;
	/** Whole euros, excluding VAT. */
	price: string;
	goose: SvgComponent;
	kind: "running" | "walking" | "drinking";
}

const { name, price, goose: Goose, kind } = Astro.props;
---

<article
	data-card
	class="flex min-h-90 card-lift flex-col items-center rounded-xl border border-line bg-white px-3 py-5 text-center text-navy md:min-h-105 md:py-6 lg:min-h-117.75 lg:px-4"
>
	<Goose
		data-scene={`ticket-${kind}`}
		data-scene-hover
		class="mb-4 h-auto w-33.75 md:w-43.25"
		aria-hidden="true"
	/>
	<h3
		class="text-[11px]/4 font-medium tracking-[0.03em] uppercase md:text-sm/4"
	>
		{name}
	</h3>
	<p class="mt-2 font-display text-[32px]/12 tracking-normal">€{price}</p>
	<p class="mt-2 text-sm text-slate">Exc. 21% VAT</p>
	<button
		class="btn mt-8 uppercase md:mt-auto"
		disabled
		aria-label={`Purchase ${name} ticket, coming soon`}
	>
		Purchase <span aria-hidden="true">▸</span>
	</button>
</article>

<style is:global>
	[data-scene="ticket-running"] [data-part="body"] {
		animation: run-bob 0.65s linear infinite var(--play);
	}
	[data-scene="ticket-running"] [data-part="leg-front"] {
		animation: run-leg-front 0.65s linear infinite var(--play);
	}
	[data-scene="ticket-running"] [data-part="foot-front"] {
		animation: run-foot-front 0.65s linear infinite var(--play);
	}

	[data-scene="ticket-running"] [data-part="leg-back"] {
		animation: run-leg-back 0.65s linear infinite var(--play);
	}
	[data-scene="ticket-running"] [data-part="foot-back"] {
		animation: run-foot-back 0.65s linear infinite var(--play);
	}

	[data-scene="ticket-running"] [data-part="scarf-tail"] {
		animation: run-scarf 0.65s ease-in-out infinite var(--play);
	}
	[data-scene="ticket-running"] [data-part="speed-lines"] {
		animation: run-lines 0.65s ease-in-out infinite var(--play);
	}

	[data-scene="ticket-walking"] [data-part="body"] {
		animation: walk-bob 1s linear infinite var(--play);
	}
	[data-scene="ticket-walking"] [data-part="leg-front"] {
		animation: walk-leg-front 1s linear infinite var(--play);
	}
	[data-scene="ticket-walking"] [data-part="foot-front"] {
		animation: walk-foot-front 1s linear infinite var(--play);
	}

	[data-scene="ticket-walking"] [data-part="leg-back"] {
		animation: walk-leg-back 1s linear infinite var(--play);
	}
	[data-scene="ticket-walking"] [data-part="foot-back"] {
		animation: walk-foot-back 1s linear infinite var(--play);
	}

	[data-scene="ticket-drinking"] [data-part="upper"] {
		animation: sip 2.4s ease-in-out infinite var(--play);
	}
	[data-scene="ticket-drinking"] [data-part="cup"] {
		animation: sip-cup 2.4s ease-in-out infinite var(--play);
