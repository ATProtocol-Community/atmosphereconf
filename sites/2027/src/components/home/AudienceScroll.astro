---
import buildingBlocks from "../../../images/icons/outline/building-blocks.svg?url";
import magicWand from "../../../images/icons/outline/magic-wand.svg?url";
import microphone from "../../../images/icons/outline/microphone.svg?url";
import scales from "../../../images/icons/outline/scales.svg?url";
import Canal from "../../../images/illustrations/canal-bike.svg";

const icons = {
	"building-blocks": buildingBlocks,
	"magic-wand": magicWand,
	microphone,
	scales,
};
const audiences: {
	name: string;
	icon: keyof typeof icons;
	description: string;
}[] = [
	{
		name: "Builders",
		icon: "building-blocks",
		description: "Communities that care: developers, scientists & makers",
	},
	{
		name: "Creators",
		icon: "magic-wand",
		description:
			"Connoisseurs of internet culture: artists, musicians, creators",
	},
	{
		name: "Storytellers",
		icon: "microphone",
		description: "News, media, and journalists",
	},
	{
		name: "Stewards",
		icon: "scales",
		description: "Policy makers and officials",
	},
];
---

<section
	id="audience"
	class="bg-blue text-white"
	aria-labelledby="audience-title"
>
	<div
		class="wrap grid gap-10 pt-16 pb-17.5 md:grid-cols-2 md:gap-12 md:pt-20 md:pb-25 lg:gap-19 lg:pt-30 lg:pb-46"
	>
		<h2 class="title" id="audience-title">
			Who attends &amp;<br />what to expect
		</h2>
		<dl class="grid gap-6 pb-6 md:gap-8 md:py-6 lg:gap-12">
			{
				audiences.map((audience) => (
					<div class="p-5 md:p-6" data-audience-category>
						<div class="relative pl-18 md:pl-22">
							<dt class="eyebrow text-xs/2">
								<img
									src={icons[audience.icon]}
									alt=""
									width="90"
									height="90"
									class={`audience-icon absolute top-0 left-0 -mt-4 ${audience.icon === "building-blocks" ? "size-14 md:size-16" : "size-12 md:size-14"}`}
								/>
								{audience.name}
							</dt>
							<dd class="mt-2 max-w-152.5 display text-xl leading-[1.6] md:leading-loose">
								{audience.description}
							</dd>
						</div>
					</div>
				))
			}
		</dl>
	</div>
	<scroll-canal class="block">
		<Canal
			data-scene="canal-scroll"
			class="h-auto w-full max-md:min-h-47.5"
			preserveAspectRatio="xMidYMid slice"
			role="img"
			aria-label="Dutch canal houses, tulips, and boats, with a goose riding a bicycle across a bridge"
		/>
	</scroll-canal>
</section>

<style is:global>
	@media (prefers-reduced-motion: no-preference) {
		html[data-motion] [data-audience-category]:not([data-reveal="in"]) {
			opacity: 0;
		}
		html[data-motion] [data-audience-category][data-reveal="in"] {
			animation: audience-enter 550ms var(--ease-soft) backwards;
			animation-delay: var(--category-delay, 0ms);
		}
	}
	@keyframes audience-enter {
		from {
			opacity: 0;
			transform: translateY(32px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	svg[data-scene="canal-scroll"] {
		overflow: hidden;
	}
	[data-scene="canal-scroll"] [data-part="goose-ride"] {
		animation: canal-scroll-ride 1s linear both paused;
		animation-delay: calc(var(--canal-progress, 0.5) * -1s);
	}
	/* Sampled from the original canal walk: the wheel baseline follows the bridge. */
	@keyframes canal-scroll-ride {
		0% {
			translate: -238.84px 27.55px;
			rotate: -16.04deg;
			opacity: 0;
		}
		12.5% {
			translate: -176.23px 12.33px;
			rotate: -11.27deg;
			opacity: 1;
		}
		25% {
			translate: -113.62px 2.02px;
			rotate: -8.31deg;
		}
		37.5% {
			translate: -51.02px -4.39px;
			rotate: -2.7deg;
		}
		50% {
			translate: 1.16px -5.24px;
			rotate: 0.97deg;
		}
		62.5% {
			translate: 63.77px -1.39px;
			rotate: 5.22deg;
		}
		75% {
			translate: 126.38px 7.58px;
			rotate: 9.93deg;
		}
		87.5% {
			translate: 168.11px 16.13px;
			rotate: 13.17deg;
			opacity: 1;
		}
		100% {
			translate: 230.72px 34.26px;
			rotate: 20.62deg;
			opacity: 0;
		}
	}
	[data-scene="canal-scroll"] [data-part="boat-a"] {
		animation: canal-scroll-drift-a 83s linear -23.4s infinite var(--play);
	}
	[data-scene="canal-scroll"] [data-part="boat-b"] {
		animation: canal-scroll-drift-b 87s linear -56s infinite var(--play);
	}
	[data-scene="canal-scroll"] [data-part="boat-a-bob"] {
		animation: canal-scroll-bob-boat 4.2s ease-in-out infinite var(--play);
	}
	[data-scene="canal-scroll"] [data-part="boat-b-bob"] {
		animation: canal-scroll-bob-boat 5.1s ease-in-out infinite var(--play);
	}
	[data-scene="canal-scroll"] [data-part="ripple"] {
		animation: canal-scroll-ripple 5s ease-in-out calc(var(--i) * -1.1s)
			infinite var(--play);
	}
	@keyframes canal-scroll-drift-a {
		from {
			translate: -470px 0;
		}
		to {
			translate: 1195px 0;
		}
	}

	@keyframes canal-scroll-drift-b {
		from {
			translate: -1125px 0;
		}
		to {
			translate: 620px 0;
		}
	}

	@keyframes canal-scroll-bob-boat {
		0%,
		100% {
			translate: 0 0;
			rotate: -1.2deg;
		}
		50% {
			translate: 0 -3px;
			rotate: 1.2deg;
		}
	}

	@keyframes canal-scroll-ripple {
		0%,
		100% {
			translate: -5px 0;
			scale: 0.96 1;
		}
		50% {
			translate: 5px 0;
			scale: 1.04 1;
		}
	}

	/* Reuse the Attend rider rig, with six pedal turns per crossing. */
	@keyframes canal-bike-spin {
		100% {
			transform: rotate(360deg);
		}
	}
	@keyframes canal-bike-crank {
		100% {
			transform: rotate(360deg);
		}
	}
	@keyframes canal-bike-crank-counter {
		100% {
			transform: rotate(-360deg);
		}
	}
	@keyframes canal-bike-leg-near {
		0% {
			transform: skewX(0deg) scaleY(1);
		}
		4.167% {
			transform: skewX(1.84deg) scaleY(1.0276);
		}
		8.333% {
			transform: skewX(3.11deg) scaleY(1.0628);
		}
		12.5% {
			transform: skewX(3.76deg) scaleY(1.1032);
		}
		16.667% {
			transform: skewX(3.81deg) scaleY(1.1461);
		}
		20.833% {
			transform: skewX(3.32deg) scaleY(1.1885);
		}
		25% {
			transform: skewX(2.37deg) scaleY(1.2275);
		}
		29.167% {
			transform: skewX(1.06deg) scaleY(1.2605);
		}
		33.333% {
			transform: skewX(-0.53deg) scaleY(1.2852);
		}
		37.5% {
			transform: skewX(-2.3deg) scaleY(1.3);
		}
		41.667% {
			transform: skewX(-4.18deg) scaleY(1.3039);
		}
		45.833% {
			transform: skewX(-6.06deg) scaleY(1.2965);
		}
		50% {
			transform: skewX(-7.87deg) scaleY(1.2784);
		}
		54.167% {
			transform: skewX(-9.51deg) scaleY(1.2508);
		}
		58.333% {
			transform: skewX(-10.91deg) scaleY(1.2156);
		}
		62.5% {
			transform: skewX(-11.97deg) scaleY(1.1752);
		}
		66.667% {
			transform: skewX(-12.59deg) scaleY(1.1323);
		}
		70.833% {
			transform: skewX(-12.7deg) scaleY(1.0899);
		}
		75% {
			transform: skewX(-12.21deg) scaleY(1.0509);
		}
		79.167% {
			transform: skewX(-11.11deg) scaleY(1.0179);
		}
		83.333% {
			transform: skewX(-9.42deg) scaleY(0.9931);
		}
		87.5% {
			transform: skewX(-7.24deg) scaleY(0.9783);
		}
		91.667% {
			transform: skewX(-4.78deg) scaleY(0.9745);
		}
		95.833% {
			transform: skewX(-2.28deg) scaleY(0.9819);
		}
		100% {
			transform: skewX(0deg) scaleY(1);
		}
	}
	@keyframes canal-bike-leg-far {
		0% {
			transform: skewX(0deg) scaleY(1);
		}
		4.167% {
			transform: skewX(-2.23deg) scaleY(0.9951);
		}
		8.333% {
			transform: skewX(-4.37deg) scaleY(0.9804);
		}
		12.5% {
			transform: skewX(-6.32deg) scaleY(0.9568);
		}
		16.667% {
			transform: skewX(-7.98deg) scaleY(0.9259);
		}
		20.833% {
			transform: skewX(-9.25deg) scaleY(0.8899);
		}
		25% {
			transform: skewX(-10.01deg) scaleY(0.8513);
		}
		29.167% {
			transform: skewX(-10.14deg) scaleY(0.8126);
		}
		33.333% {
			transform: skewX(-9.55deg) scaleY(0.7764);
		}
		37.5% {
			transform: skewX(-8.17deg) scaleY(0.7454);
		}
		41.667% {
			transform: skewX(-6.03deg) scaleY(0.7214);
		}
		45.833% {
			transform: skewX(-3.26deg) scaleY(0.7063);
		}
		50% {
			transform: skewX(-0.13deg) scaleY(0.701);
		}
		54.167% {
			transform: skewX(3.02deg) scaleY(0.7059);
		}
		58.333% {
			transform: skewX(5.81deg) scaleY(0.7207);
		}
		62.5% {
			transform: skewX(7.98deg) scaleY(0.7443);
		}
		66.667% {
			transform: skewX(9.4deg) scaleY(0.7751);
		}
		70.833% {
			transform: skewX(10.03deg) scaleY(0.8111);
		}
		75% {
			transform: skewX(9.93deg) scaleY(0.8497);
		}
		79.167% {
			transform: skewX(9.2deg) scaleY(0.8885);
		}
		83.333% {
			transform: skewX(7.95deg) scaleY(0.9246);
		}
		87.5% {
			transform: skewX(6.3deg) scaleY(0.9557);
		}
		91.667% {
			transform: skewX(4.36deg) scaleY(0.9796);
		}
		95.833% {
			transform: skewX(2.23deg) scaleY(0.9947);
		}
		100% {
			transform: skewX(0deg) scaleY(1);
		}
	}
	[data-scene="canal-scroll"] [data-part="crank-near"],
	[data-scene="canal-scroll"] [data-part="crank-far"] {
		animation: canal-bike-crank 1s linear infinite paused;
		animation-delay: calc(var(--canal-progress, 0.5) * -6s);
	}
	[data-scene="canal-scroll"] [data-part="pedal-near"],
	[data-scene="canal-scroll"] [data-part="pedal-far"] {
		animation: canal-bike-crank-counter 1s linear infinite paused;
		animation-delay: calc(var(--canal-progress, 0.5) * -6s);
	}
	[data-scene="canal-scroll"] [data-part="leg-near"] {
		animation: canal-bike-leg-near 1s linear infinite paused;
		animation-delay: calc(var(--canal-progress, 0.5) * -6s);
	}
	[data-scene="canal-scroll"] [data-part="leg-far"] {
		animation: canal-bike-leg-far 1s linear infinite paused;
		animation-delay: calc(var(--canal-progress, 0.5) * -6s);
	}
	[data-scene="canal-scroll"] [data-part="spokes-front"],
	[data-scene="canal-scroll"] [data-part="spokes-rear"] {
		animation: canal-bike-spin 1s linear infinite paused;
		animation-delay: calc(var(--canal-progress, 0.5) * -9s);
	}

	@media (prefers-reduced-motion: reduce) {
		[data-scene="canal-scroll"] [data-part] {
			animation: none;
		}
	}
</style>

<script>
	import { onEnterViewport } from "../lib/motion";

	const categories = [
		...document.querySelectorAll<HTMLElement>("[data-audience-category]"),
	];
	for (const category of categories) {
		onEnterViewport(
			category,
			() => {
				if (category.dataset.reveal === "in") return;
				// Share one start per visual row; a single-column row has no delay.
				const row = categories.filter(
					(item) => item.offsetTop === category.offsetTop,
				);
				row.forEach((item, index) => {
					item.style.setProperty("--category-delay", `${index * 100}ms`);
					item.dataset.reveal = "in";
				});
			},
			{ rootMargin: "0px 0px -5% 0px", threshold: 0.15 },
		);
	}

	class ScrollCanal extends HTMLElement {
		private frame = 0;
		private reducedMotion = window.matchMedia(
			"(prefers-reduced-motion: reduce)",
		);
		private update = () => {
			this.frame = 0;
			const scene = this.querySelector<SVGSVGElement>(
				'svg[data-scene="canal-scroll"]',
			);
			if (!scene) return;
			const bounds = scene.getBoundingClientRect();
			const scrollDistance = 750;
			// Keep the existing entry point, but use a fixed scroll distance to cross.
			const startOffset = 0.2 * (window.innerHeight + bounds.height);
			const scrolled = window.innerHeight - bounds.top - startOffset;
			const progress = this.reducedMotion.matches
				? 0.5
				: Math.max(0, Math.min(1, scrolled / scrollDistance));
			scene.style.setProperty("--canal-progress", String(progress));
		};
		private requestUpdate = () => {
			if (!this.frame) this.frame = requestAnimationFrame(this.update);
		};
		connectedCallback() {
			window.addEventListener("scroll", this.requestUpdate, { passive: true });
			window.addEventListener("resize", this.requestUpdate);
			this.reducedMotion.addEventListener("change", this.requestUpdate);
			this.update();
		}
		disconnectedCallback() {
			window.removeEventListener("scroll", this.requestUpdate);
			window.removeEventListener("resize", this.requestUpdate);
			this.reducedMotion.removeEventListener("change", this.requestUpdate);
			cancelAnimationFrame(this.frame);
			this.frame = 0;
		}
	}
	if (!customElements.get("scroll-canal"))
		customElements.define("scroll-canal", ScrollCanal);
</script>
