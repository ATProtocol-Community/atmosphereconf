	[data-scene="canal-scroll"] [data-part="crank-near"],
	[data-scene="canal-scroll"] [data-part="crank-far"] {
		animation: canal-bike-crank 1s linear infinite paused;
		animation-delay: calc(var(--canal-distance, 0.5) * -6s);
	}
	[data-scene="canal-scroll"] [data-part="pedal-near"],
	[data-scene="canal-scroll"] [data-part="pedal-far"] {
		animation: canal-bike-crank-counter 1s linear infinite paused;
		animation-delay: calc(var(--canal-distance, 0.5) * -6s);
	}
	[data-scene="canal-scroll"] [data-part="leg-near"] {
		animation: canal-bike-leg-near 1s linear infinite paused;
		animation-delay: calc(var(--canal-distance, 0.5) * -6s);
	}
	[data-scene="canal-scroll"] [data-part="leg-far"] {
		animation: canal-bike-leg-far 1s linear infinite paused;
		animation-delay: calc(var(--canal-distance, 0.5) * -6s);
	}
	[data-scene="canal-scroll"] [data-part="spokes-front"],
	[data-scene="canal-scroll"] [data-part="spokes-rear"] {
		animation: canal-bike-spin 1s linear infinite paused;
		animation-delay: calc(var(--canal-distance, 0.5) * -9s);
	}

	@media (prefers-reduced-motion: reduce) {
		[data-scene="canal-scroll"] [data-part] {
			animation: none;
		}
		[data-scene="canal-scroll"] [data-part="goose-facing"] {
			transition: none;
		}
	}
</style>

<script>
	import { onEnterViewport } from "../lib/motion";

	const categories = [
		...document.querySelectorAll<HTMLElement>("[data-audience-category]"),
	];
	for (const category of categories) {
		onEnterViewport(
			category,
			() => {
				if (category.dataset.reveal === "in") return;
				// Share one start per visual row; a single-column row has no delay.
				const row = categories.filter(
					(item) => item.offsetTop === category.offsetTop,
				);
				row.forEach((item, index) => {
					item.style.setProperty("--category-delay", `${index * 100}ms`);
					item.dataset.reveal = "in";
				});
			},
			{ rootMargin: "0px 0px -5% 0px", threshold: 0.15 },
		);
	}

	class ScrollCanal extends HTMLElement {
		private frame = 0;
		private lastTime = 0;
		private smoothed: number | null = null;
		private traveled = 0;
		private smoothingRate = 7;
		private lastScrollY = window.scrollY;
		private reducedMotion = window.matchMedia(
			"(prefers-reduced-motion: reduce)",
		);
		private update = (time: number) => {
			this.frame = 0;
			const scene = this.querySelector<SVGSVGElement>(
				'svg[data-scene="canal-scroll"]',
			);
			if (!scene) return;
			const bounds = scene.getBoundingClientRect();
			const scrollDistance = 750;
			// Keep the existing entry point, but use a fixed scroll distance to cross.
			const startOffset = 0.2 * (window.innerHeight + bounds.height);
			const scrolled = window.innerHeight - bounds.top - startOffset;
			const target = this.reducedMotion.matches
				? 0.5
				: Math.max(0, Math.min(1, scrolled / scrollDistance));
			const elapsed = this.lastTime
				? Math.min(time - this.lastTime, 100) / 1000
				: 0;
			this.lastTime = time;
			const progress =
				this.smoothed === null || this.reducedMotion.matches
					? target
					: this.smoothed +
						(target - this.smoothed) *
							(1 - Math.exp(-this.smoothingRate * elapsed));
			// Accumulate distance so the wheels and pedals keep turning forward on the return trip.
			this.traveled =
				(this.traveled + Math.abs(progress - (this.smoothed ?? 0))) % 1;
			if (Math.abs(target - progress) < 0.0005) {
				this.smoothed = target;
				this.lastTime = 0;
			} else {
				this.smoothed = progress;
				this.frame = requestAnimationFrame(this.update);
			}
			scene.style.setProperty("--canal-progress", String(this.smoothed));
			scene.style.setProperty("--canal-distance", String(this.traveled));
		};
		private requestUpdate = () => {
			if (!this.frame) this.frame = requestAnimationFrame(this.update);
		};
		private onScroll = () => {
			const scrollY = window.scrollY;
			if (Math.abs(scrollY - this.lastScrollY) > 1) {
				this.dataset.direction = scrollY < this.lastScrollY ? "up" : "down";
				this.lastScrollY = scrollY;
			}
			this.requestUpdate();
		};
		connectedCallback() {
			this.lastScrollY = window.scrollY;
			window.addEventListener("scroll", this.onScroll, { passive: true });
			window.addEventListener("resize", this.requestUpdate);
			this.reducedMotion.addEventListener("change", this.requestUpdate);
			this.update(performance.now());
		}
		disconnectedCallback() {
			window.removeEventListener("scroll", this.onScroll);
			window.removeEventListener("resize", this.requestUpdate);
			this.reducedMotion.removeEventListener("change", this.requestUpdate);
			cancelAnimationFrame(this.frame);
			this.frame = 0;
			this.lastTime = 0;
		}
	}
	if (!customElements.get("scroll-canal"))
		customElements.define("scroll-canal", ScrollCanal);
</script>
