---
import Canal from "../../../images/illustrations/canal.svg";

const audiences = [
	{
		name: "Builders",
		description: "Communities that care: developers, scientists & makers",
	},
	{
		name: "Creators",
		description:
			"Connoisseurs of internet culture: artists, musicians, creators",
	},
	{ name: "Storytellers", description: "News, media, and journalists" },
	{ name: "Stewards", description: "Policy makers and officials" },
];
---

<section
	id="audience"
	class="bg-blue text-white"
	aria-labelledby="audience-title"
>
	<div
		class="wrap grid gap-10 pt-16 pb-17.5 md:grid-cols-2 md:gap-12 md:pt-20 md:pb-25 lg:gap-19 lg:pt-30 lg:pb-46"
	>
		<h2 class="title" id="audience-title">
			Who attends &amp;<br />what to expect
		</h2><dl class="space-y-10 pb-6 md:space-y-16 md:py-6">
			{
				audiences.map((audience) => (
					<div>
						<dt class="eyebrow">{audience.name}</dt>
						<dd class="mt-4 max-w-152.5 display text-xl leading-[1.6] md:leading-loose">
							{audience.description}
						</dd>
					</div>
				))
			}
		</dl>
	</div>
	<Canal
		data-scene="canal"
		class="h-auto w-full max-md:min-h-47.5"
		preserveAspectRatio="xMidYMid slice"
		role="img"
		aria-label="Amsterdam canal houses, tulips, and boats, with a goose walking across a bridge"
	/>
</section>

<style is:global>
	svg[data-scene="canal"] {
		overflow: hidden;
	}
	[data-scene="canal"] [data-part="goose-walk"] {
		animation: canal-walk 13.2s linear infinite var(--play);
	}
	[data-scene="canal"] [data-part="goose-body"] {
		animation:
			canal-bob 1.2s linear infinite var(--play),
			canal-lean 13.2s linear infinite var(--play);
	}
	[data-scene="canal"] [data-part="leg-near"] {
		animation: canal-leg-near 1.2s linear infinite var(--play);
	}
	[data-scene="canal"] [data-part="clog-near"] {
		animation: canal-clog-near 1.2s linear infinite var(--play);
	}
	[data-scene="canal"] [data-part="leg-far"] {
		animation: canal-leg-far 1.2s linear infinite var(--play);
	}
	[data-scene="canal"] [data-part="clog-far"] {
		animation: canal-clog-far 1.2s linear infinite var(--play);
	}
	[data-scene="canal"] [data-part="boat-a"] {
		animation: canal-drift-a 83s linear -23.4s infinite var(--play);
	}
	[data-scene="canal"] [data-part="boat-b"] {
		animation: canal-drift-b 87s linear -56s infinite var(--play);
	}
	[data-scene="canal"] [data-part="boat-a-bob"] {
		animation: canal-bob-boat 4.2s ease-in-out infinite var(--play);
	}
	[data-scene="canal"] [data-part="boat-b-bob"] {
		animation: canal-bob-boat 5.1s ease-in-out infinite var(--play);
	}
	[data-scene="canal"] [data-part="ripple"] {
		animation: canal-ripple 5s ease-in-out calc(var(--i) * -1.1s) infinite
			var(--play);
	}

