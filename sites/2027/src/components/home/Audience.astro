---
import Heart from "../../../images/logo/heart.svg";
import Canal from "../../../images/illustrations/canal-bike.svg";
import FoliageLeft from "../../../images/illustrations/canal-foliage-left.svg";
import FoliageRight from "../../../images/illustrations/canal-foliage-right.svg";

const audiences: { name: string; description: string }[] = [
	{
		name: "Builders",
		description: "Developers, scientists & crafters",
	},
	{
		name: "Creators",
		description: "Artists, musicians & trouble-makers",
	},
	{
		name: "Storytellers",
		description: "Journalists, newsrooms & podcasters",
	},
	{
		name: "Stewards",
		description: "Policy makers, officials & advocates",
	},
];
const formats: { name: string; description: string }[] = [
	{
		name: "Talks",
		description: "Long, short & impromptu",
	},
	{
		name: "Workshops",
		description: "Hands-on building time",
	},
	{
		name: "Interest groups",
		description: "For when you care together",
	},
	{
		name: "Hallway track",
		description: "Make your own goose puns",
	},
];
// Line breaks are set by hand so each item's box hugs its text and the hearts space evenly.
const extras: [string, string][] = [
	["Hybrid & remote", "experiences"],
	["Food, drinks", "& stroopwafels"],
	["A banger", "afterparty"],
];
---

<section
	id="audience"
	class="bg-blue text-white"
	aria-labelledby="audience-title"
>
	<div class="wrap pt-16 pb-17.5 md:pt-20 md:pb-25 lg:pt-30">
		<h2 class="sr-only" id="audience-title">Who attends &amp; what to expect</h2>
		<!-- Both columns share the outer rows via subgrid, so items line up across the & gutter. -->
		<div
			class="grid md:grid-cols-[auto_auto_auto] md:justify-center md:grid-rows-[auto_repeat(4,auto)] md:gap-x-8 lg:gap-x-12"
		>
			<div class="md:row-span-full md:grid md:grid-rows-subgrid md:text-right">
				<h3 class="title pb-6 md:pb-10">Who attends</h3>
				<dl class="md:row-span-4 md:grid md:grid-rows-subgrid">
					{
						audiences.map((audience) => (
							<div class="py-5 md:py-6" data-audience-category>
								<dt class="eyebrow">{audience.name}</dt>
								<dd class="mt-2 font-sans text-2xl/tight max-w-90 text-balance md:ml-auto">
									{audience.description}
								</dd>
							</div>
						))
					}
				</dl>
			</div>
			<span class="title max-md:mt-10 md:row-span-full" aria-hidden="true">&amp;</span>
			<div class="md:row-span-full md:grid md:grid-rows-subgrid">
				<h3 class="title pb-6 md:pb-10">What to expect</h3>
				<dl class="md:row-span-4 md:grid md:grid-rows-subgrid">
					{
						formats.map((format) => (
							<div class="py-5 md:py-6" data-audience-category>
								<dt class="eyebrow">{format.name}</dt>
								<dd class="mt-2 font-sans text-2xl/tight max-w-90 text-balance">
									{format.description}
								</dd>
							</div>
						))
					}
				</dl>
			</div>
		</div>
	</div>
	<scroll-canal class="relative flex flex-col lg:block">
		<!--
			Below lg the water band is too thin for text, so the water carries on under the art and the boats
			sail between the label and the items, with the foliage pinned to the bottom corners below them.
			From lg the label floats under the boats and the items float over them. The label's bottom sits at
			72.7% down the canal art; the boats' waterline is a little lower, between the label and the items.
		-->
		<div class="lg:contents" data-canal-copy>
			<div
				class="wrap absolute inset-x-0 z-10 flex -translate-y-full justify-center lg:top-[72.7%]"
				style="--canal-vanish: 6.4vw"
				data-audience-category
				data-canal-stage
				data-canal-label
			>
				<h3
					class="display text-center text-lg/tight md:text-xl/tight lg:leading-none xl:text-[22px]/none"
					data-canal-projection
				>
					Also featuring
				</h3>
			</div>
			<div
				class="wrap relative z-30 flex justify-center lg:absolute lg:inset-x-0 lg:top-[calc(72.7%+14px)] lg:pb-0"
				style="--canal-vanish: 9.8vw"
				data-audience-category
				data-canal-stage
				data-canal-items
			>
				<ul
					class="flex flex-col items-center gap-y-3 font-sans max-md:text-center text-xl/tight md:w-max md:flex-row md:items-center md:gap-x-10 lg:gap-x-6 lg:text-[clamp(20px,1.6vw,26px)]/tight"
					data-canal-projection
				>
					{
						extras.map((extra, index) => (
							<li class="flex items-center gap-x-10 lg:gap-x-6">
								{index > 0 && (
									<Heart aria-hidden="true" class="h-5 w-auto max-md:hidden" data-canal-heart />
								)}
								<span>
									{extra[0]} <br class="max-md:hidden" />
									{extra[1]}
								</span>
							</li>
						))
					}
				</ul>
			</div>
		</div>
		<!-- The water is its own layer so the featuring copy can sit on it. -->
		<div class="absolute inset-x-0 bottom-0 bg-[#005FE2] lg:hidden" aria-hidden="true" data-canal-water></div>
		<svg
			class="absolute inset-x-0 bottom-0 h-full w-full max-lg:hidden"
			viewBox="0 0 1440 498"
			preserveAspectRatio="xMidYMid slice"
			aria-hidden="true"
		>
			<path d="M1442.59 506.738V268.449C956.395 262.944 470.208 255.236 -16 255.791V506.738H1442.59Z" fill="#005FE2" />
		</svg>
		<Canal
			data-scene="canal-scroll"
			class="relative z-20 h-auto min-h-(--canal-min-h) w-full max-lg:order-first"
			preserveAspectRatio="xMidYMid slice"
			role="img"
			aria-label="Dutch canal houses, tulips, and boats, with a goose riding a bicycle across a bridge"
		/>
		<!-- Split out of the canal art so they stay in the corners when narrow screens crop the houses. -->
		<FoliageLeft
			class="absolute bottom-0 left-0 z-20 h-auto"
			aria-hidden="true"
			data-canal-foliage="left"
		/>
		<FoliageRight
			class="absolute right-0 bottom-0 z-20 h-auto"
			aria-hidden="true"
			data-canal-foliage="right"
		/>
	</scroll-canal>
</section>

<style is:global>
	@media (prefers-reduced-motion: no-preference) {
		html[data-motion] [data-audience-category]:not([data-reveal="in"]) {
			opacity: 0;
		}
		html[data-motion] [data-audience-category][data-reveal="in"] {
			animation: audience-enter 550ms var(--ease-soft) backwards;
			animation-delay: var(--category-delay, 0ms);
		}
	}
	@keyframes audience-enter {
		from {
			opacity: 0;
			transform: translateY(32px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	svg[data-scene="canal-scroll"] {
		overflow: hidden;
	}
	[data-scene="canal-scroll"] [data-part="water"] {
		visibility: hidden;
	}
	/* Below the width where the canal is this tall, the art keeps its height and crops houses off the
	   sides, so the goose stays big. The foliage scales the same way: its share of the full-width art
	   (440 and 260 of 1440 wide, 168 tall, out of 498), or its size at the minimum height. */
	scroll-canal {
		container-type: inline-size;
		--canal-min-h: 260px;
		/* Resolved where it's used, so cqw is the canal's own width. */
		--canal-h: max(34.583cqw, var(--canal-min-h));
	}
	[data-canal-foliage="left"] {
		width: max(30.556%, calc(var(--canal-min-h) * 440 / 498));
	}
	[data-canal-foliage="right"] {
		width: max(18.056%, calc(var(--canal-min-h) * 260 / 498));
	}
	/* Below lg the water starts at the art's waterline (256 of 498). The label's bottom sits at 362,
	   clear of the pink ripples above it, the boats drop 54 lower than in the art, and the items start
	   at 425, so the boats sail through the middle of the gap, brushing the copy on either side. The items end just above the foliage's
	   tallest leaves. */
	@media (width < 1101px) {
		[data-canal-water] {
			top: calc(var(--canal-h) * 256 / 498);
		}
		[data-canal-label] {
			top: calc(var(--canal-h) * 362 / 498);
		}
		[data-scene="canal-scroll"] [data-part="boats"] {
			transform: translate(0, 72px);
		}
		[data-canal-copy] {
			margin-top: calc(var(--canal-h) * -73 / 498);
		}
		[data-canal-items] {
			padding-bottom: calc(var(--canal-h) * 168 / 498 * 0.7);
		}
	}
	/* The featuring copy sits on the water in the illustration's own cream and ripple pink. */
	[data-canal-projection] {
		color: #fbebd7;
	}
	[data-canal-heart] path {
		fill: #ea97df;
	}
	/* Lays the featuring copy flat on the water, like a projection on the canal. */
	@media (width >= 1101px) {
		/* Vanishing point sits on the bridge's middle arch (52.6% down the canal art), so the
		   copy recedes with the canal. --canal-vanish is each stage's distance up to the arch:
		   (its top% - 52.6%) of the canal height, which is 34.58vw since the canal scales with width. */
		[data-canal-stage] {
			perspective: 600px;
			perspective-origin: 50% calc(50% - var(--canal-vanish));
		}
		[data-canal-projection] {
			transform: rotateX(32deg);
			transform-origin: 50% 100%;
		}
	}
	/* Each piece bobs on its own rhythm, like the boats, so the copy floats on the same water. */
	@media (prefers-reduced-motion: no-preference) {
		[data-canal-projection]:is(h3),
		[data-canal-projection] li {
			animation: canal-scroll-bob-text 4.6s ease-in-out infinite;
		}
		[data-canal-projection] li:nth-child(1) {
			animation-duration: 4.1s;
			animation-delay: -1.3s;
		}
		[data-canal-projection] li:nth-child(2) {
			animation-duration: 5.2s;
			animation-delay: -2.6s;
		}
		[data-canal-projection] li:nth-child(3) {
			animation-duration: 4.4s;
			animation-delay: -0.4s;
		}
	}
	@keyframes canal-scroll-bob-text {
		0%,
		100% {
			translate: 0 0;
		}
		50% {
			translate: 0 -3px;
		}
	}
	[data-scene="canal-scroll"] [data-part="goose-facing"] {
		transform-box: view-box;
		transform-origin: 720.49px 215px;
		transition: transform 250ms ease;
	}
	scroll-canal[data-direction="up"] [data-part="goose-facing"] {
		transform: scaleX(-1);
	}
	[data-scene="canal-scroll"] [data-part="goose-ride"] {
		animation: canal-scroll-ride 1s linear both paused;
		animation-delay: calc(var(--canal-progress, 0.5) * -1s);
	}
	/* Sampled from the original canal walk: the wheel baseline follows the bridge. */
	@keyframes canal-scroll-ride {
		0% {
			translate: -238.84px 27.55px;
			rotate: -16.04deg;
			opacity: 0;
		}
		12.5% {
			translate: -176.23px 12.33px;
			rotate: -11.27deg;
			opacity: 1;
		}
		25% {
			translate: -113.62px 2.02px;
			rotate: -8.31deg;
		}
		37.5% {
			translate: -51.02px -4.39px;
			rotate: -2.7deg;
		}
		50% {
			translate: 1.16px -5.24px;
			rotate: 0.97deg;
		}
		62.5% {
			translate: 63.77px -1.39px;
			rotate: 5.22deg;
		}
		75% {
			translate: 126.38px 7.58px;
			rotate: 9.93deg;
		}
		87.5% {
			translate: 168.11px 16.13px;
			rotate: 13.17deg;
			opacity: 1;
		}
		100% {
			translate: 230.72px 34.26px;
			rotate: 20.62deg;
			opacity: 0;
		}
	}
	[data-scene="canal-scroll"] [data-part="boat-a"] {
		animation: canal-scroll-drift-a 83s linear -23.4s infinite var(--play);
	}
	[data-scene="canal-scroll"] [data-part="boat-b"] {
		animation: canal-scroll-drift-b 83s linear -56s infinite var(--play);
	}
	[data-scene="canal-scroll"] [data-part="boat-a-bob"] {
		animation: canal-scroll-bob-boat 4.2s ease-in-out infinite var(--play);
	}
	[data-scene="canal-scroll"] [data-part="boat-b-bob"] {
		animation: canal-scroll-bob-boat 5.1s ease-in-out infinite var(--play);
	}
	[data-scene="canal-scroll"] [data-part="ripple"] {
		animation: canal-scroll-ripple 5s ease-in-out calc(var(--i) * -1.1s)
			infinite var(--play);
	}
	@keyframes canal-scroll-drift-a {
		from {
			translate: -470px 0;
		}
		to {
			translate: 1195px 0;
		}
	}

	@keyframes canal-scroll-drift-b {
		from {
			translate: -1125px 0;
		}
		to {
			translate: 540px 0;
		}
	}

	@keyframes canal-scroll-bob-boat {
		0%,
		100% {
			translate: 0 0;
			rotate: -1.2deg;
		}
		50% {
			translate: 0 -3px;
			rotate: 1.2deg;
		}
	}

	@keyframes canal-scroll-ripple {
		0%,
		100% {
			translate: -5px 0;
			scale: 0.96 1;
		}
		50% {
			translate: 5px 0;
			scale: 1.04 1;
		}
	}

	/* Reuse the Attend rider rig, with six pedal turns per crossing. */
	@keyframes canal-bike-spin {
		100% {
			transform: rotate(360deg);
		}
	}
	@keyframes canal-bike-crank {
		100% {
			transform: rotate(360deg);
		}
	}
	@keyframes canal-bike-crank-counter {
		100% {
			transform: rotate(-360deg);
		}
	}
	@keyframes canal-bike-leg-near {
		0% {
			transform: skewX(0deg) scaleY(1);
		}
		4.167% {
			transform: skewX(1.84deg) scaleY(1.0276);
		}
		8.333% {
			transform: skewX(3.11deg) scaleY(1.0628);
		}
		12.5% {
			transform: skewX(3.76deg) scaleY(1.1032);
		}
		16.667% {
			transform: skewX(3.81deg) scaleY(1.1461);
		}
		20.833% {
			transform: skewX(3.32deg) scaleY(1.1885);
		}
		25% {
			transform: skewX(2.37deg) scaleY(1.2275);
		}
		29.167% {
			transform: skewX(1.06deg) scaleY(1.2605);
		}
		33.333% {
			transform: skewX(-0.53deg) scaleY(1.2852);
		}
		37.5% {
			transform: skewX(-2.3deg) scaleY(1.3);
		}
		41.667% {
			transform: skewX(-4.18deg) scaleY(1.3039);
		}
		45.833% {
			transform: skewX(-6.06deg) scaleY(1.2965);
		}
		50% {
			transform: skewX(-7.87deg) scaleY(1.2784);
		}
		54.167% {
			transform: skewX(-9.51deg) scaleY(1.2508);
		}
		58.333% {
			transform: skewX(-10.91deg) scaleY(1.2156);
		}
		62.5% {
			transform: skewX(-11.97deg) scaleY(1.1752);
		}
		66.667% {
			transform: skewX(-12.59deg) scaleY(1.1323);
		}
		70.833% {
			transform: skewX(-12.7deg) scaleY(1.0899);
		}
		75% {
			transform: skewX(-12.21deg) scaleY(1.0509);
		}
		79.167% {
			transform: skewX(-11.11deg) scaleY(1.0179);
		}
		83.333% {
			transform: skewX(-9.42deg) scaleY(0.9931);
		}
		87.5% {
			transform: skewX(-7.24deg) scaleY(0.9783);
		}
		91.667% {
			transform: skewX(-4.78deg) scaleY(0.9745);
		}
		95.833% {
			transform: skewX(-2.28deg) scaleY(0.9819);
		}
		100% {
			transform: skewX(0deg) scaleY(1);
		}
	}
	@keyframes canal-bike-leg-far {
		0% {
			transform: skewX(0deg) scaleY(1);
		}
		4.167% {
			transform: skewX(-2.23deg) scaleY(0.9951);
		}
		8.333% {
			transform: skewX(-4.37deg) scaleY(0.9804);
		}
		12.5% {
			transform: skewX(-6.32deg) scaleY(0.9568);
		}
		16.667% {
			transform: skewX(-7.98deg) scaleY(0.9259);
		}
		20.833% {
			transform: skewX(-9.25deg) scaleY(0.8899);
		}
		25% {
			transform: skewX(-10.01deg) scaleY(0.8513);
		}
		29.167% {
			transform: skewX(-10.14deg) scaleY(0.8126);
		}
		33.333% {
			transform: skewX(-9.55deg) scaleY(0.7764);
		}
		37.5% {
			transform: skewX(-8.17deg) scaleY(0.7454);
		}
		41.667% {
			transform: skewX(-6.03deg) scaleY(0.7214);
		}
		45.833% {
			transform: skewX(-3.26deg) scaleY(0.7063);
		}
		50% {
			transform: skewX(-0.13deg) scaleY(0.701);
		}
		54.167% {
			transform: skewX(3.02deg) scaleY(0.7059);
		}
		58.333% {
			transform: skewX(5.81deg) scaleY(0.7207);
		}
		62.5% {
			transform: skewX(7.98deg) scaleY(0.7443);
		}
		66.667% {
			transform: skewX(9.4deg) scaleY(0.7751);
		}
		70.833% {
			transform: skewX(10.03deg) scaleY(0.8111);
		}
		75% {
			transform: skewX(9.93deg) scaleY(0.8497);
		}
		79.167% {
			transform: skewX(9.2deg) scaleY(0.8885);
		}
		83.333% {
			transform: skewX(7.95deg) scaleY(0.9246);
		}
		87.5% {
			transform: skewX(6.3deg) scaleY(0.9557);
		}
		91.667% {
			transform: skewX(4.36deg) scaleY(0.9796);
		}
		95.833% {
			transform: skewX(2.23deg) scaleY(0.9947);
