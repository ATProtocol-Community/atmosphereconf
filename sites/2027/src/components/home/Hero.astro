---
import logo from "../../../images/logo/logo-large.svg?url";
import Goose from "../../../images/guus/flying.svg";
import CloudMarquee from "../site/CloudMarquee.astro";
import EventDetails from "../site/EventDetails.astro";
import RevealWords from "../site/RevealWords.astro";
---

<section
	data-hero
	class="relative min-h-180 overflow-hidden text-white [--cloud-band:220px] sky-gradient md:min-h-212.5 md:[--cloud-band:280px] lg:min-h-248 lg:[--cloud-band:320px]"
	aria-labelledby="hero-title"
>
	<div
		data-hero-parallax
		class="relative z-2 px-5 pt-19 pb-[calc(var(--cloud-band)+24px)] text-center md:px-6 md:pt-27.5 lg:pt-32"
	>
		<h1 id="hero-title">
			<img
				data-hero-logo
				class="mx-auto w-full max-w-132.5 md:w-[min(944px,80vw)] md:max-w-none"
				src={logo}
				alt="AtmosphereConf 2027"
				width="944"
				height="268"
				fetchpriority="high"
			/>
		</h1>
		<p
			class="my-7 display text-[clamp(19px,4vw,28px)] leading-[1.6] [--reveal-at:450ms] [--reveal-step:70ms] md:my-10 md:text-[32px] md:leading-[1.33] lg:text-[48px]"
		>
			<RevealWords text="Building for a new internet" />
		</p>
		<EventDetails />
		<div class="flex flex-wrap justify-center gap-2">
			<a class="btn" href="#tickets"
				>Early-bird tickets <span aria-hidden="true">▸</span></a
			><a
				class="btn btn-outline"
				href="/speak">Apply to speak <span aria-hidden="true">▸</span></a
			>
		</div>
	</div>
	<CloudMarquee variant="a" />
	<div
		class="hero-goose-scroll absolute right-[8%] bottom-6 z-1 w-52.5 md:right-[7%] md:w-67.5 lg:right-[13%] lg:w-81.5 xl:right-[calc(50%-530px)]"
	>
		<div class="hero-goose" data-hero-goose>
			<div class="hero-goose-y">
				<Goose data-scene="hero-goose" class="h-auto w-full" aria-hidden="true" />
			</div>
		</div>
	</div>
</section>

<style>
	@media (prefers-reduced-motion: no-preference) {
		[data-hero-parallax] {
			transform: translateY(var(--hero-parallax, 0px));
		}

		[data-hero] :global(.cloud-strip:first-child) {
			transform: translateY(var(--cloud-back-parallax, 0px));
		}

		[data-hero] :global(.cloud-strip:last-child) {
			transform: translateY(var(--cloud-front-parallax, 0px));
		}

		.hero-goose-scroll {
			transform: translate(var(--goose-scroll-x, 0px), var(--goose-scroll-y, 0px));
		}
	}

	:global(html[data-motion]) [data-hero-logo] {
		animation: hero-logo 900ms var(--ease-soft) backwards;
	}


	@keyframes hero-logo {
		from {
			opacity: 0;
			filter: blur(8px);
			transform: translateY(16px);
		}
		to {
			opacity: 1;
			filter: blur(0);
			transform: translateY(0);
		}
	}

</style>

<script>
	import { prefersReducedMotion } from "../lib/motion";

	const hero = document.querySelector<HTMLElement>("[data-hero]");
	const logo = document.querySelector<HTMLElement>("[data-hero-logo]");

	const ready = () => {
		if (!hero || hero.dataset.heroReady !== undefined) return;
		hero.dataset.heroReady = "";
		hero.dispatchEvent(new CustomEvent("hero:ready", { bubbles: true }));
	};

	if (
		!hero ||
		!logo ||
		prefersReducedMotion() ||
		!document.documentElement.hasAttribute("data-motion")
	) {
		ready();
	} else {
		logo.addEventListener("animationend", ready, { once: true });
		setTimeout(ready, 2600);
	}
</script>

<style is:global>
	[data-scene="hero-goose"] [data-part="goose"] {
		transform-origin: 160px 150px;
		animation: hero-bob 1.1s cubic-bezier(0.45, 0, 0.55, 1) -0.275s infinite
			var(--play);
	}

	[data-scene="hero-goose"] [data-part="wing-near"] {
		animation: hero-flap 1.1s cubic-bezier(0.45, 0, 0.55, 1) infinite
			var(--play);
	}

	[data-scene="hero-goose"] [data-part="wing-far"] {
		animation: hero-flap 1.1s cubic-bezier(0.45, 0, 0.55, 1) infinite
			var(--play);
	}

	[data-scene="hero-goose"] [data-part="leg-near"] {
		animation: hero-dangle-near 1.1s cubic-bezier(0.45, 0, 0.55, 1) infinite
			var(--play);
	}

	[data-scene="hero-goose"] [data-part="leg-far"] {
		animation: hero-dangle-far 1.1s cubic-bezier(0.45, 0, 0.55, 1) -0.12s
			infinite var(--play);
	}

	html[data-motion] .hero-goose:not(.is-flying),
	html[data-motion] .hero-goose.is-flying {
		animation: hero-fly-x 2.2s cubic-bezier(0.2, 0.8, 0.2, 1) both paused;
	}

	html[data-motion] .hero-goose:not(.is-flying) .hero-goose-y,
	html[data-motion] .is-flying .hero-goose-y {
		animation: hero-fly-y 2.2s cubic-bezier(0.6, 0, 0.4, 1) both paused;
	}

	html[data-motion] .hero-goose.is-flying,
	html[data-motion] .is-flying .hero-goose-y {
		animation-play-state: running;
	}

	html[data-motion] .hero-goose.has-landed,
	html[data-motion] .has-landed .hero-goose-y {
		animation: none;
	}

	html[data-motion] .hero-goose.is-flying:not(.has-landed) [data-scene] {
		--play: running;
	}

	.hero-goose-y {
		--fly-lift: -15vh;
	}

	@media (min-width: 701px) {
		.hero-goose-y {
			--fly-lift: -30vh;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-goose,
		.hero-goose-y {
			animation: none !important;
		}
	}

	@keyframes hero-flap {
		0%,
		100% {
			transform: rotate(-6deg);
		}
		50% {
			transform: rotate(20deg);
		}
	}

	@keyframes hero-dangle-near {
		0%,
		100% {
			transform: rotate(-4deg);
		}
		50% {
			transform: rotate(5deg);
		}
	}

	@keyframes hero-dangle-far {
		0%,
		100% {
			transform: rotate(-3deg);
		}
		50% {
			transform: rotate(4deg);
		}
	}

	@keyframes hero-bob {
		0%,
		100% {
			transform: translateY(0) rotate(-1.5deg);
		}
		50% {
			transform: translateY(-7px) rotate(1.5deg);
		}
	}

	@keyframes hero-fly-x {
		from {
			transform: translateX(max(60vw, calc(100% + 12vw)));
		}
		to {
			transform: none;
		}
	}

	@keyframes hero-fly-y {
		from {
			transform: translateY(var(--fly-lift)) rotate(-6deg);
		}
		to {
			transform: none;
		}
	}
</style>

<script>
	import { prefersReducedMotion } from "../lib/motion";

	const goose = document.querySelector<HTMLElement>("[data-hero-goose]");

	if (
		goose &&
		!prefersReducedMotion() &&
		document.documentElement.hasAttribute("data-motion")
	) {
		goose.addEventListener("animationend", (event) => {
			if (event.target === goose && event.animationName === "hero-fly-x") {
				goose.classList.add("has-landed");
			}
		});
		goose.classList.add("is-flying");
	}
</script>

<script>
	import { reducedMotionQuery } from "../lib/motion";

	const scrollHero = document.querySelector<HTMLElement>("[data-hero]");
	const scrollGoose = document.querySelector<HTMLElement>(".hero-goose-scroll");

	if (scrollHero && scrollGoose) {
		let frame = 0;
		const updateScroll = () => {
			frame = 0;
			const distance = reducedMotionQuery.matches
				? 0
				: Math.min(window.scrollY, scrollHero.offsetHeight);
			const progress = reducedMotionQuery.matches
				? 0
				: Math.min(1, window.scrollY / (scrollHero.offsetHeight * 1.3));
			scrollHero.style.setProperty("--hero-parallax", `${distance * 0.18}px`);
			scrollHero.style.setProperty("--cloud-back-parallax", `${distance * 0.4}px`);
			scrollHero.style.setProperty("--cloud-front-parallax", `${distance * -0.1}px`);
			scrollHero.style.setProperty(
				"--goose-scroll-x",
				`${-progress * (window.innerWidth + scrollGoose.offsetWidth)}px`,
			);
			scrollHero.style.setProperty("--goose-scroll-y", `${-progress * 120}px`);
		};
		const scheduleUpdate = () => {
			if (!frame) frame = requestAnimationFrame(updateScroll);
		};
		window.addEventListener("scroll", scheduleUpdate, { passive: true });
		window.addEventListener("resize", scheduleUpdate);
		reducedMotionQuery.addEventListener("change", scheduleUpdate);
		updateScroll();
	}
</script>
