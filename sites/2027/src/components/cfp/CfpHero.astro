---
import vancouver from "../../../images/illustrations/vancouver-stamp.png";
import seattle from "../../../images/illustrations/seattle-stamp.png";
import CloudMarquee from "../site/CloudMarquee.astro";
import { cfp } from "../../data/cfp";
---

<section
	class="relative overflow-hidden bg-azure text-white [--cloud-band:160px] md:[--cloud-band:240px] lg:[--cloud-band:280px] [--cloud-gap:12px] md:[--cloud-gap:18px]"
	aria-labelledby="cfp-title"
>
	<div
		class="relative z-2 wrap flex flex-col items-center pt-16 pb-[calc(var(--cloud-band)+var(--cloud-gap)+24px)] text-center md:pt-24 lg:pt-28"
	>
		<div class="relative">
			<img
				class="absolute top-[12%] left-0 hidden w-40 -translate-x-[115%] -rotate-6 md:block lg:w-52"
				src={vancouver.src}
				alt="A speaker at the Vancouver ATProto conference"
				width={vancouver.width}
				height={vancouver.height}
				data-cfp-photo="left"
			/>
			<h1
				class="display text-[40px]/[1.4] tracking-[0.02em] md:text-[64px]/[1.4] md:tracking-[0.04em] lg:text-[96px]/[1.4]"
				id="cfp-title"
			>
				Speak at<br />Atmosphere<br />Conf 2027
			</h1>
			<img
				class="absolute top-[30%] right-0 hidden w-40 translate-x-[115%] rotate-6 md:block lg:w-52"
				src={seattle.src}
				alt="The audience at the Seattle ATProto conference"
				width={seattle.width}
				height={seattle.height}
				data-cfp-photo="right"
			/>
		</div>
		<a class="btn mt-8 md:mt-10" href={cfp.submissionUrl}
			>Submit a proposal <span aria-hidden="true">▸</span></a
		>
	</div>
	<CloudMarquee variant="c" class="bottom-(--cloud-gap)!" />
</section>

<style>
	:global(html[data-motion]) [data-cfp-photo] {
		animation: 900ms var(--ease-soft) backwards;
	}
	:global(html[data-motion]) [data-cfp-photo="left"] {
		animation-name: cfp-photo-left;
		animation-delay: 200ms;
	}
	:global(html[data-motion]) [data-cfp-photo="right"] {
		animation-name: cfp-photo-right;
		animation-delay: 350ms;
	}
	@keyframes cfp-photo-left {
		from {
			opacity: 0;
			transform: translateX(-60%) rotate(-10deg);
		}
		70% {
			opacity: 1;
			transform: translateX(4%) rotate(1deg);
		}
		to {
			transform: none;
		}
	}
	@keyframes cfp-photo-right {
		from {
			opacity: 0;
			transform: translateX(60%) rotate(10deg);
		}
		70% {
			opacity: 1;
			transform: translateX(-4%) rotate(-1deg);
		}
		to {
			transform: none;
		}
	}
</style>
