---
import buildingBlocks from "../../../images/icons/building-blocks.svg?url";
import magicWand from "../../../images/icons/magic-wand.svg?url";
import microphone from "../../../images/icons/microphone.svg?url";
import scales from "../../../images/icons/scales.svg?url";
import postmark from "../../../images/postmark.svg?url";
import { cfp } from "../../data/cfp";

const themes = [
	{
		name: "Build",
		icon: buildingBlocks,
		description:
			"Apps, infra, protocol, tooling. How they work, and how they break.",
	},
	{
		name: "Create",
		icon: magicWand,
		description:
			"Art, games, fandom, and culture, made and connected in the open.",
	},
	{
		name: "Inform",
		icon: microphone,
		description:
			"Journalism, publishing, and the fight for reliable, trustworthy information.",
	},
	{
		name: "Govern",
		icon: scales,
		description:
			"Moderation, safety, policy, and the rules that shape and protect our spaces.",
	},
];

const formats = [
	{
		kind: "Talk",
		length: "25 minutes",
		description:
			"25 minutes including Q&A. A standard session for deeper stories, demos and discussion.",
	},
	{
		kind: "Lightning talk",
		length: "10 minutes + 5 minutes Q&A",
		description:
			"Short, sharp and recorded in a smaller room. Great for new ideas, quick demos and concise updates.",
	},
	{
		kind: "Workshop",
		length: "90 mins",
		description: "Hands-on session for deeper knowledge sharing.",
	},
];

const tips = [
	{
		title: "Ask yourself who should be in the room for your talk",
		description:
			"Developers (Build), makers and their fans (Create), people who publish (Inform), or people who set and enforce the rules (Govern). Pick that one. We move proposals between themes when it helps, so you can’t pick wrong.",
	},
	{
		title: "The best proposals are specific",
		description:
			"What you built, studied or ran, what you learned (including what didn’t work), and what people can take home from your session. Sales pitches won’t make it through review.",
	},
];

// Each row: heading on the left, content on the right (stacked on phones).
const row =
	"grid gap-6 md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] md:gap-12 lg:gap-19";
const heading = "display text-2xl/[1.3] md:text-[32px]/[1.3]";
const card = "rounded-xl bg-white/15 p-5 md:p-6";
const cardTitle = "font-display text-lg/[1.3] uppercase";
---

<section
	class="bg-linear-to-b from-azure to-[#7d7cd8] text-white"
	aria-label="What to propose"
>
	<div
		class="wrap flex flex-col gap-16 py-16 md:gap-20 md:py-20 lg:gap-24 lg:py-30"
	>
		<div class={row}>
			<h2 class={heading}>What we’re looking for</h2>
			<div class="space-y-6 text-sm md:text-base">
				<p>
					We’re looking for talks from everyone building, using and thinking
					about the Atmosphere, the open network of apps and services built on
					AT Protocol.
				</p>
				<p>
					Developers, yes, but far from only developers. We want to hear from
					researchers, artists, journalists, community builders, policy people
					and anyone (interested in) running something real on atproto.
					First-time speakers are very welcome.
				</p>
			</div>
		</div>

		<div class={row}>
			<div>
				<h2 class={heading}>Four themes to choose from</h2>
				<img
					class="mt-12 hidden w-37.5 brightness-0 invert md:block"
					src={postmark}
					alt=""
					width="150"
					height="75"
					loading="lazy"
				/>
			</div>
			<ul class="grid gap-3 md:grid-cols-2 md:gap-4">
				{
					themes.map(({ name, icon, description }) => (
						<li class={card}>
							<img
								class="w-12 md:w-14"
								src={icon}
								alt=""
								width="90"
								height="90"
								loading="lazy"
							/>
							<h3 class:list={[cardTitle, "mt-6"]}>{name}</h3>
							<p class="mt-2 text-sm/5">{description}</p>
						</li>
					))
				}
			</ul>
		</div>

		<div class={row}>
			<h2 class={heading}>Two formats, choose what fits your story best.</h2>
			<ul class="grid gap-3 md:grid-cols-3 md:gap-4">
				{
					formats.map(({ kind, length, description }) => (
						<li class={card}>
							<h3 class="eyebrow">{kind}</h3>
							<p class:list={[cardTitle, "mt-4"]}>{length}</p>
							<p class="mt-3 text-sm/5">{description}</p>
						</li>
					))
				}
			</ul>
		</div>

		<div class={row}>
			<h2 class={heading}>Still not sure?</h2>
			<ul class="grid gap-3 md:grid-cols-2 md:gap-4">
				{
					tips.map(({ title, description }) => (
						<li class={card}>
							<h3 class={cardTitle}>{title}</h3>
							<p class="mt-4 text-sm/5">{description}</p>
						</li>
					))
				}
			</ul>
		</div>

		<a class="btn self-center" href={cfp.submissionUrl}
			>Submit a proposal <span aria-hidden="true">▸</span></a
		>
	</div>
</section>
