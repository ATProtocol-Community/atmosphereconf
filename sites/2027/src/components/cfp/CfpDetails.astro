---
import Icon from "../site/Icon.astro";
import type { IconName } from "../site/Icon.astro";
import postmark from "../../../images/postmark.svg?url";
import puffy from "../../../images/clouds/puffy.svg?url";
import long from "../../../images/clouds/long.svg?url";
import LookingGoose from "../../../images/guus/looking.svg";

const themes: { name: string; icon: IconName; description: string }[] = [
	{
		name: "Build",
		icon: "building-blocks",
		description:
			"Apps, infra, protocol, tooling. How they work, and how they break.",
	},
	{
		name: "Create",
		icon: "magic-wand",
		description:
			"Art, games, fandom, and culture, made and connected in the open.",
	},
	{
		name: "Inform",
		icon: "microphone",
		description:
			"Journalism, publishing, and the fight for reliable, trustworthy information.",
	},
	{
		name: "Govern",
		icon: "scales",
		description:
			"Moderation, safety, policy, and the rules that shape and protect our spaces.",
	},
];

// Each row: heading on the left, content on the right (stacked on phones).
const row =
	"grid gap-6 md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] md:gap-12 lg:gap-19";
const heading = "display text-2xl/[1.5] md:text-[32px]/[1.5]";
const card = "rounded-xl bg-white/15 p-5 md:p-6";
const cardTitle = "font-display text-lg/[1.5] uppercase";
---

<section class="overflow-hidden bg-white" aria-labelledby="looking-for-title">
	<div class="relative wrap pt-16 pb-32 md:pt-20 md:pb-40 lg:pt-30">
		<div class={row}>
			<h2 class={heading} id="looking-for-title">
				What we’re<br />looking for
			</h2>
			<div class="text-slate md:pt-10">
				<p>
					<span class="font-bold text-pretty">We’re looking for talks</span> from
					everyone building, using and dreaming about the Atmosphere—the open network
					of apps and services built on AT Protocol.
				</p>
				<p class="mt-8">
					<span class="font-bold text-pretty"
						>Developers, yes, but not only:</span
					> we want to hear from researchers, artists, journalists, community builders,
					policy people, and everyone else with projects, thoughts, experiences, and insights to share.
				
				</p>
				<p class="mt-8">	First-time speakers are <u>very</u> welcome.
					</p>
			</div>
		</div>
		<!-- Sits half below the section edge so Guus peeks up from the next section. -->
		<LookingGoose
			data-scene="cfp-goose"
			class="absolute right-6 bottom-0 h-auto w-40 translate-y-[45%] md:right-[15%] md:w-52"
			aria-hidden="true"
		/>
	</div>
</section>

<section
	class="relative overflow-hidden bg-linear-to-b from-azure to-[#7d7cd8] text-white"
	aria-label="What to propose"
>
	<div class="pointer-events-none absolute inset-0" aria-hidden="true">
		<img
			class="absolute top-16 -left-30 w-60 opacity-45 md:top-20 md:-left-28 md:w-80 lg:top-30 lg:w-95"
			src={puffy}
			alt=""
			width="451"
			height="196"
			loading="lazy"
		/>
		<img
			class="absolute top-80 -right-32 w-75 opacity-60 md:top-26 md:-right-30 md:w-90 lg:top-36 lg:-right-28 lg:w-105"
			src={long}
			alt=""
			width="735"
			height="272"
			loading="lazy"
		/>
	</div>
	<div
		class="relative z-1 wrap flex flex-col gap-16 py-16 md:gap-20 md:py-20 lg:gap-40 lg:py-30"
	>
		<div class={row}>
			<div>
				<h2 class={heading}>Four themes to choose from</h2>
				<img
					class="mt-12 hidden w-37.5 brightness-0 invert md:block"
					src={postmark}
					alt=""
					width="150"
					height="75"
					loading="lazy"
				/>
			</div>
			<ul class="grid gap-3 md:grid-cols-2 md:gap-4">
				{
					themes.map(({ name, icon, description }) => (
						<li class:list={[card, "card-lift"]} data-card>
							<Icon name={icon} class="size-12 md:size-14" />
							<h3 class:list={[cardTitle, "mt-6"]}>{name}</h3>
							<p class="mt-2 text-sm/5">{description}</p>
						</li>
					))
				}
			</ul>
		</div>

		<div class={row}>
			<h2 class={heading}>Two formats, choose what fits your story best.</h2>
			<ul class="grid gap-3 md:grid-cols-2 md:gap-4">
				<li class:list={[card, "md:last:col-span-2"]}>
					<h3 class="eyebrow">Regular</h3>
					<p class:list={[cardTitle, "mt-4"]}>25 minutes <span class="text-[#fda9a7]">Talk</span></p>
					<p class="mt-3 text-sm/5">
						25 minutes including Q&A. A standard session for deeper stories,
						demos and discussion.
					</p>
				</li>
				<li class:list={[card, "md:last:col-span-2"]}>
					<h3 class="eyebrow">Short</h3>
					<p class:list={[cardTitle, "mt-4"]}>10 minutes <span class="text-[#fda9a7]">Lightning&nbsp;talk</span><br/><span class="text-sm/5">with 5 minutes Q&A</span></p>
					<p class="mt-3 text-sm/5">
						Short, sharp and recorded in a smaller room. Great for new ideas,
						quick demos and concise updates.
					</p>
				</li>
				<li class:list={[card, "md:last:col-span-2"]}>
					<h3 class="eyebrow">Hands-on</h3>
					<p class:list={[cardTitle, "mt-4"]}>90 mins <span class="text-[#fda9a7]">Workshop</span></p>
					<p class="mt-3 text-sm/5">
						A longer session for deeper knowledge sharing.
					</p>
				</li>
			</ul>
		</div>

	</div>
</section>

<style is:global>
	[data-scene="cfp-goose"] [data-part="eye"] {
		transform-box: fill-box;
		transform-origin: center;
		animation: cfp-goose-blink 4.5s ease-in-out infinite var(--play);
	}

	@keyframes cfp-goose-blink {
		0%,
		90%,
		94%,
		96%,
		100% {
			transform: scaleY(1);
		}
		92%,
		98% {
			transform: scaleY(0.1);
		}
	}
</style>
