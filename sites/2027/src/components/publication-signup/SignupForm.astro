---
import ComboBox from "../ComboBox.astro";
import Tooltip from "../Tooltip.astro";
import { hasDatabase } from "../lib/db";
import { newsSignup } from "./settings";
import HandleIcon from "../postcard/HandleIcon.astro";
import RotatingSuffix from "../postcard/RotatingSuffix.astro";

interface Props {
	error?: string;
}

const { error } = Astro.props;
// With a database, emails stop here to be saved on the way to Leaflet;
// otherwise they go straight there.
const emailAction = hasDatabase ? "/subscribe" : newsSignup.form.action;
const emailMethod = hasDatabase ? "post" : newsSignup.form.method;
---

<form
	class="postcard-form"
	action={emailAction}
	method={emailMethod}
	data-email-action={emailAction}
	data-email-method={emailMethod}
>
	<fieldset class="segmented">
		<input id="method-email" name="method" type="radio" value="email" checked />
		<label class="segmented-option" for="method-email">
			<span class="segmented-icon" aria-hidden="true">
				<svg
					width="24"
					height="24"
					viewBox="0 0 24 24"
					xmlns="http://www.w3.org/2000/svg"
				>
					<path
						fill="currentColor"
						d="M5 5h13a3 3 0 0 1 3 3v9a3 3 0 0 1-3 3H5a3 3 0 0 1-3-3V8a3 3 0 0 1 3-3m0 1c-.5 0-.94.17-1.28.47l7.78 5.03l7.78-5.03C18.94 6.17 18.5 6 18 6zm6.5 6.71L3.13 7.28C3.05 7.5 3 7.75 3 8v9a2 2 0 0 0 2 2h13a2 2 0 0 0 2-2V8c0-.25-.05-.5-.13-.72z"
					></path>
				</svg>
			</span>
			<span class="segmented-text">Email</span>
		</label>
		<input id="method-handle" name="method" type="radio" value="handle" />
		<label class="segmented-option" for="method-handle">
			<span class="segmented-icon" aria-hidden="true">
				<HandleIcon />
			</span>
			<span class="segmented-text">Handle</span>
		</label>
	</fieldset>
	<label class="sr-only" for="airmail-email">Email or Atmosphere handle</label>
	<div class="airmail-email-wrap">
		<ComboBox
			id="airmail-email"
			name="email"
			inputClass="postcard-field"
			autocomplete="username webauthn email"
			placeholder="you@example.com"
			label="login text"
			required
		/>
		<div class="airmail-email-placeholder">
			<span class="airmail-prefix-text">you</span><RotatingSuffix
				words={["@example.com", ".bsky.social", ".blacksky.social",".example.com"]}
			/>
		</div>
	</div>
	<p class="tip">
		Whether via{" "}
		<Tooltip
			id="postcard-email-tooltip"
			label="email"
			class="email"
			blockAnchor="--tip">You know what this is.</Tooltip
		>{" "}or{" "}
		<Tooltip
			id="postcard-atmosphere-tooltip"
			label="Atmosphere handle"
			class="handle"
			blockAnchor="--tip"
			>From Blacksky to Pckt, from Bluesky to Offprint, the same username
			unlocks countless apps and website—no matter which got you first.</Tooltip
		>, our news reaches you all across the web.
	</p>
	<div class="form-actions">
		<a class="form-actions-link" href="/rsvp"
			>Coming there? RSVP! <span aria-hidden="true">→</span></a
		>
		<button class="postcard-action small-action" type="submit"
			>Keep me posted <span aria-hidden="true">↗</span></button
		>
	</div>
	{
		error && (
			<p
				id="postcard-subscription-result"
				class="postcard-error"
				role="alert"
				tabindex="-1"
			>
				{error}
			</p>
		)
	}
	<input type="hidden" name="action" value={newsSignup.form.fields.action} />
	<input type="hidden" name="redirect" value={newsSignup.form.fields.redirect} />
</form>
<script>
	import { searchActors, type ActorSuggestion } from "../lib/actor-search";
	import { attachSpritePreview } from "../lib/sprite-preview";

	type Mode = "email" | "handle";

	const form = document.querySelector<HTMLFormElement>("form.postcard-form");
	const input = document.getElementById("airmail-email") as HTMLInputElement | null;
	const radios = {
		email: document.getElementById("method-email") as HTMLInputElement | null,
		handle: document.getElementById("method-handle") as HTMLInputElement | null,
	};
	const combobox = input?.closest("cmb-combobox");
	const redirectInput = form?.querySelector<HTMLInputElement>('input[name="redirect"]');
	const actionInput = form?.querySelector<HTMLInputElement>('input[name="action"]');
	// Captured now: assigning a hidden input's value also rewrites its defaultValue.
	const newsRedirect = redirectInput?.value ?? "";

	// RotatingSuffix ends on a repeat of its first word; that last slot is the
	// one we overwrite so the placeholder settles on a word for the method.
	const suffixSlots = Array.from(
		form?.querySelectorAll<HTMLDivElement>(".suffix-options div") ?? [],
	);
	const suffixWords = suffixSlots.map((el) => el.textContent?.trim() ?? "");
	const suffixFor: Record<Mode, string | undefined> = {
		email: suffixWords[0],
		handle: suffixWords.at(-2),
	};

	const didPattern = /^did:[a-z0-9.-]+:/i;
	const handleLikePattern = /^@[\w.-]+$|^[a-z0-9][a-z0-9-]*\.[a-z0-9][a-z0-9.-]*$/i;
	// Only signals that can't change meaning with more typing: a bare dotted
	// word ("bob.smith") looks like a handle until the "@" arrives.
	const detectSureMode = (raw: string): Mode | null => {
		const value = raw.trim().toLowerCase();
		if (didPattern.test(value) || value.startsWith("@")) return "handle";
		if (value.includes("@")) return "email";
		return null;
	};
	const detectMode = (raw: string): Mode => {
		const sure = detectSureMode(raw);
		if (sure) return sure;
		return handleLikePattern.test(raw.trim()) ? "handle" : "email";
	};

	let mode: Mode = radios.handle?.checked ? "handle" : "email";
	const spritePreview = input
		? attachSpritePreview(input, () => mode === "handle")
		: undefined;

	// Everything the method affects is written here, from `mode` alone.
	const render = () => {
		const radio = radios[mode];
		if (radio) radio.checked = true;
		combobox?.toggleAttribute("disable-suggestions", mode === "email");
		const word = suffixFor[mode];
		const slot = suffixSlots.at(-1);
		if (word && slot) slot.textContent = word;
	};

	const setMode = (next: Mode) => {
		if (next === mode) return;
		mode = next;
		render();
		if (mode === "handle") spritePreview?.refresh();
		else spritePreview?.reset();
	};

	// The radio sets the mode; typing overrides it once the text is unambiguous.
	radios.email?.addEventListener("change", () => setMode("email"));
	radios.handle?.addEventListener("change", () => setMode("handle"));
	input?.addEventListener("input", () => {
		const sure = detectSureMode(input.value);
		if (sure) setMode(sure);
	});

	combobox?.addEventListener("combobox-search", (e) => {
		const detail = (
			e as CustomEvent<{ query: string; results: Promise<ActorSuggestion[]> | null }>
		).detail;
		try {
			detail.results = searchActors((detail?.query ?? "").trim());
		} catch {
			// Keep form usable if search event detail is immutable for this environment.
		}
	});

	form?.addEventListener("submit", () => {
		if (!input) return;
		const identifier = input.value.trim();
		setMode(detectMode(identifier));
		const isHandle = mode === "handle";
		// Reset every field even when returning with Back or changing methods.
		form.setAttribute("method", isHandle ? "post" : form.dataset.emailMethod!);
		form.setAttribute("action", isHandle ? "/oauth/login" : form.dataset.emailAction!);
		input.name = isHandle ? "atproto-id" : "email";
		input.value = isHandle ? identifier.replace(/^@/, "") : identifier;
		if (redirectInput) redirectInput.value = isHandle ? "/subscribe" : newsRedirect;
		if (actionInput) actionInput.disabled = isHandle;
	});

	render();
	document.getElementById("postcard-subscription-result")?.focus();
</script>
<style>
	form {
		--rounding: 16px;
	}

	label {
		font-size: 11px;
		font-weight: 700;
	}

	.segmented {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0;
		padding: 3px;
		border: 1px solid var(--ink);
		border-radius: var(--rounding);
		position: relative;
		overflow: hidden;
		isolation: isolate;
	}

	.segmented::before {
		content: "";
		position: absolute;
		top: 3px;
		left: 3px;
		width: calc(50% - 3px);
		height: calc(100% - 6px);
		background: var(--butter);
		border-radius: calc(var(--rounding) - 3px);
		transform: translateX(0);
		transition:
			transform 280ms cubic-bezier(0.22, 1, 0.36, 1),
			background-color 160ms ease;
		z-index: -1;
	}

	form:has(input ~ input:checked) .segmented::before {
		transform: translateX(calc(100%));
	}

	.segmented input[type="radio"] {
		position: absolute;
		opacity: 0;
		width: 1px;
		height: 1px;
		margin: 0;
		overflow: hidden;
		clip-path: inset(100%);
	}

	.segmented-option {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		padding: 2px 12px;
		border-radius: 999px;
		cursor: pointer;
		color: var(
			--tab-inactive-foreground,
			color-mix(in oklab, var(--ink) 70%, transparent)
		);
		transition: color 220ms ease;
	}

	.segmented-text {
		display: inline-block;
		transition:
			transform 220ms ease,
			opacity 220ms ease;
	}

	.segmented-option:focus-visible {
		outline: 2px solid var(--strong);
		outline-offset: 2px;
	}

	input {
		border-radius: var(--rounding);
	}

	input[type="radio"]:checked + .segmented-option {
		color: var(--tab-active-foreground, var(--ink));
	}

	input[type="radio"]:checked + .segmented-option .segmented-text {
		transform: translateX(0);
		opacity: 1;
	}

	input[type="radio"] + .segmented-option .segmented-text {
		opacity: var(--tab-text-opacity, 1);
	}

	.segmented-icon {
		font-size: 13px;
		line-height: 1;
	}

	/* The triggers are rendered by <Tooltip>, so they carry that component's
	   scope, not this one's. The scoped `form` still confines these to us. */
	form:has(input[value="handle"]:checked) :global(.tooltip-button.handle),
	form:has(input[value="email"]:checked) :global(.tooltip-button.email) {
		color: var(--cancel-stamp);
	}

	.airmail-email-wrap {
		position: relative;
		--card: white;
	}

	.airmail-email-placeholder {
		position: absolute;
		left: 15px;
		top: 50%;
		transform: translateY(-50%);
		color: var(--ink);
		opacity: 0.65;
		pointer-events: none;
		/* Above the input, which now has its own fill; clicks pass through. */
		z-index: 2;
		display: flex;
		height: 100%;
		align-items: center;
	}

	:global(#airmail-email)::placeholder {
		opacity: 0;
	}

	:global(
		form:has(#airmail-email:not(:placeholder-shown)) .airmail-email-placeholder
	) {
		opacity: 0;
	}

	:global(#airmail-email) {
		appearance: none;
		-webkit-appearance: none;
		position: relative;
		z-index: 1;
	}
	:global(#airmail-email-listbox) {
		padding-block: 10px;
		li {
			padding: 8px 10px;
		}
		li:hover {
			background: var(--butter);
			border-radius: var(--rounding);
		}
	}

	.tip {
		position: relative;
		margin: 0;
		font-size: 14px;
		line-height: 1.4;
		font-weight: 500;
		/* Narrow-screen anchor: tooltips span the paragraph, as they did in flow. */
		anchor-name: --tip;
	}

</style>
