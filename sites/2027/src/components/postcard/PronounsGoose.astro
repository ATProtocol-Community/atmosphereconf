---
import GooseSvg from "./goose.svg";
---

<div id="pronouns-flock" aria-label="A diverse flock of geese">
	<div class="flock-goose adult-one">
		<GooseSvg />
	</div>
	<div class="flock-goose adult-two">
		<GooseSvg />
	</div>
	<div class="flock-goose gosling-one">
		<GooseSvg />
	</div>
	<div class="flock-goose gosling-two">
		<GooseSvg />
	</div>
</div>

<style>
	#pronouns-flock {
		display: none;
		position: absolute;
		right: -25%;
		bottom: -20%;
		width: 150%;
		height: 150%;
		overflow: visible;
	}

	.flock-goose {
		position: absolute;
		bottom: 0;
		transform-origin: 50% 90%;
	}

	.flock-goose :global(#goose-svg) {
		display: block;
		width: 100%;
		height: 100%;
		filter: drop-shadow(4px 5px 2px rgb(0 0 0 / 0.32));
	}

	.adult-one {
		left: 2%;
		z-index: 2;
		width: 54%;
		height: 68%;
		--goose: #e06c3a;
	}

	.adult-two {
		left: 35%;
		z-index: 1;
		width: 52%;
		height: 64%;
		--goose: #5398a4;
	}

	.gosling-one {
		left: 28%;
		z-index: 3;
		width: 28%;
		height: 38%;
		--goose: #ccd850;
	}

	.gosling-two {
		left: 56%;
		z-index: 3;
		width: 24%;
		height: 34%;
	}

	.gosling-one :global(#goose-svg),
	.gosling-two :global(#goose-svg) {
		filter: drop-shadow(2px 3px 1px rgb(0 0 0 / 0.32));
	}
</style>
