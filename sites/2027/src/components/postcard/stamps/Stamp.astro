---
import mascot from "./2025-mascot.png";
import type { StampDefinition } from "./stamps";

interface Props {
	stamp: StampDefinition;
}

const { stamp } = Astro.props;
---

<span class:list={["stamp", stamp.id]} id="selected-stamp" aria-hidden="true">
	<span class="stamp-year">{stamp.year}</span>
	<span class="portrait">
		<img src={mascot.src} alt="" width="792" height="990" />
	</span>
	<i class="tulip-dot"></i>
	<i class="tulip-dot"></i>
	<i class="tulip-dot"></i>
	<span class="cancel">
		<em>@</em>
		<i></i>
		<i></i>
		<i></i>
	</span>
</span>

<style>
	.stamp {
		--delft: #315f8e;
		--stamp-cream: #fff5d9;
		--stamp-orange: #df9864;
		position: relative;
		display: block;
		width: 100%;
		aspect-ratio: 4 / 5;
		overflow: hidden;
		color: var(--delft);
		background: #f5d583;
		border: 5px dotted var(--paper);
	}

	.stamp::before {
		position: absolute;
		inset: 4px;
		z-index: 3;
		content: "";
		border: 1px solid currentColor;
	}

	.stamp-year {
		position: absolute;
		top: 9px;
		right: 8px;
		z-index: 4;
		font: 800 10px "Courier New", monospace;
	}

	.portrait {
		position: absolute;
		inset: 0;
		overflow: hidden;
	}

	.portrait img {
		position: absolute;
		top: 7%;
		left: -27%;
		width: 154%;
		max-width: none;
		height: auto;
	}

	.delft {
		background: var(--delft);
		color: var(--stamp-cream);
	}

	.delft img {
		filter: invert(96%) sepia(12%) saturate(556%);
	}

	.tulip img,
	.postcard-stamp img {
		top: 2%;
	}

	.tulip-dot {
		display: none;
		position: absolute;
		bottom: 10px;
		z-index: 4;
		width: 9px;
		height: 13px;
		border-radius: 55% 55% 45% 45%;
		background: var(--stamp-orange);
	}

	.tulip .tulip-dot {
		display: block;
	}

	.tulip-dot::after {
		position: absolute;
		top: 10px;
		left: 4px;
		width: 1px;
		height: 10px;
		content: "";
		background: var(--delft);
	}

	.tulip-dot:nth-of-type(1) {
		left: 24%;
	}

	.tulip-dot:nth-of-type(2) {
		left: 48%;
		background: #c8b9df;
	}

	.tulip-dot:nth-of-type(3) {
		left: 72%;
		background: #9bcbb5;
	}

	.airmail {
		background: repeating-linear-gradient(
			135deg,
			#8cc8e4 0 7px,
			var(--stamp-cream) 7px 14px,
			var(--stamp-orange) 14px 21px,
			var(--stamp-cream) 21px 28px
		);
	}

	.airmail .portrait {
		inset: 7px;
		background: var(--stamp-cream);
		border: 1px solid var(--delft);
	}

	.airmail::before {
		display: none;
	}

	.canal {
		background: #9bcbb5;
	}

	.canal .portrait {
		inset: 14% 10%;
		background: var(--stamp-cream);
		border: 1px solid var(--delft);
		border-radius: 50%;
	}

	.canal img {
		top: -5%;
		left: -34%;
		width: 168%;
	}

	.cancelled {
		background: #8cc8e4;
	}

	.cancelled img {
		top: 3%;
	}

	.cancel {
		position: absolute;
		right: -5px;
		bottom: 12px;
		z-index: 5;
		display: none;
		grid-template-columns: 30px 40px;
		gap: 3px 4px;
		align-items: center;
		color: var(--stamp-orange);
		transform: rotate(-8deg);
	}

	.cancelled .cancel,
	.postcard-stamp .cancel {
		display: grid;
	}

	.cancel em {
		grid-row: 1 / 4;
		display: grid;
		width: 30px;
		aspect-ratio: 1;
		place-items: center;
		border: 1px solid currentColor;
		border-radius: 50%;
		font-size: 16px;
		font-style: normal;
		font-weight: 900;
	}

	.cancel i {
		height: 1px;
		background: currentColor;
	}
</style>
