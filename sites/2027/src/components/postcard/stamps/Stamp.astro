---
import mascot from "./2026-mascot.png";
import goose from "./2025-mascot.png";
import type { StampDefinition } from "./stamps";

interface Props {
	stamp: StampDefinition;
}

const { stamp } = Astro.props;
---

<span class:list={["stamp", stamp.id, stamp.character]} id="selected-stamp" aria-hidden="true">
	<span class="stamp-year">{stamp.year}</span>
	<span class="portrait">
		<img class="mascot-art" src={mascot.src} alt="" width="792" height="990" />
		<img class="goose-art" src={goose.src} alt="" width={goose.width} height={goose.height} />
	</span>
</span>

<style>
	.stamp {
		--delft: #315f8e;
		--stamp-cream: #fff5d9;
		--stamp-orange: #df9864;
		position: relative;
		display: block;
		width: 100%;
		aspect-ratio: 4 / 5;
		overflow: hidden;
		color: var(--delft);
		background: #f5d583;
		border: 5px solid transparent;
		mask:
			radial-gradient(circle at 50% 0, transparent 3px, #000 3.5px) 0 0 / 12px 100%,
			radial-gradient(circle at 50% 100%, transparent 3px, #000 3.5px) 0 0 / 12px 100%,
			radial-gradient(circle at 0 50%, transparent 3px, #000 3.5px) 0 0 / 100% 12px,
			radial-gradient(circle at 100% 50%, transparent 3px, #000 3.5px) 0 0 / 100% 12px;
		mask-composite: intersect;
	}

	.stamp::before {
		position: absolute;
		inset: 4px;
		z-index: 3;
		content: "";
		border: 1px solid currentColor;
	}

	.stamp-year {
		position: absolute;
		top: 9px;
		right: 8px;
		z-index: 4;
		font: 800 10px "Courier New", monospace;
	}

	.portrait {
		position: absolute;
		inset: 0;
		overflow: hidden;
	}

	.portrait img {
		position: absolute;
		top: 7%;
		left: -27%;
		width: 154%;
		max-width: none;
		height: auto;
	}

	.delft {
		background: var(--delft);
		color: var(--stamp-cream);
	}

	.postcard-stamp img {
		top: 2%;
	}

	.airmail {
		background: repeating-linear-gradient(
			135deg,
			#8cc8e4 0 7px,
			var(--stamp-cream) 7px 14px,
			var(--stamp-orange) 14px 21px,
			var(--stamp-cream) 21px 28px
		);
		background-origin: border-box;
	}

	.airmail .portrait {
		inset: 7px;
		background: var(--stamp-cream);
		border: 1px solid var(--delft);
	}

	.airmail::before {
		display: none;
	}

	.canal {
		background: #9bcbb5;
	}

	.canal .portrait {
		inset: 14% 10%;
		background: var(--stamp-cream);
		border: 1px solid var(--delft);
		border-radius: 50%;
	}

	.canal img {
		top: -5%;
		left: -34%;
		width: 168%;
	}

	.cancelled {
		background: #8cc8e4;
	}

	.cancelled img {
		top: 3%;
	}

	.portrait .goose-art {
		display: none;
		top: 16%;
		left: 6%;
		width: 88%;
		height: 76%;
		object-fit: contain;
	}

	.goose .mascot-art {
		display: none;
	}

	.goose .goose-art {
		display: block;
	}

	.goose.canal .goose-art {
		top: 10%;
		left: -48%;
		width: 185%;
		height: auto;
	}

	.goose.delft .goose-art {
		top: 17%;
		left: -35%;
		width: 155%;
		height: auto;
	}

	.goose.airmail .goose-art {
		top: 20%;
		left: -5%;
		width: 110%;
		height: auto;
		transform: rotate(-12deg);
	}

	.goose.cancelled .goose-art {
		top: 12%;
		left: -20%;
		width: 140%;
		height: auto;
		transform: rotate(10deg);
	}
</style>
