---
import Stamp from "./Stamp.astro";
import { stamps } from "./stamps";

const featuredStamp = stamps[0];

type Props = {
	compact?: boolean;
};

const { compact } = Astro.props;
---

<div class="postage-row" class:list={{ compact }}>
	<div class="postmark-group" aria-hidden="true">
		<span class="postmark-art">
			<svg class="postmark" viewBox="7 28 164 94" aria-hidden="true">
				<g fill="none" stroke="currentColor" stroke-width="1.8">
					<rect x="10" y="31" width="158" height="88"></rect>
					<rect x="15" y="36" width="148" height="78" stroke-width=".8"></rect>
					<path d="M15 61h148M87 61v53M87 88h76"></path>
				</g>
				<g
					fill="currentColor"
					text-anchor="middle"
					font-family="Courier New, monospace"
					font-weight="700"
				>
					<text x="89" y="52" font-size="12" letter-spacing="1"
						>atmosphereconf</text
					>
					<text x="125" y="80" font-size="13">COMING</text>
					<text x="125" y="105" font-size="12">2027</text>
				</g>
				<text
					x="51"
					y="101"
					fill="currentColor"
					text-anchor="middle"
					font-family="Avenir Next, sans-serif"
					font-size="38"
					font-weight="700">@</text
				>
			</svg>
		</span>
		<span class="postmark-waves-art">
			<svg
				class="postmark-waves"
				viewBox="-2 0 136 50"
				preserveAspectRatio="none"
				aria-hidden="true"
			>
				<g
					class="cancellation-waves"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
				>
					<path d="M0 10c11-10 22-10 33 0s22 10 33 0 22-10 33 0 22 10 33 0"
					></path>
					<path d="M0 25c11-10 22-10 33 0s22 10 33 0 22-10 33 0 22 10 33 0"
					></path>
					<path d="M0 40c11-10 22-10 33 0s22 10 33 0 22-10 33 0 22 10 33 0"
					></path>
				</g>
			</svg>
		</span>
	</div>
	<div class="current-stamp-wrap">
		<button
			id="current-stamp"
			class="current-stamp"
			type="button"
			aria-label={`Stamp design: ${featuredStamp.name}; click to cycle`}
			data-stamps={JSON.stringify(stamps)}
		>
			<Stamp stamp={featuredStamp} />
		</button>
	</div>
</div>
<p class="sr-only" data-stamp-announcement aria-live="polite"></p>

<script>
	import type { StampDefinition } from "./stamps";

	const current = document.querySelector<HTMLButtonElement>("#current-stamp");
	const selected = current?.querySelector<HTMLElement>("#selected-stamp");
	const announcement = document.querySelector<HTMLElement>(
		"[data-stamp-announcement]",
	);
	const stampDesigns: StampDefinition[] = JSON.parse(
		current?.dataset.stamps ?? "[]",
	);
	const stampStorageKey = "2027:postcard-stamp";
	const getStampStorageId = (stamp: StampDefinition) =>
		`${stamp.id}:${stamp.character ?? "mascot"}`;
	const readStoredStamp = () => {
		try {
			return localStorage.getItem(stampStorageKey);
		} catch {
			return null;
		}
	};
	const writeStoredStamp = (stamp: StampDefinition) => {
		try {
			localStorage.setItem(stampStorageKey, getStampStorageId(stamp));
		} catch {
			// Storage can be unavailable without preventing stamp selection.
		}
	};
	const applyStamp = (stamp: StampDefinition, announce = false) => {
		if (!current || !selected) return;

		selected.className = ["stamp", stamp.id, stamp.character]
			.filter(Boolean)
			.join(" ");
		const year = selected.querySelector<HTMLElement>(".stamp-year");
		if (year) year.textContent = stamp.year;
		current.setAttribute(
			"aria-label",
			`Stamp design: ${stamp.name}; click to cycle`,
		);
		if (announce && announcement) {
			announcement.textContent = `${stamp.name} stamp selected`;
		}
	};

	const storedStampId = readStoredStamp();
	const storedStampIndex = stampDesigns.findIndex(
		(stamp) => getStampStorageId(stamp) === storedStampId,
	);
	let stampIndex = storedStampIndex >= 0 ? storedStampIndex : 0;
	const initialStamp = stampDesigns[stampIndex];
	if (initialStamp) applyStamp(initialStamp);

	current?.addEventListener("click", () => {
		if (!selected || !stampDesigns.length) return;

		stampIndex = (stampIndex + 1) % stampDesigns.length;
		const stamp = stampDesigns[stampIndex];
		applyStamp(stamp, true);
		writeStoredStamp(stamp);
	});
</script>

<style>
	.postage-row {
		position: relative;
		isolation: isolate;
		position: relative;
		display: flex;
		flex-direction: row-reverse;
		container-type: inline-size;
		gap: 12px;
		width: 100%;
		margin-left: auto;
		margin-top: -17px;
		margin-right: -22px;
	}

	.postage-row.compact {
		flex-direction: column-reverse;
		margin: 0;
		align-items: center;
		max-height: 320px;
		height: 100%;
	}

	.postmark-group {
		--postmark-width: clamp(120px, 18vw, 165px);
		position: relative;
		display: flex;
		flex: 1 1 auto;
		align-items: center;
		justify-content: flex-start;
		width: calc(var(--postmark-width) + 80px);
		min-width: 0;
		aspect-ratio: 164 / 94;
		transform: rotate(357deg);
		color: var(--cancel-stamp);
		position: absolute;
		z-index: 100;
		right: 60px;
		bottom: -32px;
		pointer-events: none;
	}

	.compact .postmark-group {
		left: 50%;
		bottom: 50%;
		transform: translate(-50%, 110%);
		--postmark-width: 165px;
	}

	.postmark-art {
		display: block;
		flex: 0 0 min(var(--postmark-width), 100%);
		width: min(var(--postmark-width), 100%);
		aspect-ratio: 164 / 94;
		color: inherit;
	}

	.postmark {
		display: block;
		width: 100%;
		height: auto;
		color: inherit;
	}

	.postmark-waves-art {
		position: absolute;
		top: 50%;
		left: calc(var(--postmark-width) - -4px);
		z-index: 2;
		width: calc(100% - var(--postmark-width) + 19px);
		height: min(42px, 56.25%);
		color: inherit;
		pointer-events: none;
		transform: translateY(-50%);
	}

	.postmark-waves {
		display: block;
		width: 100%;
		height: 100%;
		color: inherit;
	}

	.current-stamp-wrap {
		flex-shrink: 0;
		margin-left: 0;
		text-align: center;
	}

	.compact .current-stamp-wrap {
		position: absolute;
		left: 50%;
		bottom: 50%;
		transform: translate(-50%, 30%);
	}

	.current-stamp {
		--stamp-size: clamp(100px, 15vw, 150px);
		display: block;
		width: var(--stamp-size);
		padding: 0;
		margin: auto;
		border: 0;
		background: transparent;
		cursor: pointer;
		transform: rotate(7deg);
		transition: transform 0.15s;
	}

	.compact .current-stamp {
		--stamp-size: 150px;
	}

	.current-stamp:hover {
		transform: rotate(0deg);
	}

	@media (prefers-reduced-motion: reduce) {
		.current-stamp {
			transition: none;
		}
	}

	@media (max-width: 600px) {
		.postage-row.compact {
			width: 100%;
			max-width: none;
			flex-direction: row;
			position: relative;
		}

		.compact .current-stamp-wrap {
			position: relative;
			left: 100%;
			bottom: unset;
			transform: translate(calc(-100% - 1.5rem));
			top: 1.5rem;
		}

		.compact .postmark-group {
			transform: translate(-65%, 85%);
		}
	}
</style>
