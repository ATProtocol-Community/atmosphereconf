---
interface Props {
	id: string;
	title: string;
	subtitle?: string;
	as?: "h1" | "h2";
}

const { id, title, subtitle, as: Heading = "h1" } = Astro.props;
---

<header class="postcard-header">
	<p class="edition">
		AtmosphereConf #3 <span>April 29th–May 2nd, 2027 </span>
	</p>
	<div class="title-wrap">
		{
			Astro.slots.has("decoration") && (
				<span class="decoration" aria-hidden="true">
					<slot name="decoration" />
				</span>
			)
		}
		<Heading id={id} class="title">{title}</Heading>
	</div>
	{subtitle && <p class="subtitle">{subtitle}</p>}
</header>

<style>
	.postcard-header {
		min-width: 0;
		margin-bottom: var(--header-space, 26px);
	}
	.edition {
		display: flex;
		flex-wrap: wrap;
		gap: 6px 12px;
		margin: 0 0 14px;
		font-size: 11px;
		font-weight: 800;
	}
	.edition span {
		font-weight: 500;
	}
	.title-wrap {
		--decoration-size: clamp(56px, 5.5vw, 76px);
		position: relative;
		isolation: isolate;
	}
	/* Reserve a lane on the right so the title wraps before the decoration
	   instead of running under it. */
	.title-wrap:has(.decoration) {
		padding-inline-end: calc(var(--decoration-size) * 0.75);
	}
	/* Top-aligned so it never drops into the subtitle below. */
	.decoration {
		position: absolute;
		z-index: -1;
		inset-block-start: 6px;
		inset-inline-end: 0;
		rotate: 12deg;
		/* Opacity, not a translucent color, so icons thickened with a stroke
		   don't show darker seams where stroke and fill overlap. */
		color: var(--cancel-stamp);
		opacity: 0.4;
		pointer-events: none;
	}
	.decoration :global(svg) {
		display: block;
		width: var(--decoration-size);
		height: auto;
	}
	.title {
		margin: 0;
		font-family: var(--heading-font), "Avenir Next", sans-serif;
		font-size: clamp(28px, 2.8vw, 39px);
		font-weight: 700;
		line-height: 1.05;
		letter-spacing: -0.035em;
		text-transform: none;
		text-wrap: pretty;
	}
	.subtitle {
		margin: 10px 0 0;
		font-size: 14px;
		line-height: 1.4;
		text-wrap: pretty;
	}
	@media (max-width: 660px) {
		.title {
			font-size: 34px;
		}
	}
</style>
