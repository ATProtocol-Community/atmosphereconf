---
import PostcardFrame from "./PostcardFrame.astro";
import HandleInput from "./HandleInput.astro";
import PostcardHeader from "./PostcardHeader.astro";
import Tooltip from "../Tooltip.astro";
import { PUBLICATION } from "../lib/subscribe";

interface Props {
	confirmed?: boolean;
	handle?: string;
	removedStandard?: boolean;
	subscribedViaStandard?: boolean;
	newsEmail?: string;
	newsVia?: "database" | "leaflet";
	notice?: string;
	error?: string;
}

const {
	confirmed = false,
	handle = "",
	removedStandard = false,
	subscribedViaStandard = false,
	newsEmail,
	newsVia,
	notice,
	error,
} = Astro.props;
// Leaflet double-decodes this, matching the postcard's email form.
const newsAction = encodeURIComponent(
	JSON.stringify({ action: "subscribe", publication: PUBLICATION }),
);
---

<PostcardFrame
	label="AtmosphereConf 2027 RSVP postcard"
	titleId={confirmed ? "confirmation-title" : "rsvp-title"}
>
	<PostcardHeader
		id={confirmed ? "confirmation-title" : "rsvp-title"}
		title={confirmed ? "Tot dan!" : "Honk aboard!"}
		subtitle="RSVP with your Atmosphere account and win an exclusive prize: friends!"
	/>
	{
		confirmed ? (
			<div class="confirmation" data-confirmation>
				<p>We have your handle and are not afraid to use it.</p>
				{notice && (
					<p class="receipt-note" role="status">
						{notice}
					</p>
				)}
				{newsEmail && newsVia === "database" && (
					<p>
						We'll send email news to <strong>{newsEmail}</strong>.
					</p>
				)}
				{newsEmail && newsVia === "leaflet" && (
					<form
						class="inline-action news-step"
						action="https://leaflet.pub/api/auth/email-login"
						method="get"
					>
						<p>
							One more step for email news: we'll send a code to{" "}
							<strong>{newsEmail}</strong>.
						</p>
						<input type="hidden" name="email" value={newsEmail} />
						<input type="hidden" name="action" value={newsAction} />
						<input
							type="hidden"
							name="redirect"
							value="https://news.atmosphereconf.org"
						/>
						<button type="submit" class="postcard-action small-action">
							Send my code <span aria-hidden="true">↗</span>
						</button>
					</form>
				)}
				{removedStandard ? (
					<p class="receipt-note" role="status">
						Standard.site subscription removed.
					</p>
				) : subscribedViaStandard ? (
					<>
						<p>
							We also subscribed you via <strong>Standard.site</strong>, as a
							treat.
						</p>
						<form method="post" class="inline-action">
							<input type="hidden" name="handle" value={handle} />
							<input type="hidden" name="intent" value="unsubscribe" />
							<button type="submit" class="text-action">
								Remove that subscription
							</button>
						</form>
					</>
				) : (
					<>
						<p>Let us join your other Standard.site subscriptions?</p>
						<form method="post" class="inline-action">
							<input type="hidden" name="handle" value={handle} />
							<input type="hidden" name="intent" value="subscribe" />
							<button type="submit" class="postcard-action small-action">
								I’m in
							</button>
						</form>
					</>
				)}
				<a class="postcard-action invite" href="/postcard">
					Invite others <span aria-hidden="true">↗</span>
				</a>
			</div>
		) : (
			<>
				<form method="post" class="postcard-form rsvp-form" data-rsvp-form>
					{error && (
						<p class="form-error" role="alert">
							{error}
						</p>
					)}
					<label class="sr-only" for="rsvp-handle">
						Atmosphere handle
					</label>
					<HandleInput id="rsvp-handle" name="handle" value={handle} required />
					{/* The tooltip trigger sits outside the <label> so clicking it
					    doesn't toggle the checkbox; aria-label restores the full name. */}
					<div class="check-row standard-row">
						<input
							id="standard-only"
							name="standardOnly"
							type="checkbox"
							value="yes"
							aria-label="Subscribe via Standard.site"
						/>
						<span>
							<label for="standard-only">Subscribe via</label>{" "}
							<Tooltip
								id="rsvp-standard-tooltip"
								label="Standard.site"
								class="standard"
								blockAnchor="--standard-row"
								>An open format for publishing on the Atmosphere. Subscribe
								once, and our posts show up in any reader that speaks it, like{" "}
								<a href="https://leaflet.pub/reader">Leaflet</a> or{" "}
								<a href="https://pckt.blog/read">pckt</a>.</Tooltip
							>
						</span>
					</div>
					<label class="check-row" for="subscribe-news">
						<input
							id="subscribe-news"
							name="subscribeNews"
							type="checkbox"
							value="yes"
						/>
						<span>Email me news!</span>
					</label>
					<span class="news-note">
						We’ll use the email associated with your Atmosphere account—that's
						the one you signed up with!{" "}
						<button
							class="change-email"
							type="button"
							data-change-email
							aria-controls="newsletter-options"
							aria-expanded="false"
						>
							change me
						</button>
					</span>
					<div id="newsletter-options" class="newsletter-options" hidden>
						<label class="postcard-label" for="alternate-email">
							Send to this other email:
						</label>
						<input
							class="postcard-field"
							id="alternate-email"
							name="alternateEmail"
							type="email"
							autocomplete="email"
						/>
					</div>
					<input type="hidden" name="intent" value="confirm" />
					<button class="postcard-action" type="submit">
						Count me in! <span aria-hidden="true">↗</span>
					</button>
					<a class="postcard-action secondary" href="/postcard">
						Invite your friends <span aria-hidden="true">→</span>
					</a>
				</form>
			</>
		)
	}

	<Fragment slot="footer">
		<a href="/" data-no-flip>← Back to the postcard</a>
		<span>See you out there. <span aria-hidden="true">♡</span></span>
	</Fragment>
</PostcardFrame>

<script>
	for (const form of document.querySelectorAll<HTMLFormElement>("[data-rsvp-form]")) {
		const newsCheckbox =
			form.querySelector<HTMLInputElement>("#subscribe-news");
		const changeEmailButton = form.querySelector<HTMLButtonElement>(
			"[data-change-email]",
		);
		const newsletterOptions =
			form.querySelector<HTMLElement>("#newsletter-options");
		const alternateEmail =
			form.querySelector<HTMLInputElement>("#alternate-email");
		const newsletterFields = Array.from(
			form.querySelectorAll<HTMLInputElement>(".newsletter-options input"),
		);
		const syncNewsletterFields = () => {
			const wantsNews = newsCheckbox?.checked ?? false;
			const changeRequested =
				changeEmailButton?.getAttribute("aria-expanded") === "true";
			const showNewsletterOptions = wantsNews && changeRequested;

			if (newsletterOptions) newsletterOptions.hidden = !showNewsletterOptions;
			for (const field of newsletterFields) {
				field.disabled = !showNewsletterOptions;
			}
		};
		newsCheckbox?.addEventListener("change", () => {
			if (!newsCheckbox.checked && changeEmailButton) {
				changeEmailButton.setAttribute("aria-expanded", "false");
			}
			syncNewsletterFields();
		});
		changeEmailButton?.addEventListener("click", () => {
			if (newsCheckbox) newsCheckbox.checked = true;
			changeEmailButton.setAttribute("aria-expanded", "true");
			syncNewsletterFields();
			alternateEmail?.focus();
		});
		syncNewsletterFields();
	}
</script>

<style>
	.check-row {
		display: flex;
		align-items: center;
		gap: 9px;
		font-family: var(--label-font), "Avenir Next", sans-serif;
		font-size: 15px;
		font-weight: 700;
		cursor: pointer;
	}
	.standard-row {
		anchor-name: --standard-row;
	}
	/* The trigger is rendered by <Tooltip>, so it carries that component's
	   scope; the scoped `.standard-row` still confines this to us. */
	.standard-row:has(input:checked) :global(.tooltip-button.standard) {
		color: var(--cancel-stamp);
	}
	.standard-row label {
		cursor: pointer;
	}
	.standard-row :global(.tooltip a) {
		color: inherit;
		font-weight: 800;
		text-underline-offset: 2px;
	}
	.check-row input {
		width: 19px;
		height: 19px;
		margin: 0;
		accent-color: var(--strong);
	}
	.news-note {
		margin: -4px 0 0 28px;
		font-size: 11px;
		line-height: 1.35;
	}
	.change-email {
		padding: 0;
		border: 0;
		background: transparent;
		color: var(--strong);
		font: inherit;
		font-weight: 800;
		text-decoration: underline;
		text-underline-offset: 3px;
		cursor: pointer;
	}
	.newsletter-options {
		display: none;
		gap: 6px;
		padding: 12px;
		border: 1px dashed color-mix(in srgb, var(--ink) 55%, transparent);
		border-radius: 12px;
		background: color-mix(in srgb, var(--mint) 25%, transparent);
	}
	.rsvp-form:has(#subscribe-news:checked) .newsletter-options:not([hidden]) {
		display: grid;
	}
	.confirmation {
		display: grid;
		gap: 10px;
	}
	.confirmation p {
		margin: 0;
		font-size: 14px;
		line-height: 1.4;
	}
	.inline-action {
		margin: 0;
	}
	.news-step {
		display: grid;
		justify-items: start;
		gap: 8px;
	}
	.confirmation strong,
	.form-error {
		overflow-wrap: anywhere;
	}
	.form-error {
		margin: 0;
		font-size: 13px;
		font-weight: 800;
		line-height: 1.4;
	}
	.small-action {
		display: inline-flex;
		min-height: 40px;
		padding-block: 8px;
		padding-inline: 18px;
		background: var(--mint);
		color: var(--ink);
	}
	.text-action {
		padding: 0;
		border: 0;
		background: transparent;
		color: var(--strong);
		font-size: 12px;
		font-weight: 800;
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.invite {
		margin-top: 16px;
	}
	@media (max-width: 660px) {
		.newsletter-options {
			padding: 10px;
		}
	}
</style>
