---
import goose from "./goose.png";
import GooseSvg from "./goose.svg";
import hummingbird from "./hummingbird.png";
import StampCollection from "./stamps/StampCollection.astro";
import PostcardForm from "./PostcardForm.astro";
---

<article class="mail" id="postcard" aria-label="A postcard from AtmosphereConf">
	<section class="picture" aria-labelledby="headline">
		<p class="air-label">The 100% unofficial gathering of atmospherizens</p>
		<div class="goose-route" aria-hidden="true">
			<!-- Old goose (png) is included here -->
			<img
				class="goose"
				id="goose-img"
				data-images={JSON.stringify({
					default: goose.src,
					colibri: hummingbird.src,
				})}
				src={goose.src}
				alt=""
				width="725"
				height="681"
			/>

			<GooseSvg />
		</div>
		<div class="grass">
			{
				Array.from({ length: 36 }, () => (
					<div class="grass-blade" aria-hidden="true" />
				))
			}
		</div>
		<h1 id="headline">
			<span class="headline-word">Back</span>
			<span class="last-line"
				><span class="headline-word headline-at">At</span>
				<span class="headline-word">It<span class="period">.</span></span></span
			>
		</h1>
		<div class="destination">
			<span>Arriving soon</span>
			<div>
				Somewhere<br />in Europe <span class="online">(and online)</span>
				<span class="destination-arrow" aria-hidden="true">
					<svg
						width="24"
						height="24"
						viewBox="0 0 24 24"
						xmlns="http://www.w3.org/2000/svg"
						><path
							fill="currentColor"
							d="m10.775 10.4l-6.25-2.7q-.6-.275-.737-.888t.337-1.087l.4-.4q.2-.2.488-.3t.587-.05l9 1.6l3.1-3.125q.575-.575 1.413-.575t1.412.575t.575 1.413t-.575 1.412l-3.1 3.125L19 18.375q.05.3-.038.6t-.287.5l-.4.375q-.475.475-1.1.35t-.9-.725l-2.675-6.25l-2.55 2.525l.55 3.1q.05.25-.025.488t-.25.412l-.425.425q-.35.35-.862.275t-.763-.525L7.45 16.55l-3.375-1.825q-.45-.25-.525-.762t.275-.863l.425-.425q.175-.175.413-.25t.487-.025l3.075.525z"
						></path></svg
					>
				</span>
			</div>
		</div>
	</section>

	<section class="address" aria-labelledby="signup-title">
		<StampCollection />

		<div class="message">
			<p class="edition">AtmosphereConf #3 <span>Spring 2027</span></p>
			<h2 id="signup-title">Where will <span>we</span> land?</h2>
			<PostcardForm />
		</div>
		<footer class="signoff">
			<span>See you out there. <span aria-hidden="true">♡</span></span>
			<nav aria-label="AtmosphereConf links">
				<a href="https://bsky.app/profile/did:plc:3xewinw4wtimo2lqfy5fm5sw"
					>Bluesky</a
				>
				<a href="https://news.atmosphereconf.org/">Leaflet</a>
			</nav>
		</footer>
	</section>
</article>

<script>
	// Sample size for non-perfect-circle moments
	const ARC_SAMPLES = 720;

	function buildArcTable(rx: number, ry: number) {
		const lengths = new Float64Array(ARC_SAMPLES + 1);
		const dt = (Math.PI * 2) / ARC_SAMPLES;
		let prevX = 0;
		let prevY = ry;

		for (let i = 1; i <= ARC_SAMPLES; i++) {
			const t = i * dt;
			const x = rx * Math.sin(t);
			const y = ry * Math.cos(t);
			lengths[i] = lengths[i - 1] + Math.hypot(x - prevX, y - prevY);
			prevX = x;
			prevY = y;
		}

		return lengths;
	}

	function tAtLength(lengths: Float64Array, target: number) {
		let lo = 0;
		let hi = lengths.length - 1;

		while (lo < hi) {
			const mid = (lo + hi) >> 1;
			if (lengths[mid] < target) lo = mid + 1;
			else hi = mid;
		}

		if (lo === 0) return 0;

		const a = lengths[lo - 1];
		const b = lengths[lo];
		const frac = b > a ? (target - a) / (b - a) : 0;

		return ((lo - 1 + frac) * Math.PI * 2) / ARC_SAMPLES;
	}

	function initGrassBlades() {
		const earth = document.querySelector<HTMLDivElement>(".grass")!;
		if (!earth) return;

		const blades = Array.from(
			earth.querySelectorAll<HTMLDivElement>(".grass-blade"),
		);
		if (blades.length === 0) return;

		function layout() {
			// Reset
			for (const blade of blades) {
				blade.style.left = "";
				blade.style.top = "";
				blade.style.transform = "";
			}

			// Recalc
			const cx = earth.clientWidth / 2;
			const cy = earth.clientHeight / 2;
			const rx = cx;
			const ry = cy;

			if (rx === 0 || ry === 0) return;

			const natural = blades.map((blade) => ({
				x: blade.offsetLeft,
				y: blade.offsetTop,
				w: blade.offsetWidth,
				h: blade.offsetHeight,
			}));

			const arc = buildArcTable(rx, ry);
			const perimeter = arc[ARC_SAMPLES];

			// Recycle (how'd that comment joke even work lmao)
			blades.forEach((blade, idx) => {
				const t = tAtLength(arc, (idx / blades.length) * perimeter);
				const { x, y, w, h } = natural[idx];

				const px = cx + rx * Math.sin(t) - w / 2;
				const py = cy + ry * Math.cos(t) - h / 2;

				const deg =
					(Math.atan2(-Math.sin(t) / rx, Math.cos(t) / ry) * 180) / Math.PI;

				blade.style.left = `${px - x}px`;
				blade.style.top = `${py - y}px`;
				blade.style.transform = `rotate(${deg}deg)`;
				blade.style.opacity = "1";
			});
		}

		// Please no spam browser ty :D
		let frame = 0;
		const observer = new ResizeObserver(() => {
			cancelAnimationFrame(frame);
			frame = requestAnimationFrame(layout);
		});

		observer.observe(earth);

		return () => {
			cancelAnimationFrame(frame);
			observer.disconnect();
		};
	}

	let teardownGrass: (() => void) | void;

	function startGrass() {
		teardownGrass?.();
		teardownGrass = initGrassBlades();
	}

	function stopGrass() {
		teardownGrass?.();
		teardownGrass = undefined;
	}

	startGrass();
</script>
<script src="./goose-anim.ts"></script>
<style>
	.mail {
		display: grid;
		grid-template-columns: 1.35fr 1fr;
		aspect-ratio: 3 / 2;
		width: min(1080px, 100%);
		border: 12px solid var(--paper);
		border-radius: 3px;
		margin-bottom: 4rem;
		background: transparent;
		box-shadow: 12px 14px 6px color-mix(in srgb, var(--ink) 25%, transparent);
		position: relative;
	}

	#goose-svg {
		rotate: 10deg;
	}

	.mail::after {
		content: "";
		position: absolute;
		inset: -12px;
		z-index: 1;
		border-radius: 3px;
		background: url("/noise.svg") repeat;
		background-size: 180px 180px;
		pointer-events: none;
		opacity: 0.35;
	}

	.picture {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		min-height: 650px;
		padding: 36px;
		color: var(--strong);
	}

	.grass {
		position: absolute;
		top: 73%;
		left: -50%;
		z-index: -2;
		width: 200%;
		aspect-ratio: 1 / 1;
		background: var(--mint);
		border-radius: 50%;
		animation: revolve 70s linear infinite;
	}

	@keyframes revolve {
		from {
			rotate: 0deg;
		}
		to {
			rotate: 360deg;
		}
	}

	.grass-blade {
		display: none;
		width: 4px;
		height: 24px;
		border-radius: 9px;
		background: color-mix(in srgb, var(--mint) 75%, black);
		position: relative;
		opacity: 0;
		transform-origin: center center;
	}

	.grass-blade::after {
		content: "";
		position: absolute;
		width: 4px;
		height: 12px;
		border-radius: 9px;
		background: color-mix(in srgb, var(--mint) 75%, black);
		transform-origin: center center;
		rotate: 45deg;
		top: 8px;
		right: 4px;
	}

	.air-label {
		position: relative;
		z-index: 2;
		margin: 0;
		font-family: var(--label-font), "Avenir Next", sans-serif;
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	h1 {
		position: relative;
		z-index: 2;
		margin: 25px 0 120px -7px;
		font-family: var(--heading-font), "Avenir Next", sans-serif;
		font-size: clamp(72px, 11.2vw, 148px);
		font-weight: 750;
		letter-spacing: -0.04em;
		line-height: 0.98;
	}

	h1 > span {
		display: block;
	}

	.headline-word {
		margin-right: 15px;
	}

	.headline-at {
		display: inline-block;
		padding: 0.03em 0.14em 0.1em;
		margin: -0.03em -0.02em 0 0;
		border-radius: 0.15em 0.42em 0.2em 0.32em;
		color: var(--butter);
		font-family: var(--heading-font), "Avenir Next", sans-serif;
		font-weight: 800;
		letter-spacing: -0.04em;
		line-height: 0.88;
		-webkit-text-stroke: 5px var(--strong);
		paint-order: stroke fill;
		transform: rotate(-3deg);
	}

	.destination {
		position: absolute;
		bottom: 5px;
		left: 20px;
		z-index: 2;
		display: flex;
		flex-direction: column;
		width: max-content;
		max-width: calc(100% - 40px);
		padding: 12px 12px;
		margin: 0;
		/* background: var(--mint); */
		border-radius: 8px;
		font-size: 45px;
	}

	.destination > span:first-child {
		grid-column: 1 / -1;
		font-family: var(--label-font), "Avenir Next", sans-serif;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		margin-bottom: 2px;
	}

	#signup-title {
		text-wrap: pretty;
	}
	#signup-title span {
		/* color: var(--butter); */
	}

	.destination div {
		color: var(--ink);
		letter-spacing: -1px;
		position: relative;
		font-weight: 700;
		line-height: 0.9;
	}

	.destination .online {
		font-size: 0.84rem;
		letter-spacing: -0.4px;
	}

	.destination-arrow {
		color: var(--ink);
		padding-top: 3px;
		line-height: 1;
		position: absolute;
		top: 0;
		right: 0;
	}

	.goose-route {
		position: absolute;
		right: 5%;
		bottom: 15%;
		z-index: -1;
		width: 170px;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.goose {
		display: block;
		width: 100%;
		height: auto;
		transform-origin: 50% 90%;
		animation: stride 0.65s ease-in-out infinite alternate;
	}

	@keyframes stride {
		from {
			transform: rotate(-5deg) translateY(0);
		}
		to {
			transform: rotate(4deg) translateY(-9px);
		}
	}

	.address {
		background: var(--paper);
		display: flex;
		min-width: 0;
		flex-direction: column;
		padding: 30px clamp(24px, 3.3vw, 48px) 10px;
	}

	.message {
		margin-top: auto;
		padding-top: 38px;
	}

	.edition {
		display: flex;
		flex-wrap: wrap;
		gap: 6px 12px;
		margin: 0 0 14px;
		font-size: 11px;
		font-weight: 800;
	}

	.edition span {
		font-weight: 500;
	}

	h2 {
		margin: 0 0 26px;
		font-family: var(--heading-font), "Avenir Next", sans-serif;
		font-size: clamp(28px, 2.8vw, 39px);
		font-weight: 700;
		line-height: 1.05;
		letter-spacing: -0.035em;
	}

	.signoff {
		display: flex;
		justify-content: space-between;
		margin: 24px 0 0;
		font-size: 11px;
	}

	.signoff nav {
		display: flex;
		gap: 12px;
	}

	@media (min-width: 1500px) {
		.picture {
			min-height: 740px;
		}

		h1 {
			margin-bottom: 160px;
		}
	}

	@media (max-width: 900px) {
		.mail {
			grid-template-columns: 1fr 1fr;
			border-width: 8px;
		}

		.picture {
			min-height: 600px;
			padding: 28px 20px;
		}

		h1 {
			margin-top: 64px;
			margin-bottom: 155px;
			font-size: 9.6vw;
		}

		.address {
			padding-inline: 22px;
		}

		.grass {
			top: 55%;
		}

		.goose-route {
			right: 8%;
			top: 45%;
		}
	}

	@media (max-width: 650px) {
		.mail {
			grid-template-columns: 1fr;
		}

		.picture {
			min-height: 600px;
			padding: 28px 24px;
		}

		.air-label {
			font-size: 10px;
			letter-spacing: 1.5px;
		}

		h1 {
			margin: 39px 0 115px -5px;
			font-size: clamp(76px, 18vw, 114px);
		}

		.goose-route {
			right: 8%;
			bottom: 185px;
		}

		.destination strong {
			font-size: 22px;
		}

		.destination .online {
			display: block;
		}

		.address {
			padding: 28px 24px;
		}

		.message {
			padding-top: 30px;
		}

		h2 {
			font-size: 34px;
		}

		.destination-arrow {
			left: calc(100% + 4px);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.goose {
			animation: none;
		}
	}
</style>
