---
import goose from "./goose.png";
import hummingbird from "./hummingbird.png";
import StampCollection from "./stamps/StampCollection.astro";
---

<article class="mail" id="postcard" aria-label="A postcard from AtmosphereConf">
	<section class="picture" aria-labelledby="headline">
		<p class="air-label">The 100% unofficial gathering of atmospherizens</p>
		<div class="goose-route" aria-hidden="true">
			<img
				class="goose"
				id="goose-img"
				data-images={JSON.stringify({
					default: goose.src,
					colibri: hummingbird.src,
				})}
				src={goose.src}
				alt=""
				width="725"
				height="681"
			/>
		</div>
		<div class="grass">
			{
				Array.from({ length: 36 }, () => (
					<div class="grass-blade" aria-hidden="true" />
				))
			}
		</div>
		<h1 id="headline">
			<span class="headline-word">Back</span>
			<span class="last-line"
				><span class="headline-word headline-at">At</span>
				<span class="headline-word">It<span class="period">.</span></span></span
			>
		</h1>
		<div class="destination">
			<span>Next stop</span>
			<strong
				>Somewhere<br />in Europe <span class="online">(and online)</span
				></strong
			>
			<span class="destination-arrow" aria-hidden="true">↗</span>
		</div>
	</section>

	<section class="address" aria-labelledby="signup-title">
		<StampCollection />

		<div class="message">
			<p class="edition">AtmosphereConf #3 <span>Spring 2027</span></p>
			<h2 id="signup-title">Where will <span>we</span> land?</h2>
			<form action="https://leaflet.pub/api/auth/email-login" method="get">
				<label for="airmail-email">Your email address</label>
				<input
					id="airmail-email"
					name="email"
					type="email"
					placeholder="you@example.com"
					autocomplete="email"
					required
				/>
				<button class="subscribe" type="submit"
					>Keep me posted <span aria-hidden="true">↗</span></button
				>
				<input
					type="hidden"
					name="action"
					value="%7B%22action%22%3A%22subscribe%22%2C%22publication%22%3A%22at%3A%2F%2Fdid%3Aplc%3Alehcqqkwzcwvjvw66uthu5oq%2Fsite.standard.publication%2F3m367bemk3c2i%22%7D"
				/>
				<input
					type="hidden"
					name="redirect"
					value="https://news.atmosphereconf.org"
				/>
			</form>
		</div>
		<p class="signoff">
			See you out there. <span aria-hidden="true">♡</span>
		</p>
	</section>
</article>

<script>
	// Sample size for non-perfect-circle moments
	const ARC_SAMPLES = 720;

	function buildArcTable(rx: number, ry: number) {
		const lengths = new Float64Array(ARC_SAMPLES + 1);
		const dt = (Math.PI * 2) / ARC_SAMPLES;
		let prevX = 0;
		let prevY = ry;

		for (let i = 1; i <= ARC_SAMPLES; i++) {
			const t = i * dt;
			const x = rx * Math.sin(t);
			const y = ry * Math.cos(t);
			lengths[i] = lengths[i - 1] + Math.hypot(x - prevX, y - prevY);
			prevX = x;
			prevY = y;
		}

		return lengths;
	}

	function tAtLength(lengths: Float64Array, target: number) {
		let lo = 0;
		let hi = lengths.length - 1;

		while (lo < hi) {
			const mid = (lo + hi) >> 1;
			if (lengths[mid] < target) lo = mid + 1;
			else hi = mid;
		}

		if (lo === 0) return 0;

		const a = lengths[lo - 1];
		const b = lengths[lo];
		const frac = b > a ? (target - a) / (b - a) : 0;

		return ((lo - 1 + frac) * Math.PI * 2) / ARC_SAMPLES;
	}

	function initGrassBlades() {
		const earth = document.querySelector<HTMLDivElement>(".grass")!;
		if (!earth) return;

		const blades = Array.from(
			earth.querySelectorAll<HTMLDivElement>(".grass-blade"),
		);
		if (blades.length === 0) return;

		function layout() {
			// Reset
			for (const blade of blades) {
				blade.style.left = "";
				blade.style.top = "";
				blade.style.transform = "";
			}

			// Recalc
			const cx = earth.clientWidth / 2;
			const cy = earth.clientHeight / 2;
			const rx = cx;
			const ry = cy;

			if (rx === 0 || ry === 0) return;

			const natural = blades.map((blade) => ({
				x: blade.offsetLeft,
				y: blade.offsetTop,
				w: blade.offsetWidth,
				h: blade.offsetHeight,
			}));

			const arc = buildArcTable(rx, ry);
			const perimeter = arc[ARC_SAMPLES];

			// Recycle (how'd that comment joke even work lmao)
			blades.forEach((blade, idx) => {
				const t = tAtLength(arc, (idx / blades.length) * perimeter);
				const { x, y, w, h } = natural[idx];

				const px = cx + rx * Math.sin(t) - w / 2;
				const py = cy + ry * Math.cos(t) - h / 2;

				const deg =
					(Math.atan2(-Math.sin(t) / rx, Math.cos(t) / ry) * 180) / Math.PI;

				blade.style.left = `${px - x}px`;
				blade.style.top = `${py - y}px`;
				blade.style.transform = `rotate(${deg}deg)`;
				blade.style.opacity = "1";
			});
		}

		// Please no spam browser ty :D
		let frame = 0;
		const observer = new ResizeObserver(() => {
			cancelAnimationFrame(frame);
			frame = requestAnimationFrame(layout);
		});

		observer.observe(earth);

		return () => {
			cancelAnimationFrame(frame);
			observer.disconnect();
		};
	}

	let teardownGrass: (() => void) | void;

	function startGrass() {
		teardownGrass?.();
		teardownGrass = initGrassBlades();
	}

	function stopGrass() {
		teardownGrass?.();
		teardownGrass = undefined;
	}

	startGrass();
</script>
<style>
	.mail {
		display: grid;
		grid-template-columns: 1.35fr 1fr;
		aspect-ratio: 3 / 2;
		width: min(1080px, 100%);
		border: 12px solid var(--paper);
		border-radius: 3px;
		margin-bottom: 4rem;
		background: transparent;
		box-shadow: 12px 14px 6px color-mix(in srgb, var(--ink) 25%, transparent);
		position: relative;
	}

	.mail::after {
		content: "";
		position: absolute;
		inset: -12px;
		z-index: 1;
		border-radius: 3px;
		background: url("/noise.svg") repeat;
		background-size: 180px 180px;
		pointer-events: none;
		opacity: 0.35;
	}

	.picture {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		min-height: 650px;
		padding: 36px;
		color: var(--strong);
	}

	.grass {
		position: absolute;
		top: 75%;
		left: -50%;
		z-index: -2;
		width: 200%;
		aspect-ratio: 1 / 1;
		background: var(--mint);
		border-radius: 50%;
		animation: revolve 70s linear infinite;
	}

	@keyframes revolve {
		from {
			rotate: 0deg;
		}
		to {
			rotate: 360deg;
		}
	}

	.grass-blade {
		width: 4px;
		height: 24px;
		border-radius: 9px;
		background: color-mix(in srgb, var(--mint) 75%, black);
		position: relative;
		opacity: 0;
		transform-origin: center center;
	}

	.grass-blade::after {
		content: "";
		position: absolute;
		width: 4px;
		height: 12px;
		border-radius: 9px;
		background: color-mix(in srgb, var(--mint) 75%, black);
		transform-origin: center center;
		rotate: 45deg;
		top: 8px;
		right: 4px;
	}

	.air-label {
		position: relative;
		z-index: 2;
		margin: 0;
		font-family: var(--label-font), "Avenir Next", sans-serif;
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	h1 {
		position: relative;
		z-index: 2;
		margin: 38px 0 120px -7px;
		font-family: var(--heading-font), "Avenir Next", sans-serif;
		font-size: clamp(72px, 10.2vw, 148px);
		font-weight: 750;
		letter-spacing: -0.04em;
		line-height: 0.98;
	}

	h1 > span {
		display: block;
	}

	.headline-word {
		margin-right: 15px;
	}

	.headline-at {
		display: inline-block;
		padding: 0.03em 0.14em 0.1em;
		margin: -0.03em -0.02em 0 0;
		border-radius: 0.15em 0.42em 0.2em 0.32em;
		color: var(--butter);
		font-family: var(--heading-font), "Avenir Next", sans-serif;
		font-weight: 800;
		letter-spacing: -0.04em;
		line-height: 0.88;
		/* text-shadow:
			-2px -2px 1px var(--strong),
			2px -2px 1px var(--strong),
			-2px 2px 1px var(--strong),
			2px 2px 1px var(--strong),
			0 -2px 1px var(--strong),
			0 2px 1px var(--strong),
			-2px 0 1px var(--strong),
			2px 0 1px var(--strong); */
		transform: rotate(-3deg);
	}

	.destination {
		position: absolute;
		bottom: clamp(25px, 3vw, 75px);
		left: clamp(20px, 3.3vw, 36px);
		z-index: 2;
		display: grid;
		grid-template-columns: 1fr auto;
		width: max-content;
		max-width: calc(100% - 40px);
		gap: 6px 24px;
		padding: 10px 12px;
		margin: 0;
		background: var(--mint);
		border-radius: 8px;
	}

	.destination > span:first-child {
		grid-column: 1 / -1;
		font-family: var(--label-font), "Avenir Next", sans-serif;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	#signup-title {
		text-wrap: pretty;
	}
	#signup-title span {
		/* color: var(--butter); */
	}

	.destination strong {
		color: var(--ink);
		font-size: 25px;
		line-height: 1.1;
		letter-spacing: -1px;
	}

	.destination .online {
		font-size: 0.72em;
		letter-spacing: -0.4px;
	}

	.destination-arrow {
		color: var(--ink);
		font-size: 45px;
		line-height: 1;
	}

	.goose-route {
		position: absolute;
		right: 5%;
		bottom: 15%;
		z-index: -1;
		width: 170px;
	}

	.goose {
		display: block;
		width: 100%;
		height: auto;
		transform-origin: 50% 90%;
		animation: stride 0.65s ease-in-out infinite alternate;
	}

	@keyframes stride {
		from {
			transform: rotate(-5deg) translateY(0);
		}
		to {
			transform: rotate(4deg) translateY(-9px);
		}
	}

	.address {
		background: var(--paper);
		display: flex;
		min-width: 0;
		flex-direction: column;
		padding: 30px clamp(24px, 3.3vw, 48px) 24px;
	}

	.message {
		margin-top: auto;
		padding-top: 38px;
	}

	.edition {
		display: flex;
		flex-wrap: wrap;
		gap: 6px 12px;
		margin: 0 0 14px;
		font-size: 11px;
		font-weight: 800;
	}

	.edition span {
		font-weight: 500;
	}

	h2 {
		margin: 0 0 26px;
		font-family: var(--heading-font), "Avenir Next", sans-serif;
		font-size: clamp(28px, 2.8vw, 39px);
		font-weight: 700;
		line-height: 1.05;
		letter-spacing: -0.035em;
	}

	form {
		display: grid;
		gap: 9px;
	}

	label {
		font-size: 11px;
		font-weight: 700;
	}

	input[type="email"] {
		width: 100%;
		min-width: 0;
		min-height: 50px;
		padding: 12px;
		border: 1px solid var(--ink);
		border-radius: 3px;
		background: transparent;
		color: var(--ink);
		font-size: 16px;
	}

	input::placeholder {
		color: var(--ink);
		opacity: 0.65;
	}

	.subscribe {
		display: flex;
		align-items: center;
		justify-content: space-between;
		min-height: 50px;
		padding: 12px 16px;
		border: 0;
		border-radius: 3px;
		background: var(--strong);
		color: var(--paper);
		font-size: 14px;
		font-weight: 750;
	}

	.subscribe span {
		font-size: 24px;
	}

	.signoff {
		display: flex;
		justify-content: space-between;
		margin: 24px 0 0;
		font-size: 11px;
	}

	@media (min-width: 1500px) {
		.picture {
			min-height: 740px;
		}

		h1 {
			margin-bottom: 160px;
		}
	}

	@media (max-width: 900px) {
		.mail {
			grid-template-columns: 1fr 1fr;
			border-width: 8px;
		}

		.picture {
			min-height: 600px;
			padding: 28px 20px;
		}

		h1 {
			margin-top: 64px;
			margin-bottom: 155px;
			font-size: 9.6vw;
		}

		.address {
			padding-inline: 22px;
		}

		.grass {
			top: 55%;
		}

		.goose-route {
			right: 8%;
			top: 45%;
		}
	}

	@media (max-width: 650px) {
		.mail {
			grid-template-columns: 1fr;
		}

		.picture {
			min-height: 600px;
			padding: 28px 24px;
		}

		.air-label {
			font-size: 10px;
			letter-spacing: 1.5px;
		}

		h1 {
			margin: 39px 0 115px -5px;
			font-size: clamp(76px, 18vw, 114px);
		}

		.goose-route {
			right: 8%;
			bottom: 185px;
		}

		.destination strong {
			font-size: 22px;
		}

		.destination .online {
			display: block;
		}

		.address {
			padding: 28px 24px;
		}

		.message {
			padding-top: 30px;
		}

		h2 {
			font-size: 34px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.goose {
			animation: none;
		}
	}
</style>
