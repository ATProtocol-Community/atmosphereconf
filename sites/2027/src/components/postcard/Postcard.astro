---
import StampCollection from "./stamps/StampCollection.astro";
import PostcardForm from "./PostcardForm.astro";
import PostcardPicture from "./PostcardPicture.astro";
---

<article class="mail" id="postcard" aria-label="A postcard from AtmosphereConf">
	<PostcardPicture />

	<section class="address" aria-labelledby="signup-title">
		<StampCollection />

		<div class="message">
			<p class="edition">AtmosphereConf #3 <span>Spring 2027</span></p>
			<h2 id="signup-title">Where will <span>we</span> land?</h2>
			<PostcardForm />
		</div>
		<footer class="signoff">
			<span>See you out there. <span aria-hidden="true">♡</span></span>
			<nav aria-label="AtmosphereConf links">
				<a href="https://bsky.app/profile/did:plc:3xewinw4wtimo2lqfy5fm5sw"
					>Bluesky</a
				>
				<a href="https://news.atmosphereconf.org/">Leaflet</a>
			</nav>
		</footer>
	</section>
</article>

<style>
	.mail {
		display: grid;
		grid-template-columns: 1.15fr 1fr;
		aspect-ratio: 3 / 2;
		width: min(1080px, 100%, calc((100dvh - 116px) * 1.5));
		border: 12px solid var(--paper);
		border-radius: 3px;
		background: transparent;
		box-shadow: 12px 14px 6px color-mix(in srgb, var(--ink) 25%, transparent);
		position: relative;
	}

	.mail::after {
		content: "";
		position: absolute;
		inset: -12px;
		z-index: 1;
		border-radius: 3px;
		background: url("/noise.svg") repeat;
		background-size: 180px 180px;
		pointer-events: none;
		opacity: 0.35;
	}

	#signup-title {
		text-wrap: pretty;
	}
	#signup-title span {
		/* color: var(--butter); */
	}

	.address {
		background: var(--paper);
		box-shadow: 1px 0 0 var(--paper);
		display: flex;
		min-width: 0;
		flex-direction: column;
		padding: 30px clamp(24px, 3.3vw, 48px) 10px;
	}

	.message {
		margin-top: auto;
		padding-top: 38px;
	}

	.edition {
		display: flex;
		flex-wrap: wrap;
		gap: 6px 12px;
		margin: 0 0 14px;
		font-size: 11px;
		font-weight: 800;
	}

	.edition span {
		font-weight: 500;
	}

	h2 {
		margin: 0 0 26px;
		font-family: var(--heading-font), "Avenir Next", sans-serif;
		font-size: clamp(28px, 2.8vw, 39px);
		font-weight: 700;
		line-height: 1.05;
		letter-spacing: -0.035em;
	}

	.signoff {
		display: flex;
		justify-content: space-between;
		margin: 24px 0 0;
		font-size: 11px;
	}

	.signoff nav {
		display: flex;
		gap: 12px;
	}

	@media (max-width: 900px) {
		.mail {
			border-width: 8px;
		}

		.mail::after {
			inset: -8px;
		}
	}

	@media (max-width: 660px) {
		.mail {
			grid-template-columns: 1fr;
			grid-template-rows: auto auto;
			aspect-ratio: auto;
			width: calc(100%);
			box-shadow: 6px 9px 6px color-mix(in srgb, var(--ink) 25%, transparent);
			margin-left: -5px;
			height: auto;
		}

		.address {
			padding: 28px 24px;
		}

		.message {
			padding-top: 30px;
		}

		h2 {
			font-size: 34px;
		}
	}
</style>
