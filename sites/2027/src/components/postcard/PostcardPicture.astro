---
import GooseSvg from "./goose.svg";
import D20Logo from "./d20-favicon.svg";
import PronounsGoose from "./PronounsGoose.astro";
import hummingbird from "./hummingbird.png";
import { cloudShapes } from "../lib/cloud-shapes";
import PaperPlane from "./paper-plane.svg";

interface Props {
	/** The goose's waffle shines like the sun. */
	sunny?: boolean;
}

const { sunny = false } = Astro.props;

// Live actor.rpg.sprite blob for @goose.art on rpg.actor (3 cols x 4 rows,
// 48px frames). CID-addressed, so this URL never goes stale.
const RPG_ACTOR_SPRITE_URL =
	"https://selfhosted.social/xrpc/com.atproto.sync.getBlob?did=did:plc:hsqwcidfez66lwm3gxhfv5in&cid=bafkreidohkm2byu7ynzhrc6vpljtv4vpv2vmvje4av55zft5adzjhfv4xa";

// Scaled down to drift inside the postcard's own clipped scene, instead of
// only around its edges like the page-wide sky's clouds.
const postcardClouds = [
	{ shape: 0, width: 36, top: "14%", duration: 32, delay: 4 },
	{ shape: 1, width: 30, top: "42%", duration: 40, delay: 18 },
	{ shape: 0, width: 24, top: "6%", duration: 26, delay: 10 },
];
---

<section class="picture" aria-labelledby="headline">
	<div class="postcard-clouds" aria-hidden="true">
		{
			postcardClouds.map((cloud) => (
				<svg
					class="postcard-cloud"
					viewBox="0 0 190 105"
					style={`--cloud-top: ${cloud.top}; --cloud-width: ${cloud.width}cqw; --cloud-duration: ${cloud.duration}s; --cloud-delay: -${cloud.delay}s;`}
				>
					<path d={cloudShapes[cloud.shape]} />
				</svg>
			))
		}
	</div>
	<div class="picture-layout">
		<p class="air-label">The 100% unofficial gathering of atmospherizens</p>
		<div class="goose-route" aria-hidden="true">
			<!-- Colibri's hummingbird has no SVG version, so it's a plain image. -->
			<img
				class="goose"
				id="goose-img"
				data-images={JSON.stringify({ colibri: hummingbird.src })}
				src={hummingbird.src}
				alt=""
				width={hummingbird.width}
				height={hummingbird.height}
			/>

			<!-- rpg-actor: a live actor.rpg.sprite frame for @goose.art, stepped
			     the same way every sprite walks on rpg.actor (3x4 sheet, row/col
			     background-position, steps() timing). CID-addressed, so it's stable. -->
			<div
				class="goose rpg-actor-sprite"
				id="rpg-actor-goose"
				style={`background-image:url(${RPG_ACTOR_SPRITE_URL})`}
			></div>

			<GooseSvg data-shiny={sunny || undefined} />
			<PronounsGoose />
		</div>
		<div class="grass"></div>
		<svg
			class="distant-windmill"
			viewBox="0 0 80 100"
			aria-hidden="true"
			focusable="false"
		>
			<path class="windmill-tower" d="M27 58h26l8 42H19z"></path>
			<path class="windmill-roof" d="m23 60 17-18 17 18z"></path>
			<g transform="translate(40 56)">
				<g class="windmill-sails">
					<path d="M0-37V37M-37 0h74"></path>
					<path d="M0-37h8v23H0zm14 37v8h23V0zM0 14h-8v23h8zm-14-14v-8h-23v8z"
					></path>
				</g>
			</g>
			<circle class="windmill-detail" cx="40" cy="56" r="3"></circle>
		</svg>
		<h1 id="headline">
			<span class="headline-word">Back</span>
			<span class="last-line"
				><span class="headline-word headline-at">At</span>
				<span class="headline-word"
					>It<span class="period">.</span><D20Logo
						class="period-logo"
						aria-hidden="true"
					/></span></span
			>
		</h1>
		<div class="destination">
			<span>Arriving soon</span>
			<div>
				Somewhere<br />in Amsterdam <span class="online">(and online)</span>
				<span class="destination-arrow" aria-hidden="true">
					<PaperPlane />
				</span>
			</div>
		</div>
	</div>
</section>

<script src="./goose-anim.ts"></script>

<style>
	#goose-svg {
		width: 100%;
		height: 100%;
		rotate: 10deg;
	}

	.picture {
		--hill-top: 73%;
		position: relative;
		isolation: isolate;
		overflow: hidden;
		container-type: inline-size;
		color: var(--strong);
	}

	.picture-layout {
		--picture-pad-block: 36px;
		--picture-pad-inline: 36px;
		display: grid;
		grid-template:
			"label" auto
			"headline" auto
			"art" minmax(72px, 1fr)
			"destination" auto
			/ minmax(0, 1fr);
		min-height: 100%;
		padding: var(--picture-pad-block) var(--picture-pad-inline);
	}

	.grass {
		position: absolute;
		top: var(--hill-top);
		left: -50%;
		z-index: -2;
		width: 200%;
		aspect-ratio: 1 / 1;
		background: var(--mint);
		border-radius: 50%;
		animation: revolve 70s linear infinite;
	}

	.postcard-clouds {
		position: absolute;
		inset: 0;
		z-index: -3;
		overflow: hidden;
		pointer-events: none;
	}

	.postcard-cloud {
		position: absolute;
		top: var(--cloud-top);
		left: -40%;
		width: var(--cloud-width);
		height: auto;
		fill: var(--paper);
		opacity: 0.6;
		animation: postcard-cloud-drift var(--cloud-duration) linear
			var(--cloud-delay) infinite;
	}

	@keyframes postcard-cloud-drift {
		from {
			left: -40%;
		}
		to {
			left: 140%;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.postcard-cloud {
			animation: none;
			left: 30%;
		}
	}

	.distant-windmill {
		position: absolute;
		z-index: -1;
		top: calc(var(--hill-top) + 8cqw);
		left: 10%;
		width: clamp(18px, 13cqw, 36px);
		height: auto;
		transform: translate(-50%, -100%) rotate(-21deg);
		pointer-events: none;
		color: #7e2525;
	}

	.windmill-tower {
		fill: #b4483f;
	}

	.windmill-roof,
	.windmill-detail {
		fill: currentColor;
	}

	.windmill-sails {
		fill: var(--paper);
		stroke: currentColor;
		stroke-width: 1.8;
		stroke-linejoin: round;
		stroke-linecap: round;
		transform-box: fill-box;
		transform-origin: center;
		transform: rotate(-35deg);
		animation: windmill-turn 18s linear infinite;
	}

	@keyframes windmill-turn {
		from {
			transform: rotate(-35deg);
		}
		to {
			transform: rotate(325deg);
		}
	}

	@keyframes revolve {
		from {
			rotate: 0deg;
		}
		to {
			rotate: 360deg;
		}
	}

	.air-label {
		position: relative;
		z-index: 2;
		grid-area: label;
		margin: 0;
		font-family: var(--label-font), "Avenir Next", sans-serif;
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	h1 {
		position: relative;
		z-index: 2;
		grid-area: headline;
		align-self: start;
		margin: 25px 0 0 -7px;
		font-family: var(--heading-font), "Avenir Next", sans-serif;
		font-size: clamp(76px, calc(28cqw - 4px), 148px);
		font-weight: 750;
		letter-spacing: -0.04em;
		line-height: 0.98;
	}

	h1 > span {
		display: block;
	}

	.headline-word {
		margin-right: 15px;
	}

	.period-logo {
		display: none;
		width: 0.207em;
		height: 0.207em;
		margin-left: 0.05em;
		vertical-align: -0.05em;
	}

	:global(body[data-palette="rpg-actor"]) .period {
		display: none;
	}

	:global(body[data-palette="rpg-actor"]) .period-logo {
		display: inline-block;
	}

	.headline-at {
		display: inline-block;
		padding: 0.03em 0.14em 0.1em;
		margin: -0.03em -0.02em 0 0;
		border-radius: 0.15em 0.42em 0.2em 0.32em;
		color: var(--butter);
		font-family: var(--heading-font), "Avenir Next", sans-serif;
		font-weight: 800;
		letter-spacing: -0.04em;
		line-height: 0.88;
		-webkit-text-stroke: 5px var(--strong);
		paint-order: stroke fill;
		transform: rotate(-3deg);
	}

	.destination {
		position: relative;
		z-index: 2;
		grid-area: destination;
		justify-self: start;
		display: flex;
		flex-direction: column;
		width: max-content;
		max-width: 100%;
		padding: 12px 12px;
		margin: 0 0 calc(5px - var(--picture-pad-block))
			calc(20px - var(--picture-pad-inline));
		border-radius: 8px;
		font-size: 45px;
	}

	.destination > span:first-child {
		font-family: var(--label-font), "Avenir Next", sans-serif;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		margin-bottom: 2px;
	}

	.destination div {
		color: var(--ink);
		letter-spacing: -1px;
		position: relative;
		font-weight: 700;
		line-height: 0.9;
	}

	.destination .online {
		font-size: 0.84rem;
		letter-spacing: -0.4px;
		white-space: nowrap;
	}

	.destination-arrow {
		color: var(--ink);
		padding-top: 3px;
		line-height: 1;
		position: absolute;
		top: 0;
		right: 0;
	}

	/* rpg-actor's postcard sits on a bright sky, so its label/destination
	   text needs to read against --sky instead of the default paper card;
	   --label-ink is the palette's dedicated token for that (see airmail.css). */
	:global(body[data-palette="rpg-actor"]) .air-label,
	:global(body[data-palette="rpg-actor"]) .destination > span:first-child {
		color: var(--ink);
	}

	:global(body[data-palette="rpg-actor"]) .destination div,
	:global(body[data-palette="rpg-actor"]) .destination .online,
	:global(body[data-palette="rpg-actor"]) .destination-arrow {
		color: var(--label-ink);
	}

	.goose-route {
		position: relative;
		z-index: 1;
		grid-area: art;
		align-self: end;
		justify-self: end;
		width: clamp(120px, calc(55cqw - 145px), 170px);
		aspect-ratio: 1;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	/* Pick the art from the palette, which is on <body> before the first
	   frame. ThemeSwitcher's syncGoose only runs once the page has parsed,
	   too late for the page flip's snapshot. */
	.goose {
		display: none;
		width: 100%;
		height: 100%;
		object-fit: contain;
		transform-origin: 50% 90%;
		animation: stride 0.65s ease-in-out infinite alternate;
	}

	:global(body[data-palette="colibri"]) #goose-img {
		display: block;
	}

	:global(body[data-palette="colibri"]) #goose-svg,
	:global(body[data-palette="pronouns"]) #goose-svg {
		display: none;
	}

	:global(body[data-palette="rpg-actor"]) #goose-svg {
		display: none;
	}

	/* rpg-actor's sprite steps through its walk cycle the same way every
	   sprite on rpg.actor does: a 3x4 sheet, one row per facing, three
	   frames per stride, stepped with background-position + steps().
	   Fixed at a 2x integer scale (48px frames -> 96px) so the crop lands
	   on whole pixels instead of the fractional offsets percentage sizing
	   would produce against the goose-route's fluid width. Anchored to the
	   bottom of the route so it sits on the ground instead of floating. */
	.rpg-actor-sprite {
		width: 96px;
		height: 96px;
		align-self: flex-end;
		background-repeat: no-repeat;
		background-size: 288px 384px;
		background-position: 0 -96px;
		image-rendering: pixelated;
		animation:
			rpg-actor-walk 0.6s steps(1) infinite,
			rpg-actor-sway 1.2s ease-in-out infinite alternate;
	}

	:global(body[data-palette="rpg-actor"]) #rpg-actor-goose {
		display: block;
	}

	@keyframes rpg-actor-sway {
		from {
			transform: translateX(-3px);
		}
		to {
			transform: translateX(3px);
		}
	}

	@keyframes rpg-actor-walk {
		0%,
		100% {
			background-position-x: 0;
		}
		25% {
			background-position-x: -96px;
		}
		50% {
			background-position-x: -192px;
		}
		75% {
			background-position-x: -96px;
		}
	}

	@keyframes stride {
		from {
			transform: rotate(-5deg) translateY(0);
		}
		to {
			transform: rotate(4deg) translateY(-9px);
		}
	}

	@container (max-width: 360px) {
		.destination .online {
			display: block;
		}
	}

	@media (max-width: 900px) {
		.picture-layout {
			--picture-pad-block: 28px;
			--picture-pad-inline: 20px;
		}

		h1 {
			margin-top: clamp(32px, 5vw, 45px);
		}

		.picture {
			--hill-top: 55%;
		}
	}

	@media (max-width: 660px) {
		.picture {
			min-height: 400px;
		}

		.picture-layout {
			--picture-pad-inline: 24px;
			min-height: auto;
		}

		.air-label {
			font-size: 10px;
			letter-spacing: 1.5px;
		}

		h1 {
			margin: 39px 0 0 -5px;
			font-size: clamp(76px, 18vw, 114px);
		}

		.goose-route {
			width: clamp(120px, 24cqw, 145px);
		}

		.destination .online {
			display: block;
		}

		.destination-arrow {
			left: calc(100% + 4px);
			right: auto;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.goose,
		.windmill-sails {
			animation: none;
		}
	}
</style>
