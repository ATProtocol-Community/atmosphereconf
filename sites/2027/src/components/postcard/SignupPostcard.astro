---
import PostcardForm from "./PostcardForm.astro";
import PostcardFrame from "./PostcardFrame.astro";
import PostcardHeader from "./PostcardHeader.astro";
import type { SignupCard, SignupFailure } from "../lib/subscribe";

interface Props {
	card: SignupCard;
}

const { card } = Astro.props;
const failureMessages: Record<
	Exclude<SignupFailure["kind"], "sign-in">,
	string
> = {
	check: "We couldn't check your subscriptions. Try your handle again.",
	subscribe: "We couldn't confirm your subscription. Try your handle again.",
	"bad-email": "That email address doesn't look right.",
	"save-email": "We couldn't save your email. Please try again.",
};
const failure = card.kind === "form" ? card.failure : undefined;
const error =
	failure?.kind === "sign-in"
		? (failure.detail ??
			"Sign-in could not be completed. Try your handle again.")
		: failure && failureMessages[failure.kind];
const receipt =
	card.kind !== "subscribed"
		? undefined
		: card.via === "email"
			? "You're on the list."
			: card.already
				? "Your Atmosphere account is already subscribed."
				: "Subscribed with your Atmosphere account. The next postcard knows where to find you.";
---

<PostcardFrame label="A postcard from AtmosphereConf" titleId="signup-title">
	<PostcardHeader
		id="signup-title"
		as="h2"
		decorationLane={1.1}
		title="Hear it straight from the gaggle-vine"
		subtitle="Be the first to learn about dates, tickets, news, and exclusive geese reveals!"
	>
		<svg
			slot="decoration"
			width="256"
			height="256"
			viewBox="0 0 256 256"
			overflow="visible"
			xmlns="http://www.w3.org/2000/svg"
		>
			<!-- Sound beams sit outside the viewBox (hence overflow) so the
			     megaphone keeps its size. -->
			<path
				fill="none"
				stroke="currentColor"
				stroke-width="18"
				stroke-linecap="round"
				d="M8 120H-40M12 62L-28 34M12 178L-28 206"></path>
			<path
				fill="currentColor"
				stroke="currentColor"
				stroke-width="6"
				stroke-linejoin="round"
				d="M246 120a46.05 46.05 0 0 0-46-46h-39.85c-2.58-.15-54.1-3.57-103.15-44.71A14 14 0 0 0 34 40v160a13.85 13.85 0 0 0 8.07 12.68A14.2 14.2 0 0 0 48 214a13.9 13.9 0 0 0 9-3.3c40-33.52 81.57-42 97-44.07v34a14 14 0 0 0 6.23 11.65l11 7.33a14 14 0 0 0 21.32-8.17l12.13-45.71A46.07 46.07 0 0 0 246 120M49.29 201.52A2 2 0 0 1 46 200V40a1.9 1.9 0 0 1 1.15-1.8A2.1 2.1 0 0 1 48 38a1.9 1.9 0 0 1 1.26.48c44 36.92 89 45.19 104.71 47v69c-15.68 1.85-60.67 10.13-104.68 47.04m131.64 7a2 2 0 0 1-3.05 1.18l-11-7.33a2 2 0 0 1-.89-1.67V166h26.2ZM200 154h-34V86h34a34 34 0 1 1 0 68"
			></path>
		</svg>
	</PostcardHeader>
	{
		receipt ? (
			<div class="receipt">
				<p id="signup-receipt" role="status" tabindex="-1">
					{receipt}
				</p>
				<a class="postcard-action" href="/rsvp">
					RSVP here <span aria-hidden="true">→</span>
				</a>
			</div>
		) : (
			<PostcardForm error={error} />
		)
	}
</PostcardFrame>

<script>
	document.getElementById("signup-receipt")?.focus();
</script>

<style>
	.receipt {
		display: grid;
		gap: 16px;
	}
	.receipt p {
		margin: 0;
		font-size: 14px;
		font-weight: 800;
		line-height: 1.4;
	}
	/* Focused on load so screen readers land on it; it isn't a control. */
	.receipt p:focus {
		outline: none;
	}
</style>
