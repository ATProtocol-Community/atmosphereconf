---
import ComboBox from "../ComboBox.astro";
import Tooltip from "../Tooltip.astro";
import { hasDatabase } from "../lib/db";
import HandleIcon from "./HandleIcon.astro";
import RotatingSuffix from "./RotatingSuffix.astro";

interface Props {
	error?: string;
}

const { error } = Astro.props;
// With a database, emails stay here; otherwise Leaflet collects them.
const emailAction = hasDatabase
	? "/subscribe"
	: "https://leaflet.pub/api/auth/email-login";
const emailMethod = hasDatabase ? "post" : "get";
---

<form
	class="postcard-form"
	action={emailAction}
	method={emailMethod}
	data-email-action={emailAction}
	data-email-method={emailMethod}
>
	<fieldset class="segmented">
		<input id="method-email" name="method" type="radio" value="email" checked />
		<label class="segmented-option" for="method-email">
			<span class="segmented-icon" aria-hidden="true">
				<svg
					width="24"
					height="24"
					viewBox="0 0 24 24"
					xmlns="http://www.w3.org/2000/svg"
				>
					<path
						fill="currentColor"
						d="M5 5h13a3 3 0 0 1 3 3v9a3 3 0 0 1-3 3H5a3 3 0 0 1-3-3V8a3 3 0 0 1 3-3m0 1c-.5 0-.94.17-1.28.47l7.78 5.03l7.78-5.03C18.94 6.17 18.5 6 18 6zm6.5 6.71L3.13 7.28C3.05 7.5 3 7.75 3 8v9a2 2 0 0 0 2 2h13a2 2 0 0 0 2-2V8c0-.25-.05-.5-.13-.72z"
					></path>
				</svg>
			</span>
			<span class="segmented-text">Email</span>
		</label>
		<input id="method-handle" name="method" type="radio" value="handle" />
		<label class="segmented-option" for="method-handle">
			<span class="segmented-icon" aria-hidden="true">
				<HandleIcon />
			</span>
			<span class="segmented-text">Handle</span>
		</label>
	</fieldset>
	<label class="sr-only" for="airmail-email">Email or Atmosphere handle</label>
	<div class="airmail-email-wrap">
		<ComboBox
			id="airmail-email"
			name="email"
			inputClass="postcard-field"
			autocomplete="username webauthn email"
			placeholder="you@example.com"
			label="login text"
			required
		/>
		<div class="airmail-email-placeholder">
			<span class="airmail-prefix-text">you</span><RotatingSuffix
				words={["@example.com", ".bsky.social", ".blacksky.social"]}
			/>
		</div>
	</div>
	<p class="tip">
		Whether via{" "}
		<Tooltip
			id="postcard-email-tooltip"
			label="email"
			class="email"
			blockAnchor="--tip">You know what this is.</Tooltip
		>{" "}or{" "}
		<Tooltip
			id="postcard-atmosphere-tooltip"
			label="Atmosphere handle"
			class="handle"
			blockAnchor="--tip"
			>From Blacksky to Pckt, from Bluesky to Offprint, the same username
			unlocks countless apps and website—no matter which got you first.</Tooltip
		>, our news reaches you all across the web.
	</p>
	<div class="form-actions">
		<a class="form-actions-link" href="/rsvp"
			>Coming there? RSVP! <span aria-hidden="true">→</span></a
		>
		<button class="postcard-action small-action" type="submit"
			>Keep me posted <span aria-hidden="true">↗</span></button
		>
	</div>
	{
		error && (
			<p
				id="postcard-subscription-result"
				class="subscription-result"
				role="alert"
				tabindex="-1"
			>
				{error}
			</p>
		)
	}
	<input
		type="hidden"
		name="action"
		value="%7B%22action%22%3A%22subscribe%22%2C%22publication%22%3A%22at%3A%2F%2Fdid%3Aplc%3Alehcqqkwzcwvjvw66uthu5oq%2Fsite.standard.publication%2F3m367bemk3c2i%22%7D"
	/>
	<input
		type="hidden"
		name="redirect"
		value="https://news.atmosphereconf.org"
	/>
</form>
<script>
	import { searchActors, type ActorSuggestion } from "../lib/actor-search";

	const emailInput = document.getElementById(
		"airmail-email",
	) as HTMLInputElement | null;
	const methodEmailInput = document.getElementById(
		"method-email",
	) as HTMLInputElement | null;
	const methodHandleInput = document.getElementById(
		"method-handle",
	) as HTMLInputElement | null;
	const suffixOptionsEl = emailInput
		?.closest("form")
		?.querySelector(".suffix-options") as HTMLDivElement | null;
	const suffixOptionElements = suffixOptionsEl
		? Array.from(suffixOptionsEl.querySelectorAll("div"))
		: [];
	const suffixOptionValues = suffixOptionElements
		.map((node) => node.textContent?.trim() ?? "")
		.filter((value) => !!value);
	const getMiddleSuffixOptions = (): string[] => {
		const count = suffixOptionValues.length;
		if (count === 0) return [];
		if (count % 2 === 0) {
			const start = Math.floor((count - 1) / 2);
			return suffixOptionValues.slice(start, Math.min(count, start + 2));
		}
		const middle = Math.floor(count / 2);
		return [suffixOptionValues[middle]];
	};
	const didPattern = /^did:[a-z0-9.-]+:/i;
	const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/i;
	const handleLikePattern =
		/^@[\w.-]+$|^[a-z0-9][a-z0-9-]*\.[a-z0-9][a-z0-9.-]*$/i;
	const setSuffixFromMethod = (isHandleMode: boolean) => {
		if (!suffixOptionsEl || suffixOptionElements.length === 0) return;
		const firstSuffix = suffixOptionValues[0];
		const candidateSuffixes = isHandleMode
			? /*getMiddleSuffixOptions()*/ [".example.com"]
			: firstSuffix
				? [firstSuffix]
				: [];
		if (candidateSuffixes.length === 0) return;
		const idx = isHandleMode
			? Math.floor(Math.random() * candidateSuffixes.length)
			: 0;
		const next = candidateSuffixes[idx];
		if (!next) return;
		suffixOptionElements[0]!.textContent = next;
	};

	const detectMethod = (rawValue: string): "email" | "handle" => {
		const value = String(rawValue ?? "")
			.trim()
			.toLowerCase();
		if (!value) return "email";
		if (didPattern.test(value)) return "handle";
		if (value.startsWith("@")) return "handle";
		if (value.includes("@")) return "email";
		if (handleLikePattern.test(value)) return "handle";
		return "email";
	};

	const setMethodFromInput = () => {
		if (!emailInput || !methodEmailInput || !methodHandleInput) return;
		const method = detectMethod(emailInput.value);
		if (method === "handle") {
			methodHandleInput.checked = true;
		} else {
			methodEmailInput.checked = true;
		}
		setSuffixFromMethod(method === "handle");
		setSuggestionsEnabledByMethod();
	};

	const setSuggestionsEnabledByMethod = () => {
		if (!combobox) return;
		const disableSuggestions = methodEmailInput?.checked ?? false;
		combobox.toggleAttribute("disable-suggestions", disableSuggestions);
	};

	const combobox = emailInput?.closest("cmb-combobox");
	// emailInput?.addEventListener("input", setMethodFromInput);
	const handleEmailSelection = () => {
		setSuffixFromMethod(false);
		setSuggestionsEnabledByMethod();
	};
	const handleHandleSelection = () => {
		setSuffixFromMethod(true);
		setSuggestionsEnabledByMethod();
	};

	methodEmailInput?.addEventListener("click", handleEmailSelection);
	methodEmailInput?.addEventListener("change", handleEmailSelection);
	methodHandleInput?.addEventListener("click", handleHandleSelection);
	methodHandleInput?.addEventListener("change", handleHandleSelection);
	// setMethodFromInput();
	setSuggestionsEnabledByMethod();
	setSuffixFromMethod(false);
	combobox?.addEventListener("combobox-search", (e) => {
		const detail = (
			e as CustomEvent<{
				query: string;
				results: Promise<ActorSuggestion[]> | null;
			}>
		).detail;
		const query = (detail?.query ?? "").trim();
		try {
			detail.results = searchActors(query);
		} catch {
			// Keep form usable if search event detail is immutable for this environment.
		}
		// const method = detectMethod(query);
		// if (methodHandleInput && method === "handle") {
		// 	methodHandleInput.checked = true;
		// } else if (methodEmailInput) {
		// 	methodEmailInput.checked = true;
		// }
	});
	const form = emailInput?.closest("form");
	const redirectInput = form?.querySelector('input[name="redirect"]');
	const actionInput = form?.querySelector('input[name="action"]');
	form?.addEventListener("submit", () => {
		if (!emailInput) return;
		const identifier = emailInput.value.trim();
		const isHandle = detectMethod(identifier) === "handle";
		// Reset every field even when returning with Back or changing methods.
		form.setAttribute("method", isHandle ? "post" : form.dataset.emailMethod!);
		form.setAttribute(
			"action",
			isHandle ? "/oauth/login" : form.dataset.emailAction!,
		);
		emailInput.name = isHandle ? "atproto-id" : "email";
		emailInput.value = isHandle ? identifier.replace(/^@/, "") : identifier;
		if (redirectInput instanceof HTMLInputElement) {
			redirectInput.value = isHandle
				? "/subscribe"
				: "https://news.atmosphereconf.org";
		}
		if (actionInput instanceof HTMLInputElement)
			actionInput.disabled = isHandle;
	});
	document.getElementById("postcard-subscription-result")?.focus();
</script>
<style>
	form {
		--rounding: 16px;
	}

	label {
		font-size: 11px;
		font-weight: 700;
	}

	.segmented {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0;
		padding: 3px;
		border: 1px solid var(--ink);
		border-radius: var(--rounding);
		position: relative;
		overflow: hidden;
		isolation: isolate;
	}

	.segmented::before {
		content: "";
		position: absolute;
		top: 3px;
		left: 3px;
		width: calc(50% - 3px);
		height: calc(100% - 6px);
		background: var(--butter);
		border-radius: calc(var(--rounding) - 3px);
		transform: translateX(0);
		transition:
			transform 280ms cubic-bezier(0.22, 1, 0.36, 1),
			background-color 160ms ease;
		z-index: -1;
	}

	form:has(input ~ input:checked) .segmented::before {
		transform: translateX(calc(100%));
	}

	.segmented input[type="radio"] {
		position: absolute;
		opacity: 0;
		width: 1px;
		height: 1px;
		margin: 0;
		overflow: hidden;
		clip-path: inset(100%);
	}

	.segmented-option {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		padding: 2px 12px;
		border-radius: 999px;
		cursor: pointer;
		color: var(
			--tab-inactive-foreground,
			color-mix(in oklab, var(--ink) 70%, transparent)
		);
		transition: color 220ms ease;
	}

	.segmented-text {
		display: inline-block;
		transition:
			transform 220ms ease,
			opacity 220ms ease;
	}

	.segmented-option:focus-visible {
		outline: 2px solid var(--strong);
		outline-offset: 2px;
	}

	input {
		border-radius: var(--rounding);
	}

	input[type="radio"]:checked + .segmented-option {
		color: var(--tab-active-foreground, var(--ink));
	}

	input[type="radio"]:checked + .segmented-option .segmented-text {
		transform: translateX(0);
		opacity: 1;
	}

	input[type="radio"] + .segmented-option .segmented-text {
		opacity: var(--tab-text-opacity, 1);
	}

	.segmented-icon {
		font-size: 13px;
		line-height: 1;
	}

	/* The triggers are rendered by <Tooltip>, so they carry that component's
	   scope, not this one's. The scoped `form` still confines these to us. */
	form:has(input[value="handle"]:checked) :global(.tooltip-button.handle),
	form:has(input[value="email"]:checked) :global(.tooltip-button.email) {
		color: var(--cancel-stamp);
	}

	.airmail-email-wrap {
		position: relative;
		--card: white;
	}

	.airmail-email-placeholder {
		position: absolute;
		left: 15px;
		top: 50%;
		transform: translateY(-50%);
		color: var(--ink);
		opacity: 0.65;
		pointer-events: none;
		/* Above the input, which now has its own fill; clicks pass through. */
		z-index: 2;
		display: flex;
		height: 100%;
		align-items: center;
	}

	:global(#airmail-email)::placeholder {
		opacity: 0;
	}

	:global(
		form:has(#airmail-email:not(:placeholder-shown)) .airmail-email-placeholder
	) {
		opacity: 0;
	}

	:global(#airmail-email) {
		appearance: none;
		-webkit-appearance: none;
		position: relative;
		z-index: 1;
	}
	:global(#airmail-email-listbox) {
		padding-block: 10px;
		li {
			padding: 8px 10px;
		}
		li:hover {
			background: var(--butter);
			border-radius: var(--rounding);
		}
	}

	.tip {
		position: relative;
		margin: 0;
		font-size: 14px;
		line-height: 1.4;
		font-weight: 500;
		/* Narrow-screen anchor: tooltips span the paragraph, as they did in flow. */
		anchor-name: --tip;
	}

	.subscription-result {
		margin: 0;
		font-size: 13px;
		font-weight: 800;
		line-height: 1.4;
		overflow-wrap: anywhere;
	}
</style>
