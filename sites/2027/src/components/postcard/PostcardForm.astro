---
import ComboBox from "../ComboBox.astro";
import Tooltip from "../Tooltip.astro";
import { takeSubscriptionResult } from "../lib/subscribe";
const subscriptionResult = await takeSubscriptionResult(
	Astro.session,
	Astro.locals.authproto,
);
---

<form action="https://leaflet.pub/api/auth/email-login" method="get">
	<fieldset class="segmented">
		<input id="method-email" name="method" type="radio" value="email" checked />
		<label class="segmented-option" for="method-email">
			<span class="segmented-icon" aria-hidden="true">
				<svg
					width="24"
					height="24"
					viewBox="0 0 24 24"
					xmlns="http://www.w3.org/2000/svg"
				>
					<path
						fill="currentColor"
						d="M5 5h13a3 3 0 0 1 3 3v9a3 3 0 0 1-3 3H5a3 3 0 0 1-3-3V8a3 3 0 0 1 3-3m0 1c-.5 0-.94.17-1.28.47l7.78 5.03l7.78-5.03C18.94 6.17 18.5 6 18 6zm6.5 6.71L3.13 7.28C3.05 7.5 3 7.75 3 8v9a2 2 0 0 0 2 2h13a2 2 0 0 0 2-2V8c0-.25-.05-.5-.13-.72z"
					></path>
				</svg>
			</span>
			<span class="segmented-text">Email</span>
		</label>
		<input id="method-handle" name="method" type="radio" value="handle" />
		<label class="segmented-option" for="method-handle">
			<span class="segmented-icon" aria-hidden="true">
				<svg
					width="17"
					height="17"
					viewBox="0 0 32 32"
					fill="none"
					xmlns="http://www.w3.org/2000/svg"
				>
					<path
						fill-rule="evenodd"
						clip-rule="evenodd"
						d="M16 0C18.1127 1.0372e-05 19.9555 1.15414 20.9332 2.8662C21.1045 3.16613 21.4647 3.31517 21.7979 3.22403C22.2761 3.09321 22.7795 3.02333 23.2992 3.02333C26.4347 3.02335 28.9765 5.56529 28.9765 8.70083C28.9765 9.22048 28.9066 9.72378 28.7758 10.2019C28.6846 10.5351 28.8337 10.8953 29.1336 11.0666C30.8458 12.0442 32 13.8872 32 16C32 16.0822 31.9981 16.1639 31.9946 16.2452C31.9946 16.2456 31.9944 16.246 31.9942 16.2463C31.9939 16.2465 31.9937 16.2469 31.9937 16.2473C31.8599 19.6701 29.2873 22.4 26.1329 22.4L25.9815 22.3979C24.3638 22.353 22.909 21.59 21.8719 20.3888C21.5701 20.0392 20.9949 20.0275 20.6799 20.3652C19.5117 21.6171 17.8474 22.4 16 22.4C12.4654 22.4 9.6 19.5346 9.6 16C9.6 12.4654 12.4654 9.6 16 9.6C17.4368 9.6 18.7629 10.0736 19.831 10.8731C20.0053 11.0036 20.2667 10.8843 20.2667 10.6667C20.2667 10.0776 20.7442 9.6 21.3333 9.6C21.9224 9.6 22.4 10.0776 22.4 10.6667V16C22.4158 18.5458 24.26 20.2666 26.1329 20.2667C27.9447 20.2667 29.7293 18.6564 29.8583 16.2467C29.8583 16.2466 29.8583 16.2464 29.8581 16.2463C29.858 16.2461 29.8579 16.2459 29.8579 16.2458C29.8591 16.2281 29.8597 16.2104 29.8606 16.1927C29.8634 16.1293 29.8654 16.0654 29.8658 16.001C29.8658 16.0006 29.866 16.0003 29.8663 16C29.8665 15.9997 29.8667 15.9994 29.8667 15.999C29.8663 14.5464 28.9914 13.2933 27.7308 12.7465L26.4045 12.1712C26.0876 12.0337 25.937 11.6696 26.0641 11.3484L26.5963 10.0042C26.7549 9.60324 26.8431 9.16479 26.8431 8.70083C26.8431 6.77399 25.3056 5.20644 23.3906 5.15792L23.2992 5.15667C22.8351 5.15667 22.3965 5.24487 21.9956 5.40354L20.6515 5.93568C20.3304 6.06282 19.9663 5.91222 19.8288 5.59538L19.2533 4.26917C18.7234 3.04774 17.5306 2.18836 16.1356 2.13583L16 2.13333C14.547 2.13333 13.2934 3.00824 12.7465 4.26896L12.1712 5.59529C12.0337 5.91217 11.6696 6.06282 11.3484 5.93568L10.0042 5.40354C9.62831 5.25477 9.21941 5.16798 8.7875 5.15771L8.70083 5.15667C6.74349 5.15667 5.15667 6.74349 5.15667 8.70083C5.15667 9.16475 5.24485 9.60323 5.40354 10.0042L5.93568 11.3484C6.06282 11.6696 5.91217 12.0337 5.59529 12.1712L4.26896 12.7465C3.00823 13.2934 2.13333 14.5469 2.13333 16C2.13333 17.4529 3.00832 18.7063 4.26917 19.2533L5.59538 19.8288C5.91222 19.9663 6.06282 20.3304 5.93568 20.6515L5.40354 21.9956C5.24487 22.3965 5.15667 22.835 5.15667 23.2992C5.15667 25.2565 6.74349 26.8433 8.70083 26.8433C9.1644 26.8433 9.60287 26.7551 10.0042 26.5963L11.3484 26.0641C11.6696 25.937 12.0337 26.0876 12.1712 26.4045L12.7465 27.7308C13.2934 28.9917 14.547 29.8667 16 29.8667C17.4529 29.8667 18.7063 28.9918 19.2533 27.7308L19.6555 26.8037C19.8871 26.2698 20.5083 26.0256 21.0415 26.2589C21.561 26.4862 21.8066 27.0847 21.5966 27.6115L21.2104 28.5798C20.3374 30.5922 18.3333 32 16 32C13.8872 32 12.0442 30.8458 11.0666 29.1336C10.8953 28.8337 10.5351 28.6846 10.2019 28.7758C9.72378 28.9067 9.22049 28.9767 8.70083 28.9767C5.56528 28.9767 3.02333 26.4347 3.02333 23.2992C3.02333 22.7795 3.09321 22.2761 3.22403 21.7979C3.31516 21.4647 3.16613 21.1045 2.86619 20.9332C1.15412 19.9555 0 18.1127 0 16C5.927e-07 13.8873 1.1541 12.0443 2.8662 11.0666C3.16613 10.8953 3.31517 10.5351 3.22403 10.2019C3.09323 9.72379 3.02333 9.22047 3.02333 8.70083C3.02333 5.56528 5.56528 3.02333 8.70083 3.02333C9.22047 3.02334 9.72379 3.09323 10.2019 3.22404C10.5351 3.31517 10.8953 3.16614 11.0666 2.86621C12.0443 1.15411 13.8873 0 16 0ZM16 11.7333C13.6436 11.7333 11.7333 13.6436 11.7333 16C11.7333 18.3564 13.6436 20.2667 16 20.2667C18.3564 20.2667 20.2667 18.3564 20.2667 16C20.2667 13.6436 18.3564 11.7333 16 11.7333Z"
						fill="currentColor"></path>
				</svg>
			</span>
			<span class="segmented-text">Handle</span>
		</label>
	</fieldset>
	<label class="sr-only" for="airmail-email">Email or Atmosphere handle</label>
	<div class="airmail-email-wrap">
		<ComboBox
			id="airmail-email"
			name="email"
			autocomplete="username webauthn email"
			placeholder="you@example.com"
			label="login text"
			required
		/>
		<div class="airmail-email-placeholder">
			<span class="airmail-prefix-text">you</span><div class="word-wrapper">
				<div class="suffix-options">
					<div>@example.com</div>
					<div>.bsky.social</div>
					<div>.blacksky.social</div>
					<div>@example.com</div>
				</div>
			</div>
		</div>
	</div>
	<p class="tip">
		Whether via{" "}
		<Tooltip
			id="postcard-email-tooltip"
			label="email"
			class="email"
			blockAnchor="--tip">You know what this is.</Tooltip
		>{" "}or{" "}
		<Tooltip
			id="postcard-atmosphere-tooltip"
			label="Atmosphere handle"
			class="handle"
			blockAnchor="--tip"
			>From Blacksky to Pckt, from Bluesky to Offprint, the same username
			unlocks countless apps and website—no matter which got you first.</Tooltip
		>, our news reaches you all across the web.
	</p>
	<button class="subscribe" type="submit"
		>Keep me posted <span aria-hidden="true">↗</span></button
	>
	{
		subscriptionResult && (
			<p
				id="postcard-subscription-result"
				class="subscription-result"
				role={subscriptionResult.kind === "success" ? "status" : "alert"}
				tabindex="-1"
			>
				{subscriptionResult.message}
			</p>
		)
	}
	<input
		type="hidden"
		name="action"
		value="%7B%22action%22%3A%22subscribe%22%2C%22publication%22%3A%22at%3A%2F%2Fdid%3Aplc%3Alehcqqkwzcwvjvw66uthu5oq%2Fsite.standard.publication%2F3m367bemk3c2i%22%7D"
	/>
	<input
		type="hidden"
		name="redirect"
		value="https://news.atmosphereconf.org"
	/>
</form>
<script>
	type Actor = {
		handle: string;
		displayName?: string;
		avatar?: string;
	};
	type Suggestion = {
		value: string;
		label?: string;
		sublabel?: string;
		avatar?: string;
	};

	const SEARCH_ACTORS_URL =
		"https://public.api.bsky.app/xrpc/app.bsky.actor.searchActorsTypeahead";

	const emailInput = document.getElementById(
		"airmail-email",
	) as HTMLInputElement | null;
	const methodEmailInput = document.getElementById(
		"method-email",
	) as HTMLInputElement | null;
	const methodHandleInput = document.getElementById(
		"method-handle",
	) as HTMLInputElement | null;
	const suffixOptionsEl = emailInput
		?.closest("form")
		?.querySelector(".suffix-options") as HTMLDivElement | null;
	const suffixOptionElements = suffixOptionsEl
		? Array.from(suffixOptionsEl.querySelectorAll("div"))
		: [];
	const suffixOptionValues = suffixOptionElements
		.map((node) => node.textContent?.trim() ?? "")
		.filter((value) => !!value);
	const getMiddleSuffixOptions = (): string[] => {
		const count = suffixOptionValues.length;
		if (count === 0) return [];
		if (count % 2 === 0) {
			const start = Math.floor((count - 1) / 2);
			return suffixOptionValues.slice(start, Math.min(count, start + 2));
		}
		const middle = Math.floor(count / 2);
		return [suffixOptionValues[middle]];
	};
	const didPattern = /^did:[a-z0-9.-]+:/i;
	const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/i;
	const handleLikePattern =
		/^@[\w.-]+$|^[a-z0-9][a-z0-9-]*\.[a-z0-9][a-z0-9.-]*$/i;
	const setSuffixFromMethod = (isHandleMode: boolean) => {
		if (!suffixOptionsEl || suffixOptionElements.length === 0) return;
		const firstSuffix = suffixOptionValues[0];
		const candidateSuffixes = isHandleMode
			? /*getMiddleSuffixOptions()*/ [".example.com"]
			: firstSuffix
				? [firstSuffix]
				: [];
		if (candidateSuffixes.length === 0) return;
		const idx = isHandleMode
			? Math.floor(Math.random() * candidateSuffixes.length)
			: 0;
		const next = candidateSuffixes[idx];
		if (!next) return;
		suffixOptionElements[0]!.textContent = next;
	};

	const detectMethod = (rawValue: string): "email" | "handle" => {
		const value = String(rawValue ?? "")
			.trim()
			.toLowerCase();
		if (!value) return "email";
		if (didPattern.test(value)) return "handle";
		if (value.startsWith("@")) return "handle";
		if (value.includes("@")) return "email";
		if (handleLikePattern.test(value)) return "handle";
		return "email";
	};

	const setMethodFromInput = () => {
		if (!emailInput || !methodEmailInput || !methodHandleInput) return;
		const method = detectMethod(emailInput.value);
		if (method === "handle") {
			methodHandleInput.checked = true;
		} else {
			methodEmailInput.checked = true;
		}
		setSuffixFromMethod(method === "handle");
		setSuggestionsEnabledByMethod();
	};

	const setSuggestionsEnabledByMethod = () => {
		if (!combobox) return;
		const disableSuggestions = methodEmailInput?.checked ?? false;
		combobox.toggleAttribute("disable-suggestions", disableSuggestions);
	};

	const searchBskyActors = async (q: string): Promise<Suggestion[]> => {
		const url = new URL(SEARCH_ACTORS_URL);
		url.searchParams.set("q", q);
		url.searchParams.set("limit", "8");
		const res = await fetch(url, { headers: { accept: "application/json" } });
		if (!res.ok) return [];
		const data = (await res.json()) as { actors?: Actor[] };
		return (data.actors ?? []).map((a) => ({
			value: a.handle,
			label: a.displayName || a.handle,
			sublabel: `@${a.handle}`,
			avatar: a.avatar,
		}));
	};

	const combobox = emailInput?.closest("cmb-combobox");
	// emailInput?.addEventListener("input", setMethodFromInput);
	const handleEmailSelection = () => {
		setSuffixFromMethod(false);
		setSuggestionsEnabledByMethod();
	};
	const handleHandleSelection = () => {
		setSuffixFromMethod(true);
		setSuggestionsEnabledByMethod();
	};

	methodEmailInput?.addEventListener("click", handleEmailSelection);
	methodEmailInput?.addEventListener("change", handleEmailSelection);
	methodHandleInput?.addEventListener("click", handleHandleSelection);
	methodHandleInput?.addEventListener("change", handleHandleSelection);
	// setMethodFromInput();
	setSuggestionsEnabledByMethod();
	setSuffixFromMethod(false);
	combobox?.addEventListener("combobox-search", (e) => {
		const detail = (
			e as CustomEvent<{ query: string; results: Promise<Suggestion[]> | null }>
		).detail;
		const query = (detail?.query ?? "").trim();
		try {
			detail.results = searchBskyActors(query);
		} catch {
			// Keep form usable if search event detail is immutable for this environment.
		}
		// const method = detectMethod(query);
		// if (methodHandleInput && method === "handle") {
		// 	methodHandleInput.checked = true;
		// } else if (methodEmailInput) {
		// 	methodEmailInput.checked = true;
		// }
	});
	const form = emailInput?.closest("form");
	const redirectInput = form?.querySelector('input[name="redirect"]');
	const actionInput = form?.querySelector('input[name="action"]');
	form?.addEventListener("submit", () => {
		if (!emailInput) return;
		const identifier = emailInput.value.trim();
		const isHandle = detectMethod(identifier) === "handle";
		// Reset every field even when returning with Back or changing methods.
		form.setAttribute("method", isHandle ? "post" : "get");
		form.setAttribute(
			"action",
			isHandle ? "/oauth/login" : "https://leaflet.pub/api/auth/email-login",
		);
		emailInput.name = isHandle ? "atproto-id" : "email";
		emailInput.value = isHandle ? identifier.replace(/^@/, "") : identifier;
		if (redirectInput instanceof HTMLInputElement) {
			redirectInput.value = isHandle
				? "/subscribe"
				: "https://news.atmosphereconf.org";
		}
		if (actionInput instanceof HTMLInputElement)
			actionInput.disabled = isHandle;
	});
	document.getElementById("postcard-subscription-result")?.focus();
</script>
<style>
	form {
		display: grid;
		gap: 6px;
		--rounding: 16px;
	}

	label {
		font-size: 11px;
		font-weight: 700;
	}

	.segmented {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0;
		padding: 3px;
		border: 1px solid var(--ink);
		border-radius: var(--rounding);
		position: relative;
		overflow: hidden;
		isolation: isolate;
	}

	.segmented::before {
		content: "";
		position: absolute;
		top: 3px;
		left: 3px;
		width: calc(50% - 3px);
		height: calc(100% - 6px);
		background: var(--butter);
		border-radius: calc(var(--rounding) - 3px);
		transform: translateX(0);
		transition:
			transform 280ms cubic-bezier(0.22, 1, 0.36, 1),
			background-color 160ms ease;
		z-index: -1;
	}

	form:has(input ~ input:checked) .segmented::before {
		transform: translateX(calc(100%));
	}

	.segmented input[type="radio"] {
		position: absolute;
		opacity: 0;
		width: 1px;
		height: 1px;
		margin: 0;
		overflow: hidden;
		clip-path: inset(100%);
	}

	.segmented-option {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		padding: 2px 12px;
		border-radius: 999px;
		cursor: pointer;
		color: color-mix(in oklab, var(--ink) 70%, transparent);
		transition: color 220ms ease;
	}

	.segmented-text {
		display: inline-block;
		transition:
			transform 220ms ease,
			opacity 220ms ease;
	}

	.segmented-option:focus-visible {
		outline: 2px solid var(--strong);
		outline-offset: 2px;
	}

	input {
		border-radius: var(--rounding);
	}

	input[type="radio"]:checked + .segmented-option {
		color: var(--ink);
	}

	input[type="radio"]:checked + .segmented-option .segmented-text {
		transform: translateX(0);
		opacity: 1;
	}

	input[type="radio"] + .segmented-option .segmented-text {
		opacity: 0.8;
	}

	.segmented-icon {
		font-size: 13px;
		line-height: 1;
	}

	/* The triggers are rendered by <Tooltip>, so they carry that component's
	   scope, not this one's. The scoped `form` still confines these to us. */
	form:has(input[value="handle"]:checked) :global(.tooltip-button.handle),
	form:has(input[value="email"]:checked) :global(.tooltip-button.email) {
		color: var(--cancel-stamp);
	}

	.airmail-email-wrap {
		position: relative;
		--card: white;
	}

	.airmail-email-placeholder {
		position: absolute;
		left: 12px;
		top: 50%;
		transform: translateY(-50%);
		color: var(--ink);
		opacity: 0.65;
		pointer-events: none;
		z-index: 0;
		display: flex;
		height: calc(100% - 20px);
		--word-height: 18px;
		height: 100%;
		align-items: center;
	}

	.word-wrapper {
		display: inline-block;
		height: var(--word-height);
		overflow: hidden;
		vertical-align: baseline;
		margin-top: 1px;
	}

	.suffix-options {
		display: flex;
		flex-direction: column;
		animation: suffix-slide 3s normal cubic-bezier(0.85, 0, 0.15, 1);
	}

	.suffix-options > div {
		height: var(--word-height);
		line-height: var(--word-height);
		color: var(--ink);
	}

	@media (prefers-reduced-motion: reduce) {
		.suffix-options {
			animation: none;
			opacity: 1;
			transform: none;
		}
	}

	@keyframes suffix-slide {
		0%,
		15% {
			transform: translateY(0);
		}
		20%,
		35% {
			transform: translateY(calc(-1 * var(--word-height)));
		}
		40%,
		55% {
			transform: translateY(calc(-2 * var(--word-height)));
		}
		60%,
		75% {
			transform: translateY(calc(-3 * var(--word-height)));
		}
		100% {
			transform: translateY(calc(-3 * var(--word-height)));
		}
	}

	:global(#airmail-email)::placeholder {
		opacity: 0;
	}

	:global(
		form:has(#airmail-email:not(:placeholder-shown)) .airmail-email-placeholder
	) {
		opacity: 0;
	}

	:global(#airmail-email) {
		width: 100%;
		min-width: 0;
		min-height: 50px;
		padding: 10px 12px;
		border: 1px solid var(--ink);
		background-color: transparent;
		appearance: none;
		-webkit-appearance: none;
		color: var(--ink);
		font-size: 16px;
		position: relative;
		z-index: 1;
	}
	:global(#airmail-email-listbox) {
		padding-block: 10px;
		li {
			padding: 8px 10px;
		}
		li:hover {
			background: var(--butter);
			border-radius: var(--rounding);
		}
	}

	.tip {
		position: relative;
		font-weight: normal;
		/* Narrow-screen anchor: tooltips span the paragraph, as they did in flow. */
		anchor-name: --tip;
	}

	.subscription-result {
		margin: 4px 0 0;
		font-size: 13px;
		line-height: 1.4;
		overflow-wrap: anywhere;
	}

	.subscribe {
		display: flex;
		align-items: center;
		justify-content: space-between;
		min-height: 50px;
		padding: 12px 16px;
		border: 0;
		border-radius: var(--rounding);
		background: var(--strong);
		color: var(--paper);
		font-size: 14px;
		font-weight: 750;
	}

	.subscribe span {
		font-size: 24px;
	}
</style>
