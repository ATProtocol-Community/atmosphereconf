<button id="theme-toggle" aria-label="Toggle theme">
	<svg
		class="h-3.5 w-3.5"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		viewBox="0 0 24 24"
	>
		<circle cx="13.5" cy="6.5" r=".5" fill="currentColor"></circle>
		<circle cx="17.5" cy="10.5" r=".5" fill="currentColor"></circle>
		<circle cx="8.5" cy="7.5" r=".5" fill="currentColor"></circle>
		<circle cx="6.5" cy="12.5" r=".5" fill="currentColor"></circle>
		<path
			d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z"
		></path>
	</svg>
	<span id="theme-next-label" class="hidden w-16 truncate min-[880px]:block"
		>Sky</span
	>
</button>
<style>
	button {
		height: 28px;
		display: flex;
		align-items: center;
		border-radius: 999px;
		gap: 0;
		padding-inline: 6px;
		transition: colors;
		border: 1px solid var(--ink);
		color: var(--ink);
		background-color: transparent;
	}
</style>
<script is:inline>
	(() => {
		const themes = {
			sky: { label: "Sky", image: "goose" },
			garden: { label: "Garden", image: "goose" },
			colibri: { label: "Colibri", image: "colibri" },
			blacksky: { label: "Blacksky", image: "goose" },
			semble: { label: "Semble", image: "goose" },
			fujocoded: { label: "Fujocoded", image: "goose" },
		};

		const themeKeys = Object.keys(themes);
		const DEFAULT_THEME = "sky";
		const themeStorageKey = "2027:page-theme";

		const readStored = () => {
			try {
				return localStorage.getItem(themeStorageKey);
			} catch {
				return null;
			}
		};

		const writeStored = (value) => {
			try {
				localStorage.setItem(themeStorageKey, value);
			} catch {
				// swallow
			}
		};

		const normalize = (theme) => (themes[theme] ? theme : DEFAULT_THEME);

		const getCurrentTheme = () =>
			normalize(document.documentElement.dataset.theme || readStored());

		const getNextTheme = (theme) =>
			themeKeys[(themeKeys.indexOf(theme) + 1) % themeKeys.length];

		const syncGoose = (theme) => {
			const gooseImage = document.getElementById("goose-img");
			if (!gooseImage) return;

			const gooseSvg = document.getElementById("goose-svg");

			let imageData;
			try {
				imageData = JSON.parse(gooseImage.dataset.images || "{}");
			} catch {
				imageData = {};
			}

			const src = imageData[themes[theme].image];

			if (src) {
				if (gooseSvg) gooseSvg.style.display = "none";
				gooseImage.style.display = "block";
				gooseImage.src = src;
			} else if (gooseSvg) {
				gooseImage.style.display = "none";
				gooseSvg.style.display = "block";
			} else if (imageData.default) {
				gooseImage.style.display = "block";
				gooseImage.src = imageData.default;
			}
		};

		const applyTheme = (theme) => {
			const current = normalize(theme);

			document.documentElement.dataset.theme = current;
			document.body.dataset.palette = current;
			writeStored(current);

			const label = document.getElementById("theme-next-label");
			if (label) label.textContent = themes[getCurrentTheme()].label;

			syncGoose(current);
		};

		const cycleTheme = () => applyTheme(getNextTheme(getCurrentTheme()));

		const init = () => {
			document
				.getElementById("theme-toggle")
				?.addEventListener("click", cycleTheme);
			document
				.getElementById("theme-toggle-mobile")
				?.addEventListener("click", cycleTheme);

			applyTheme(getCurrentTheme());
		};

		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", init);
		} else {
			init();
		}
	})();
</script>
