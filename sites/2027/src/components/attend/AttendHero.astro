---
import Goose from "../../../images/guus/sitting.svg";
import cloud from "../../../images/clouds/long.svg?url";
import hall from "../../../images/photos/rijtuigenloods-hall.webp";

const facts = [
	{ term: "When", value: "29.04–02.05.2027" },
	{ term: "Where", value: "De Rijtuigenloods, Amersfoort, the Netherlands" },
];
---

<section
	class="relative isolate overflow-hidden bg-navy text-white"
	aria-labelledby="attend-title"
>
	<img
		class="absolute inset-0 -z-2 size-full object-cover"
		src={hall.src}
		alt=""
		width={hall.width}
		height={hall.height}
		fetchpriority="high"
	/>
	<div
		class="absolute inset-0 -z-1 bg-[linear-gradient(180deg,rgb(0_0_0/0.55)_0%,rgb(0_0_0/0.35)_45%,rgb(0_0_0/0)_75%)] md:bg-[linear-gradient(197deg,rgb(0_0_0/0)_40%,rgb(0_0_0/0.6)_87%)]"
		aria-hidden="true"
	>
	</div>
	<img
		class="absolute -right-30 -bottom-6 -z-1 h-auto w-110 max-md:hidden lg:left-[57.5%] lg:w-[735px]"
		src={cloud}
		alt=""
		width="735"
		height="272"
	/>
	<div
		class="wrap grid gap-16 pt-16 pb-10 md:min-h-150 md:grid-cols-[1fr_minmax(0,392px)] md:items-end md:gap-10 md:pt-30 md:pb-13 lg:min-h-172.5 lg:gap-16"
	>
		<div>
			<h1
				class="display text-[40px]/[1.33] md:text-[48px]/[1.33]"
				id="attend-title"
			>
				Attend
			</h1>
			<p class="mt-6 max-w-148 text-base/7 md:mt-8.5 md:text-xl/8">
				AtmosphereConf 2027 takes place in Amersfoort from Thursday 29 April to
				Sunday 2 May 2027, in De Rijtuigenloods.
			</p>
		</div>
		<div class="relative mt-36 md:mt-0">
			<Goose
				data-scene="attend-goose"
				class="absolute right-0 bottom-[calc(100%-20px)] z-1 h-auto w-36 md:-right-2 md:bottom-[calc(100%-28px)] md:w-50"
				aria-hidden="true"
			/>
			<div
				class="relative flex flex-col gap-8 rounded-lg bg-cream p-6 text-navy md:p-7"
			>
				<p class="flex items-center gap-2 eyebrow text-azure">
					<span class="size-2 bg-azure" aria-hidden="true"></span>
					Conference guide
				</p>
				<div>
					<h2 class="display text-lg/10 md:text-xl/10">
						Four days in Amersfoort
					</h2>
					<dl class="mt-3.5 border-t border-[#cdded0]">
						{
							facts.map(({ term, value }) => (
								<div class="mt-3.5 flex items-baseline justify-between gap-4">
									<dt class="eyebrow text-steel">{term}</dt>
									<dd class="text-right text-sm/5 text-balance">{value}</dd>
								</div>
							))
						}
					</dl>
				</div>
			</div>
		</div>
	</div>
</section>

<style is:global>
	[data-scene="attend-goose"] [data-part="upper"] {
		transform-origin: 105px 215px;
		animation: attend-goose-sway 3s ease-in-out infinite var(--play);
	}
	[data-scene="attend-goose"] [data-part="bonnet"] {
		transform-origin: 112px 62px;
		animation: attend-goose-bonnet 3s ease-in-out -0.3s infinite var(--play);
	}
	[data-scene="attend-goose"] [data-part="eye"] {
		transform-origin: 85.7px 49px;
		animation: attend-goose-blink 4.5s ease-in-out infinite var(--play);
	}
	[data-scene="attend-goose"] [data-part="clog-left"] {
		transform-origin: 66px 201px;
		animation: attend-goose-tap 6s ease-in-out infinite var(--play);
	}
	@keyframes attend-goose-sway {
		0%,
		100% {
			transform: translateY(0) rotate(0.8deg);
		}
		50% {
			transform: translateY(-3px) rotate(-1deg);
		}
	}
	@keyframes attend-goose-bonnet {
		0%,
		100% {
			transform: rotate(0.6deg);
		}
		50% {
			transform: rotate(-1deg);
		}
	}
	@keyframes attend-goose-blink {
		0%,
		95%,
		100% {
			transform: scaleY(1);
		}
		97% {
			transform: scaleY(0.1);
		}
	}
	@keyframes attend-goose-tap {
		0%,
		70%,
		80%,
		90%,
		100% {
			transform: rotate(0deg);
		}
		75%,
		85% {
			transform: rotate(-7deg);
		}
	}
</style>
