---
interface Props {
	color: string;
	class?: string;
	style?: string;
}

const { color, class: className, style } = Astro.props;
---

<svg
	class={className}
	style={style}
	viewBox="0 3 24 33"
	fill="none"
	aria-hidden="true"
>
	<path d="M12 20v28" stroke="#42874C" stroke-width="2.5" stroke-linecap="round" />
	<path d="M12 46c-7-3-9-11-7-17 4 4 7 9 7 17Z" fill="#13654B" />
	<path d="M4 7l4 5 4-7 4 7 4-5c1.5 9-1 15-8 15S2.5 16 4 7Z" fill={color} />
	<path d="M12 5l4 7 4-5c1.5 9-1 15-8 15Z" fill="#001941" opacity="0.14" />
</svg>
