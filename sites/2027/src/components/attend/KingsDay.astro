---
import Bicycle from "../../../images/illustrations/bycicle.svg";
import NumberedList from "../site/NumberedList.astro";

const options = [
	{
		lead: "If you like the party/crazy:",
		text: "arrive early and you’ll see the city at its busiest and most orange.",
	},
	{ lead: "If you prefer to avoid that:", text: "arrive on the 28th." },
];
---

<section class="bg-navy text-white" aria-labelledby="kings-day-title">
	<div
		class="wrap grid gap-10 pt-16 pb-12 md:grid-cols-2 md:items-center md:gap-12 md:pt-20 md:pb-16 lg:gap-19 lg:pt-30 lg:pb-24"
	>
		<h2 class="title" id="kings-day-title">
			King’s Day falls on Tuesday 27 April, two days before we start.
		</h2>
		<NumberedList items={options} />
	</div>
	<Bicycle
		data-scene="bicycle"
		class="h-auto w-full max-md:min-h-47.5"
		preserveAspectRatio="xMidYMid slice"
		role="img"
		aria-label="A goose cycling past tulips with a basket of flowers, under a string of orange bunting"
	/>
</section>

<script>
	import { reducedMotionQuery } from "../lib/motion";

	for (const scene of document.querySelectorAll<SVGSVGElement>(
		'svg[data-scene="bicycle"]',
	)) {
		const sync = () => {
			if (reducedMotionQuery.matches) {
				scene.pauseAnimations();
				scene.setCurrentTime(0);
			} else if (scene.hasAttribute("data-playing")) {
				scene.unpauseAnimations();
			} else {
				scene.pauseAnimations();
			}
		};
		scene.pauseAnimations();
		scene.setCurrentTime(0);
		new MutationObserver(sync).observe(scene, {
			attributes: true,
			attributeFilter: ["data-playing"],
		});
		reducedMotionQuery.addEventListener("change", sync);
		sync();
	}
</script>

<style is:global>
