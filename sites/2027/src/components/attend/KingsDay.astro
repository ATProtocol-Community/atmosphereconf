			transform: skewX(0deg) scaleY(1);
		}
	}
	@keyframes bike-bob {
		50% {
			translate: 0 -1.5px;
		}
	}
	@keyframes bike-sway {
		0%,
		100% {
			rotate: -1deg;
		}
		50% {
			rotate: 1deg;
		}
	}
	@keyframes bike-basket {
		0%,
		100% {
			rotate: -3deg;
		}
		50% {
			rotate: 3deg;
		}
	}
	@keyframes bike-flutter {
		0%,
		100% {
			transform: rotate(var(--e)) skewX(-7deg) rotate(calc(var(--e) * -1));
		}
		50% {
			transform: rotate(var(--e)) skewX(7deg) rotate(calc(var(--e) * -1));
		}
	}
	@keyframes bike-dot-slide {
		0% {
			translate: var(--in) 0;
			animation-timing-function: cubic-bezier(0.5, 0, 0.9, 0.6);
		}
		9% {
			translate: var(--out) 0;
			animation-timing-function: ease-out;
		}
		12% {
			translate: calc(var(--out) - 1.8px) 0;
			animation-timing-function: ease-in;
		}
		15%,
		50% {
			translate: var(--out) 0;
			animation-timing-function: cubic-bezier(0.5, 0, 0.9, 0.6);
		}
		59% {
			translate: var(--in) 0;
			animation-timing-function: ease-out;
		}
		62% {
			translate: calc(var(--in) + 1.8px) 0;
			animation-timing-function: ease-in;
		}
		65%,
		100% {
			translate: var(--in) 0;
		}
	}
	@keyframes bike-scroll {
		100% {
			transform: translateX(-1440px);
		}
	}
	[data-scene="bicycle"] [data-part="spokes-front"],
	[data-scene="bicycle"] [data-part="spokes-rear"] {
		animation: bike-spin 1.85s linear infinite var(--play);
	}
	[data-scene="bicycle"] [data-part="dot-slide"] {
		animation: bike-dot-slide 1.85s linear calc(var(--lag) * -1) infinite
			var(--play);
	}
	[data-scene="bicycle"] [data-part="crank-near"],
	[data-scene="bicycle"] [data-part="crank-far"] {
		animation: bike-crank 2.6s linear infinite var(--play);
	}
	[data-scene="bicycle"] [data-part="pedal-near"],
	[data-scene="bicycle"] [data-part="pedal-far"] {
		animation: bike-crank-counter 2.6s linear infinite var(--play);
	}
	[data-scene="bicycle"] [data-part="leg-near"] {
		animation: bike-leg-near 2.6s linear infinite var(--play);
	}
	[data-scene="bicycle"] [data-part="leg-far"] {
		animation: bike-leg-far 2.6s linear infinite var(--play);
	}
	[data-scene="bicycle"] [data-part="rider"] {
		animation:
			bike-bob 1.3s ease-in-out infinite var(--play),
			bike-sway 2.6s ease-in-out -0.65s infinite var(--play);
	}
	[data-scene="bicycle"] [data-part="basket-flowers"] {
		animation: bike-basket 2.6s ease-in-out -0.65s infinite var(--play);
	}
	[data-scene="bicycle"] [data-part="pennant"] {
		animation: bike-flutter 2.2s ease-in-out calc(var(--i) * -0.3s - 0.55s)
			infinite var(--play);
	}
	[data-scene="bicycle"] [data-part="scroll"] {
		animation: bike-scroll 8s linear infinite var(--play);
	}
</style>
