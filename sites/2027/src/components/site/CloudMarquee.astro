---
import "marqy/dist/marqy.css";
import puffy from "../../../images/clouds/puffy.svg?url";
import bumpy from "../../../images/clouds/bumpy.svg?url";
import long from "../../../images/clouds/long.svg?url";

interface Props {
	variant?: "a" | "b" | "c";
	class?: string;
	loading?: "lazy" | "eager";
	backSpeed?: number;
	frontSpeed?: number;
	drift?: "right" | "left";
}

const shapes = {
	puffy: { src: puffy, width: 451, height: 196 },
	bumpy: { src: bumpy, width: 449, height: 195 },
	long: { src: long, width: 735, height: 272 },
};

type Shape = keyof typeof shapes;
type Item = {
	shape: Shape;
	h: number;
	gap: number;
	lift: number;
	flip: boolean;
};

const item = (
	shape: Shape,
	h: number,
	gap: number,
	lift = 0,
	flip = false,
): Item => ({ shape, h, gap, lift, flip });

const variants: Record<"a" | "b" | "c", { front: Item[]; back: Item[] }> = {
	a: {
		front: [
			item("puffy", 0.6, 0.55),
			item("long", 0.52, 0.95),
			item("bumpy", 0.48, 0.7, 0, true),
			item("puffy", 0.42, 0.85),
		],
		back: [
			item("bumpy", 0.3, 0.8, 0.42),
			item("puffy", 0.34, 1, 0.5, true),
			item("long", 0.28, 0.7, 0.46),
			item("puffy", 0.26, 0.9, 0.4),
			item("bumpy", 0.32, 0.85, 0.48, true),
		],
	},
	b: {
		front: [
			item("long", 0.52, 0.95, 0, true),
			item("puffy", 0.42, 0.85, 0, true),
			item("puffy", 0.6, 0.55, 0, true),
			item("bumpy", 0.48, 0.7),
		],
		back: [
			item("long", 0.28, 0.7, 0.46, true),
			item("bumpy", 0.32, 0.85, 0.48),
			item("bumpy", 0.3, 0.8, 0.42, true),
			item("puffy", 0.26, 0.9, 0.4, true),
			item("puffy", 0.34, 1, 0.5),
		],
	},
	c: {
		front: [
			item("long", 0.56, 0.8),
			item("puffy", 0.46, 0.7),
			item("puffy", 0.6, 0.7, 0, true),
			item("bumpy", 0.4, 0.8),
		],
		back: [
			item("bumpy", 0.3, 0.8, 0.44),
			item("puffy", 0.34, 1, 0.52, true),
			item("long", 0.28, 0.7, 0.4),
			item("puffy", 0.26, 0.9, 0.48),
			item("bumpy", 0.32, 0.85, 0.42, true),
		],
	},
};

const {
	variant = "a",
	class: className,
	loading = "eager",
	backSpeed = 0.18,
	frontSpeed = 0.32,
	drift = "right",
} = Astro.props;

const { front, back } = variants[variant];
const strips = [
	{ items: back, speed: backSpeed, layer: "back" },
	{ items: front, speed: frontSpeed, layer: "front" },
];
---

<div
	class:list={[
		"cloud-band pointer-events-none absolute inset-x-0 -bottom-1 h-(--cloud-band)",
		className,
	]}
	data-cloud-band
	data-drift={drift}
	aria-hidden="true"
>
	{
		strips.map(({ items, speed, layer }) => (
			<marqy-loop class="cloud-strip" data-cloud-layer={layer} speed={speed}>
				<div class="cloud-row">
					{items.map(({ shape, h, gap, lift, flip }) => (
						<img
							class:list={["cloud", flip && "-scale-x-100"]}
							style={`--h:${h};--gap:${gap};--lift:${lift}`}
							src={shapes[shape].src}
							width={shapes[shape].width}
							height={shapes[shape].height}
							alt=""
							loading={loading}
						/>
					))}
				</div>
			</marqy-loop>
		))
	}
</div>

<style is:global>
	.cloud-band .cloud-strip {
		position: absolute;
		inset-inline: 0;
		bottom: 0;
		display: block;
	}
	.cloud-band [data-cloud-layer="back"] {
		opacity: 0.65;
	}
	.cloud-band .cloud-row {
		display: flex;
		align-items: flex-end;
		height: var(--cloud-band);
	}
	.cloud-band .cloud {
		height: calc(var(--cloud-band) * var(--h));
		width: auto;
		margin-right: calc(var(--cloud-band) * var(--gap));
		margin-bottom: calc(var(--cloud-band) * var(--lift, 0));
		flex: none;
	}
	.cloud-band marqy-loop[data-marqy][data-direction] [data-marqy-inner] {
		overflow: visible;
	}
	.cloud-band:not([data-drift="left"])
		marqy-loop[data-marqy][data-direction]
		[data-marqy-content] {
		animation-name: cloud-drift;
	}
	.cloud-band:not([data-playing]) marqy-loop[data-marqy] [data-marqy-content] {
		animation-play-state: paused;
	}
	@keyframes cloud-drift {
		from {
			transform: translate3d(-100%, 0, 0);
		}
		to {
			transform: none;
		}
	}
</style>

<script>
	import "marqy/vanilla";
	import { playWhileVisible } from "../lib/motion";

	document
		.querySelectorAll<HTMLElement>("[data-cloud-band]")
		.forEach((band) => playWhileVisible(band));
</script>
