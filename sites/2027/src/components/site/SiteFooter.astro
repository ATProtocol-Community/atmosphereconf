					calc(-1.4139 * var(--loop-radius))
				)
				rotate(127.591deg);
		}
		60.86364% {
			transform: translate(
					calc(-2.31363 * var(--loop-radius)),
					calc(-1.6375 * var(--loop-radius))
				)
				rotate(150.35deg);
		}
