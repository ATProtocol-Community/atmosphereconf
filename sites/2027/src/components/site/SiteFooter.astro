				)
				rotate(353.148deg);
		}
		65.58429% {
			transform: translate(
					calc(-0.61387 * var(--loop-radius)),
					calc(0.2244 * var(--loop-radius))
				)
				rotate(360.907deg);
		}
		66.69181% {
			transform: translate(
					calc(-0.37088 * var(--loop-radius)),
					calc(0.1726 * var(--loop-radius))
				)
				rotate(364.404deg);
		}
		67.79933% {
			transform: translate(
