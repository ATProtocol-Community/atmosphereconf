			transform: translate(
					calc(-1.21713 * var(--loop-radius)),
					calc(0.3494 * var(--loop-radius))
				)
				rotate(-12.535deg);
		}
		57.83333% {
			transform: translate(
					calc(-1.52238 * var(--loop-radius)),
					calc(0.3428 * var(--loop-radius))
				)
				rotate(-5.441deg);
		}
		58.21212% {
			transform: translate(
					calc(-1.87663 * var(--loop-radius)),
					calc(0.3053 * var(--loop-radius))
				)
				rotate(6.679deg);
		}
		58.59091% {
			transform: translate(
					calc(-2.21137 * var(--loop-radius)),
					calc(0.2175 * var(--loop-radius))
				)
				rotate(22.306deg);
		}
		58.96970% {
			transform: translate(
					calc(-2.45675 * var(--loop-radius)),
					calc(0.0595 * var(--loop-radius))
				)
				rotate(39.919deg);
		}
		59.34848% {
			transform: translate(
					calc(-2.57912 * var(--loop-radius)),
					calc(-0.2089 * var(--loop-radius))
				)
				rotate(58.967deg);
		}
		59.72727% {
			transform: translate(
