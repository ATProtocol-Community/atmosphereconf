		}
		73.33693% {
			transform: translate(
					calc(0.06938 * var(--loop-radius)),
					calc(-0.0199 * var(--loop-radius))
				)
				rotate(361.048deg);
		}
		74.44444% {
			transform: translate(
					calc(0 * var(--loop-radius)),
					calc(0 * var(--loop-radius))
				)
				rotate(360deg);
		}
		100% {
			transform: translate(0, 0) rotate(360deg);
		}
	}
	[data-scene="footer-goose"] [data-part="goose"] {
		transform-origin: 160px 150px;
		animation: footer-goose-bob 1.1s ease-in-out -0.275s infinite var(--play);
	}
	[data-scene="footer-goose"] [data-part="wing-near"],
	[data-scene="footer-goose"] [data-part="wing-far"] {
		animation: footer-goose-flap 1.1s ease-in-out infinite var(--play);
	}
	@keyframes footer-goose-bob {
		0%,
		100% {
			transform: translateY(0) rotate(-1.5deg);
		}
		50% {
			transform: translateY(-7px) rotate(1.5deg);
		}
	}
	@keyframes footer-goose-flap {
		0%,
		100% {
			transform: rotate(-6deg);
		}
		50% {
			transform: rotate(20deg);
		}
	}
</style>
