---
import FlyingGoose from "../../../images/guus/flying.svg";
import heart from "../../../images/logo/heart.svg?url";
import { event } from "../../data/event";
import CloudMarquee from "./CloudMarquee.astro";

const navList =
	"*:mb-4.75 [&>*:last-child]:mb-0 [&>a]:block [&>a]:w-fit [&>a]:text-base/6 md:[&>a]:text-lg [&>a:hover]:underline [&>a:hover]:underline-offset-4";
const navTitle = "eyebrow before:mr-2 before:content-['▪']";
const comingSoon = "block cursor-not-allowed text-lg opacity-65";
---

<footer
	class="relative overflow-hidden text-white [--cloud-band:150px] sky-gradient max-md:min-h-162.5 md:[--cloud-band:220px] lg:[--cloud-band:240px]"
>
	<div
		class="relative z-1 wrap pt-16 pb-[calc(var(--cloud-band)+24px)] md:pt-30"
	>
		<div
			class="grid grid-cols-2 gap-10 md:grid-cols-[1fr_150px_150px] md:gap-6 lg:grid-cols-[1fr_204px_204px]"
		>
			<div class="max-md:col-span-full">
				<dl class="mb-6 flex gap-6 text-left md:gap-12">
					<div>
						<dt class="eyebrow">Dates</dt><dd class="mt-1 text-sm uppercase">
							{event.dates}
						</dd>
					</div><div>
						<dt class="eyebrow">Where</dt><dd class="mt-1 text-sm uppercase">
							{event.venue}
						</dd>
					</div>
				</dl><div class="flex flex-wrap gap-2">
					<a class="btn" href="/#tickets"
						>Early-bird tickets <span aria-hidden="true">▸</span></a
					>
				</div>
			</div><nav class={navList} aria-label="Conference">
				<h2 class={navTitle}>Join Atmo27</h2><a href="/attend">Attend</a><a
					href="/speak">Call for presentations</a
				>
			</nav><nav class={navList} aria-label="Community">
				<h2 class={navTitle}>Community</h2><a
					href="https://bsky.app/profile/did:plc:3xewinw4wtimo2lqfy5fm5sw"
					>Bluesky</a
				><a href="https://github.com/ATProtocol-Community/atmosphereconf"
					>GitHub</a
				>
				<span class={comingSoon} role="link" aria-disabled="true">YouTube</span
				><span class={comingSoon} role="link" aria-disabled="true"
					>LinkedIn</span
				>
			</nav>
		</div>
		<p
			class="mt-14 flex flex-wrap items-center gap-3 font-display text-[27px] leading-[1.3] uppercase md:mt-30 md:flex-nowrap md:gap-[0.25em] md:text-[clamp(20px,5.4vw,78px)]/26.5 md:whitespace-nowrap"
		>
			<span class="max-md:basis-full">Atmosphere Conf</span><img
				class="w-16.25 md:w-[12%]"
				src={heart}
				alt=""
				width="206"
				height="129"
			/><span>2027</span>
		</p><p class="mt-6 text-xs/5 md:text-sm">
			Copyright 2026 © Atmosphere Conference
		</p>
	</div>
	<CloudMarquee variant="b" loading="lazy" class="footer-clouds" />
	<FlyingGoose
		data-scene="footer-goose"
		class="pointer-events-none absolute right-[28%] bottom-[calc(var(--cloud-band)*0.34)] z-1 h-auto w-24 md:w-28 lg:w-32"
		aria-hidden="true"
	/>
</footer>

<style is:global>
	.footer-clouds .cloud-strip:last-child {
		z-index: 2;
	}
	[data-scene="footer-goose"] {
		--loop-radius: 28px;
		transform-origin: 50% 50%;
		animation: footer-goose-loop 18s linear infinite var(--play);
	}
	@media (min-width: 768px) {
		[data-scene="footer-goose"] {
			--loop-radius: 72px;
		}
	}
	@keyframes footer-goose-loop {
		0%,
		55.00000% {
			transform: translate(0, 0) rotate(0deg);
		}
		55.48828% {
			transform: translate(
					calc(-0.08212 * var(--loop-radius)),
					calc(0.0348 * var(--loop-radius))
				)
				rotate(-1.957deg);
		}
		55.97656% {
			transform: translate(
					calc(-0.295 * var(--loop-radius)),
					calc(0.1185 * var(--loop-radius))
				)
				rotate(-6.371deg);
		}
		56.46484% {
			transform: translate(
					calc(-0.5885 * var(--loop-radius)),
					calc(0.2197 * var(--loop-radius))
				)
				rotate(-11.061deg);
		}
		56.95312% {
			transform: translate(
					calc(-0.91263 * var(--loop-radius)),
					calc(0.3071 * var(--loop-radius))
				)
