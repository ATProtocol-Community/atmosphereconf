---
import Airplane from "../../../images/airplane.svg";
import puffy from "../../../images/clouds/puffy.svg?url";
import bumpy from "../../../images/clouds/bumpy.svg?url";
import long from "../../../images/clouds/long.svg?url";
import stamp from "../../../images/illustrations/stamp.svg?url";
import postmark from "../../../images/postmark.svg?url";
import FlyingGoose from "../../../images/guus/flying.svg";
import sittingGoose from "../../../images/guus/sitting.svg?url";
import CloudMarquee from "./CloudMarquee.astro";
import { latestNews } from "../lib/news";

const posts = await latestNews();

const format = (options: Intl.DateTimeFormatOptions) =>
	new Intl.DateTimeFormat("en-GB", { timeZone: "UTC", ...options });
const fullDate = format({ day: "numeric", month: "long", year: "numeric" });
const day = format({ day: "numeric" });
const month = format({ month: "short" });
const year = format({ year: "numeric" });

const cards = posts.map((post, index) => ({
	...post,
	id: `airmail-card-${index}`,
	date: fullDate.format(post.publishedAt),
	day: day.format(post.publishedAt),
	month: month.format(post.publishedAt),
	year: year.format(post.publishedAt),
}));
---

{
	cards.length > 0 && (
		<section
			class="airmail relative overflow-hidden pt-36 pb-16 [--cloud-band:170px] md:pt-52 md:pb-20 md:[--cloud-band:240px]"
			aria-labelledby="airmail-title"
			data-airmail
		>
			<div
				class="airmail-sky pointer-events-none absolute inset-0"
				data-scene="airmail-sky"
				aria-hidden="true"
			>
				<div class="airmail-gradient" data-part="gradient" />
				<img
					class="airmail-cloud drift-far top-10 left-[16%] w-30 opacity-45 md:w-55"
					data-part="cloud"
					src={bumpy}
					alt=""
					width="449"
					height="195"
					loading="lazy"
				/>
				<img
					class="airmail-cloud drift-far top-75 right-[20%] w-45 opacity-40 max-md:hidden"
					data-part="cloud"
					src={puffy}
					alt=""
					width="451"
					height="196"
					loading="lazy"
				/>
				<img
					class="airmail-cloud drift-mid top-80 -right-25 w-60 opacity-85 md:top-100 md:w-80 lg:top-42 lg:-right-24 lg:w-90"
					data-part="cloud"
					src={long}
					alt=""
					width="735"
					height="272"
					loading="lazy"
				/>
				<img
					class="airmail-cloud drift-mid top-108 -left-28 w-95 max-md:hidden"
					data-part="cloud"
					src={puffy}
					alt=""
					width="451"
					height="196"
					loading="lazy"
				/>
				<img
					class="airmail-cloud drift-near bottom-[calc(var(--cloud-band)+120px)] -left-22 w-65 md:hidden"
					data-part="cloud"
					src={puffy}
					alt=""
					width="451"
					height="196"
					loading="lazy"
				/>
				<div class="absolute top-2 left-[4%] w-[min(593px,70vw)] md:top-4 md:left-[22%] md:w-[min(430px,34vw)]">
					<Airplane
						data-scene="airplane"
						class="h-auto w-full overflow-visible"
						aria-hidden="true"
					/>
				</div>
			</div>

			<div class="relative wrap flex flex-col items-center text-center">
				<p class="eyebrow text-white">from the organizers</p>
				<h2 class="mt-3 title text-white" id="airmail-title">
					News by airmail
				</h2>
			</div>

			<div class="relative z-1 wrap">
				<div
					class="airmail-pile relative mx-auto mt-10 h-150 w-full max-w-90 md:mt-12 lg:h-135 lg:max-w-245"
					role="group"
					aria-roledescription="postcard stack"
					aria-label="News postcards"
					data-airmail-pile
				>
					{cards.map((card, index) => (
						<article
							class="airmail-card"
							aria-labelledby={`${card.id}-title`}
							data-airmail-card
							data-pile={index}
							data-title={card.title}
							inert={index !== 0}
						>
							<div class="airmail-picture">
								{card.cover ? (
									<img
										class="size-full object-contain"
										src={card.cover}
										alt=""
										loading={index === 0 ? "eager" : "lazy"}
										decoding="async"
									/>
								) : (
									<img
										class="h-3/4 w-auto object-contain"
										src={sittingGoose}
										alt=""
										width="201"
										height="250"
										loading="lazy"
									/>
								)}
							</div>
							<img
								class="airmail-stamp"
								src={stamp}
								alt=""
								width="381"
								height="489"
								loading="lazy"
							/>
							<div class="airmail-date" aria-hidden="true">
								<span>{card.day}</span>
								<span class="airmail-date-month">{card.month}</span>
								<span>{card.year}</span>
							</div>
							<img
								class="airmail-postmark"
								src={postmark}
								alt=""
								width="150"
								height="75"
								loading="lazy"
							/>
							<div class="airmail-message">
								<p class="eyebrow text-slate">Postmarked {card.date}</p>
								<h3 class="airmail-title display" id={`${card.id}-title`}>
									{card.title}
								</h3>
								{card.description && (
									<p class="airmail-description text-slate">
										{card.description}
									</p>
								)}
								<div class="mt-auto flex flex-col gap-1">
									<p class="border-b border-line pb-1.5 text-sm text-slate">
										To: everyone in the Atmosphere
									</p>
									<a
										class="inline-flex min-h-11 items-center gap-1.5 text-[15px] font-semibold text-azure underline-offset-4 hover:text-navy hover:underline"
										href={card.url}
									>
										Read the full post <span aria-hidden="true">▸</span>
									</a>
								</div>
							</div>
						</article>
					))}
					<div class="airmail-goose pointer-events-none absolute -right-8 -bottom-28 z-120 w-50 max-lg:hidden">
						<FlyingGoose
							data-scene="airmail-goose"
							class="h-auto w-full"
							aria-hidden="true"
						/>
					</div>
				</div>

				<p class="sr-only" aria-live="polite" data-airmail-live />

				{cards.length > 1 && (
					<div
						class="mx-auto mt-12 flex w-fit items-center gap-2 rounded-md bg-cream p-1.5 shadow-[0_12px_28px_-16px_rgb(0_25_65/0.5)] md:mt-14"
						data-airmail-controls
						hidden
					>
						<button
							class="btn btn-outline"
							type="button"
							data-airmail-newer
							disabled
						>
							<span aria-hidden="true">◂</span> Newer
						</button>
						<span
							class="min-w-16 text-center text-sm text-navy"
							data-airmail-counter
						>
							1 of {cards.length}
						</span>
						<button class="btn" type="button" data-airmail-older>
							Older <span aria-hidden="true">▸</span>
						</button>
					</div>
				)}
			</div>

			<CloudMarquee variant="b" loading="lazy" drift="left" />
		</section>
	)
}

<script>
	import { paperPlane } from "../lib/paper-plane";
	import { prefersReducedMotion } from "../lib/motion";

	const SETTLE_MS = 180;
	const MOVE_MS = 580;
	const FADE_MS = 240;
	const SWIPE_PX = 50;

	const section = document.querySelector<HTMLElement>("[data-airmail]");
	const airplane = section?.querySelector<SVGSVGElement>(
		'svg[data-scene="airplane"]',
	);
	if (airplane) paperPlane(airplane);

	const pile = section?.querySelector<HTMLElement>("[data-airmail-pile]");
	const controls = section?.querySelector<HTMLElement>(
		"[data-airmail-controls]",
	);
	const newer = section?.querySelector<HTMLButtonElement>(
		"[data-airmail-newer]",
	);
	const older = section?.querySelector<HTMLButtonElement>(
		"[data-airmail-older]",
	);
	const counter = section?.querySelector("[data-airmail-counter]");
	const live = section?.querySelector("[data-airmail-live]");
	const cards = Array.from(
		section?.querySelectorAll<HTMLElement>("[data-airmail-card]") ?? [],
	);

	if (section && pile && controls && newer && older && counter && live) {
		let order = cards.map((_, index) => index);
		let busy = false;
		const last = cards.length - 1;

		const render = () => {
			order.forEach((card, position) => {
				cards[card]!.dataset.pile = String(position);
				cards[card]!.inert = position !== 0;
			});
			const front = order[0]!;
			counter.textContent = `${front + 1} of ${cards.length}`;
			newer.disabled = front === 0;
			older.disabled = front === last;
		};

		const announce = () => {
			const front = order[0]!;
			live.textContent = `Postcard ${front + 1} of ${cards.length}: ${cards[front]!.dataset.title}`;
		};

		const move = (direction: "older" | "newer") => {
			const front = order[0]!;
			if (busy || (direction === "older" ? front === last : front === 0)) {
				return;
			}
			busy = true;
			const moving =
				direction === "older" ? order[0]! : order[order.length - 1]!;
			const next =
				direction === "older"
					? [...order.slice(1), order[0]!]
					: [order[order.length - 1]!, ...order.slice(0, -1)];
			const settle = () => {
				order = next;
				render();
				announce();
			};

			if (prefersReducedMotion()) {
				pile.dataset.fading = "";
				setTimeout(() => {
					settle();
					delete pile.dataset.fading;
					busy = false;
				}, FADE_MS);
				return;
			}

			cards[moving]!.dataset.flying =
				direction === "older" ? "front" : "behind";
			setTimeout(() => {
				delete cards[moving]!.dataset.flying;
				settle();
			}, SETTLE_MS);
			setTimeout(() => {
				busy = false;
			}, MOVE_MS);
		};

		newer.addEventListener("click", () => move("newer"));
		older.addEventListener("click", () => move("older"));

		section.addEventListener("keydown", (event) => {
			if (event.target instanceof HTMLInputElement) return;
			if (event.key === "ArrowRight") move("older");
			if (event.key === "ArrowLeft") move("newer");
		});

		let swipeStart: number | null = null;
		pile.addEventListener("pointerdown", (event) => {
			swipeStart = event.clientX;
		});
		pile.addEventListener("pointercancel", () => {
			swipeStart = null;
		});
		pile.addEventListener("pointerup", (event) => {
			if (swipeStart === null) return;
			const distance = event.clientX - swipeStart;
			swipeStart = null;
			if (distance <= -SWIPE_PX) move("older");
			if (distance >= SWIPE_PX) move("newer");
		});

		controls.hidden = false;
		render();
	}
</script>

<style>
	.airmail-gradient {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			180deg,
			#005fe2 0%,
			#7d7cd8 42%,
			#ea97df 77%,
			#eb9b9b 100%
		);
		background-size: 100% 135%;
		animation: airmail-sky-shift 26s ease-in-out infinite alternate;
	}

	.airmail-cloud {
		position: absolute;
		height: auto;
	}

	.drift-far {
		animation: airmail-drift 140s ease-in-out infinite alternate;
	}

	.drift-mid {
		animation: airmail-drift 90s ease-in-out infinite alternate-reverse;
	}

	.drift-near {
		animation: airmail-drift 55s ease-in-out infinite alternate;
	}

	@keyframes airmail-sky-shift {
		from {
			background-position: 50% 0%;
		}
		to {
			background-position: 50% 100%;
		}
	}

	@keyframes airmail-drift {
		from {
			translate: -60px 0;
		}
		to {
			translate: 60px 0;
		}
	}

	.airmail-pile {
		touch-action: pan-y;
		transition: opacity 240ms ease;
	}

	.airmail-pile[data-fading] {
		opacity: 0;
	}

	.airmail-card {
		--spread: 0.5;
		--dx: 0px;
		--dy: 0px;
		--rot: 0deg;
		--scale: 1;
		--shadow: 0 18px 36px -22px rgb(0 25 65 / 0.45);
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		padding: 12px;
		border-radius: 6px;
		background: var(--color-cream);
		color: var(--color-navy);
		text-align: left;
		box-shadow: var(--shadow);
		transform: translate(calc(var(--dx) * var(--spread)), var(--dy))
			rotate(var(--rot)) scale(var(--scale));
		transition:
			transform 400ms var(--ease-soft),
			box-shadow 400ms var(--ease-soft);
		will-change: transform;
	}

	.airmail-card[data-pile="0"] {
		--rot: -1.2deg;
		--shadow: 0 36px 72px -28px rgb(0 25 65 / 0.6);
		z-index: 50;
	}

	.airmail-card[data-pile="1"] {
		--dx: 22px;
		--dy: 8px;
		--rot: 2.6deg;
		--scale: 0.985;
		z-index: 49;
	}

	.airmail-card[data-pile="2"] {
		--dx: -26px;
		--dy: 14px;
		--rot: -3.4deg;
		--scale: 0.97;
		z-index: 48;
	}

	.airmail-card[data-pile="3"] {
		--dx: 34px;
		--dy: 20px;
		--rot: 4.2deg;
		--scale: 0.955;
		z-index: 47;
	}

	.airmail-card[data-pile="4"] {
		--dx: -12px;
		--dy: 24px;
		--rot: -2.2deg;
		--scale: 0.94;
		z-index: 46;
	}

	.airmail-card[data-flying] {
		--shadow: 0 40px 80px -30px rgb(0 25 65 / 0.55);
		transform: translate(-115%, -30px) rotate(-16deg) scale(0.96);
	}

	.airmail-card[data-flying="front"] {
		z-index: 100;
	}

	.airmail-card[data-flying="behind"] {
		z-index: 1;
	}

	.airmail-picture {
		display: flex;
		flex: none;
		align-items: center;
		justify-content: center;
		height: 210px;
		padding: 10px;
		border-radius: 3px;
		background: #efe7db;
	}

	.airmail-stamp {
		position: absolute;
		top: 178px;
		right: 8px;
		width: 62px;
		height: auto;
		rotate: 5deg;
	}

	.airmail-date {
		position: absolute;
		top: 186px;
		right: 82px;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		width: 72px;
		height: 72px;
		border: 2px solid var(--color-azure);
		border-radius: 999px;
		background: rgb(250 247 242 / 0.35);
		color: var(--color-azure);
		font-size: 9px;
		font-weight: 600;
		line-height: 1.3;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		rotate: -12deg;
	}

	.airmail-date-month {
		font-size: 14px;
	}

	.airmail-postmark {
		display: none;
	}

	.airmail-message {
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: 12px;
		min-height: 0;
		margin-top: 30px;
		padding: 16px 4px 4px;
		border-top: 2px dashed var(--color-line);
	}

	.airmail-title {
		display: -webkit-box;
		overflow: hidden;
		font-size: 16px;
		line-height: 1.6;
		text-wrap: balance;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
	}

	.airmail-description {
		display: -webkit-box;
		overflow: hidden;
		font-size: 15px;
		line-height: 1.5;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
	}

	@media (min-width: 1101px) {
		.airmail-card {
			--spread: 1;
			display: grid;
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
			padding: 20px;
		}

		.airmail-picture {
			height: auto;
			padding: 14px;
		}

		.airmail-stamp {
			top: 20px;
			right: 20px;
			width: 92px;
			rotate: 4deg;
		}

		.airmail-date {
			top: 30px;
			right: 132px;
			width: 96px;
			height: 96px;
			font-size: 11px;
		}

		.airmail-date-month {
			font-size: 18px;
		}

		.airmail-postmark {
			position: absolute;
			top: 46px;
			right: 244px;
			display: block;
			width: 130px;
			height: auto;
			rotate: -6deg;
		}

		.airmail-message {
			gap: 16px;
			margin: 0 0 0 28px;
			padding: 150px 8px 8px 36px;
			border-top: 0;
			border-left: 2px dashed var(--color-line);
		}

		.airmail-title {
			font-size: 22px;
			line-height: 1.55;
		}

		.airmail-description {
			font-size: 17px;
			line-height: 1.6;
			-webkit-line-clamp: 4;
		}
	}

	.airmail-goose {
		animation: airmail-glide 6s ease-in-out infinite alternate;
	}

	.airmail-goose :global([data-part="goose"]) {
		transform-origin: 160px 150px;
		animation: airmail-goose-bob 1.1s cubic-bezier(0.45, 0, 0.55, 1) -0.275s
			infinite var(--play);
	}

	.airmail-goose :global([data-part="wing-near"]),
	.airmail-goose :global([data-part="wing-far"]) {
		animation: airmail-goose-flap 1.1s cubic-bezier(0.45, 0, 0.55, 1) infinite
			var(--play);
	}

	.airmail-goose :global([data-part="leg-near"]) {
		animation: airmail-goose-dangle 1.1s cubic-bezier(0.45, 0, 0.55, 1) infinite
			var(--play);
	}

	.airmail-goose :global([data-part="leg-far"]) {
		animation: airmail-goose-dangle 1.1s cubic-bezier(0.45, 0, 0.55, 1) -0.12s
			infinite var(--play);
	}

	@keyframes airmail-glide {
		from {
			translate: 0 0;
			rotate: -2deg;
		}
		to {
			translate: -24px 14px;
			rotate: 2deg;
		}
	}

	@keyframes airmail-goose-bob {
		0%,
		100% {
			transform: translateY(0) rotate(-1.5deg);
		}
		50% {
			transform: translateY(-7px) rotate(1.5deg);
		}
	}

	@keyframes airmail-goose-flap {
		0%,
		100% {
			transform: rotate(-6deg);
		}
		50% {
			transform: rotate(20deg);
		}
	}

	@keyframes airmail-goose-dangle {
		0%,
		100% {
			transform: rotate(-4deg);
		}
		50% {
			transform: rotate(5deg);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.airmail-card {
			transition: none;
		}

		.airmail-goose {
			animation: none;
		}
	}
</style>
