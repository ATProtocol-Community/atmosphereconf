---
/**
 * Zero-padded numbered list with hairline dividers, for the dark sections.
 * Each item is a bold lead followed by plain text.
 */
interface Props {
	items: { lead?: string; text: string; accent?: string }[];
	label?: string;
}

const { items, label } = Astro.props;
---

<ol
	class="divide-y divide-white border-y border-white text-sm md:text-lg"
	aria-label={label}
>
	{
		items.map(({ lead, text, accent }, index) => (
			<li class="flex gap-6 pt-4.5 pb-5">
				<span class="w-5 shrink-0 pt-0.5 text-sm/5 md:w-10 md:text-base/5">
					{String(index + 1).padStart(2, "0")}
				</span>
				<p>
					{lead && <strong class="font-bold md:text-xl">{lead}</strong>}{" "}
					{accent && text.includes(accent) ? (
						<>
							{text.slice(0, text.indexOf(accent))}
							<strong class="font-bold text-orange">{accent}</strong>
							{text.slice(text.indexOf(accent) + accent.length)}
						</>
					) : (
						text
					)}
				</p>
			</li>
		))
	}
</ol>
