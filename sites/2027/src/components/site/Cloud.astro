---
import puffy from "../../../images/clouds/puffy.svg?url";
import bumpy from "../../../images/clouds/bumpy.svg?url";
import long from "../../../images/clouds/long.svg?url";

/** Decorative cloud, absolutely positioned by the caller's `class`. */
interface Props {
	shape: "puffy" | "bumpy" | "long";
	class: string;
	loading?: "lazy" | "eager";
}

const shapes = {
	puffy: { src: puffy, width: 451, height: 196 },
	bumpy: { src: bumpy, width: 449, height: 195 },
	long: { src: long, width: 735, height: 272 },
};

const { shape, class: className, loading } = Astro.props;
const { src, width, height } = shapes[shape];
---

<img
	class:list={["pointer-events-none absolute", className]}
	src={src}
	alt=""
	width={width}
	height={height}
	loading={loading}
/>
