---
import logo from "../../../images/logo/logo-large.svg?url";

const current = (href: string) =>
	Astro.url.pathname.replace(/\/$/, "") === href ? "page" : undefined;
const navLink =
	"aria-[current=page]:underline aria-[current=page]:decoration-2 aria-[current=page]:underline-offset-4";
---

<header id="page-top" tabindex="-1" class="border-b border-line bg-white">
	<nav
		class="wrap flex min-h-19 flex-wrap items-center gap-4.5 py-4 text-sm md:min-h-19.75 md:flex-nowrap md:gap-10 md:py-0"
		aria-label="Main navigation"
	>
		<a
			class="md:border-r md:border-[#ddd] md:pr-10"
			href="/"
			aria-label="AtmosphereConf 2027 home"
			><img
				class="w-26 tint-navy md:w-30"
				src={logo}
				alt="AtmosphereConf 2027"
				width="141"
				height="40"
			/></a
		>
		<div
			class="ml-auto flex items-center gap-4 text-xs md:ml-0 md:gap-10 md:text-sm [&>a:hover]:underline [&>a:hover]:underline-offset-4"
		>
			<a class={navLink} href="/speak" aria-current={current("/speak")}
				>Call for presentations</a
			>
			<a class={navLink} href="/science" aria-current={current("/science")}
				>Attend ATScience</a
			>
		</div>
	</nav>
</header>
