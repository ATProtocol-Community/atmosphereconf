---
import "../styles/global.css";
import logo from "../../images/logo/logo-large.svg?url";
import heart from "../../images/logo/heart.svg?url";
import flying from "../../images/guus/flying.svg?url";
import running from "../../images/guus/running.svg?url";
import walking from "../../images/guus/walking.svg?url";
import drinking from "../../images/guus/drinking.svg?url";
import puffy from "../../images/clouds/puffy.svg?url";
import bumpy from "../../images/clouds/bumpy.svg?url";
import longCloud from "../../images/clouds/long.svg?url";
import canal from "../../images/illustrations/canal.svg?url";
import stamp from "../../images/illustrations/stamp.svg?url";
import seattle from "../../images/illustrations/seattle-stamp.png";
import vancouver from "../../images/illustrations/vancouver-stamp.png";
import postmark from "../../images/postmark.svg?url";
import microphone from "../../images/icons/microphone.svg?url";
import crown from "../../images/icons/crown.svg?url";
import bluesky from "../../images/logo/bluesky-wordmark.svg?url";
import google from "../../images/logo/google-open-source.png";

const tickets = [
	{ name: "Early goose", price: "50", image: running },
	{ name: "Community goose", price: "199", image: walking },
	{ name: "Employed goose", price: "350", image: drinking },
	{ name: "Online goose", price: "10", image: running },
];
const audiences = [
	{
		name: "Builders",
		description: "Communities that care: developers, scientists & makers",
	},
	{
		name: "Creators",
		description:
			"Connoisseurs of internet culture: artists, musicians, creators",
	},
	{ name: "Storytellers", description: "News, media, and journalists" },
	{ name: "Stewards", description: "Policy makers and officials" },
];

const sectionPadding = "py-16 md:py-20 lg:py-30";
const eventDetails =
	"mb-7 flex justify-center gap-6 text-left md:mb-10 md:gap-12";
const eventTerm = "eyebrow text-[10px] md:text-sm/4";
const eventValue =
	"mt-2 font-display text-sm/6 uppercase md:mt-4 md:text-lg/10 lg:text-xl/10";
const cloud = "pointer-events-none absolute";
const themeButton = "btn btn-outline w-30 justify-between border-line px-3";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>AtmosphereConf 2027 — Building for a new internet</title>
		<meta
			name="description"
			content="The ATProto conference is back. Join builders, creators, storytellers, and stewards in Amsterdam, 29 April–1 May 2027."
		/>
		<meta
			property="og:title"
			content="AtmosphereConf 2027 — Building for a new internet"
		/>
		<meta
			property="og:description"
			content="29 April–1 May 2027 · KIT, Amsterdam. Three days building for a new internet."
		/>
		<meta property="og:image" content="https://atmosphereconf.org/og.png" />
		<meta property="og:type" content="website" />
		<meta name="twitter:card" content="summary_large_image" />
		<link rel="icon" href="/favicon.png" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Boldonse&family=Stack+Sans+Text:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<a
			class="absolute top-2.5 left-5 z-10 translate-y-[-160%] bg-white p-3 underline focus:translate-y-0"
			href="#main">Skip to content</a
		>
		<header class="border-b border-line bg-white">
			<nav
				class="wrap flex min-h-19 flex-wrap items-center gap-4.5 py-4 text-sm md:min-h-19.75 md:flex-nowrap md:gap-10 md:py-0"
				aria-label="Main navigation"
			>
				<a
					class="md:border-r md:border-[#ddd] md:pr-10"
					href="/"
					aria-label="AtmosphereConf 2027 home"
					><img
						class="w-26 tint-navy md:w-30"
						src={logo}
						alt="AtmosphereConf 2027"
						width="141"
						height="40"
					/></a
				>
				<div
					class="ml-auto flex items-center gap-4 text-xs md:ml-0 md:gap-10 md:text-sm [&>a:hover]:underline [&>a:hover]:underline-offset-4"
				>
					<a href="#tickets">Attend</a><a href="/speak">Call for papers</a>
				</div>
				<button
					class:list={[themeButton, "ml-auto hidden md:inline-flex"]}
					disabled
					title="Atmo theme"
					><svg
						width="20"
						height="20"
						viewBox="0 0 20 20"
						fill="none"
						stroke="currentColor"
						aria-hidden="true"
						><rect x="3" y="2" width="7" height="16" rx="1"></rect><path
							d="m10 4 6 5a1 1 0 0 1 0 2l-6 6M6.5 14v1"></path></svg
					>Atmo</button
				>
				<a class="-ml-7 btn hidden md:inline-flex" href="#tickets"
					>Early-bird tickets <span aria-hidden="true">▸</span></a
				>
			</nav>
		</header>
		<main id="main">
			<section
				class="relative min-h-180 overflow-hidden text-white sky-gradient md:min-h-212.5 lg:min-h-248"
				aria-labelledby="hero-title"
			>
				<div
					class="relative z-2 px-5 pt-19 pb-67.5 text-center md:px-6 md:pt-27.5 md:pb-70 lg:pt-32"
				>
					<h1 id="hero-title">
						<img
							class="mx-auto w-full max-w-132.5 md:w-[min(944px,80vw)] md:max-w-none"
							src={logo}
							alt="AtmosphereConf 2027"
							width="944"
							height="268"
							fetchpriority="high"
						/>
					</h1>
					<p
						class="my-7 display text-[clamp(19px,4vw,28px)] leading-[1.6] md:my-10 md:text-[32px] md:leading-[1.33] lg:text-[48px]"
					>
						Building for a new internet
					</p>
					<dl class={eventDetails}>
						<div>
							<dt class={eventTerm}>Three days</dt><dd class={eventValue}>
								29 Apr — 1 May
							</dd>
						</div><div>
							<dt class={eventTerm}>Venue</dt><dd class={eventValue}>
								KIT, Amsterdam
							</dd>
						</div>
					</dl>
					<div class="flex flex-wrap justify-center gap-2">
						<a class="btn" href="#tickets"
							>Early-bird tickets <span aria-hidden="true">▸</span></a
						><a class="btn btn-outline" href="/speak"
							>Apply to speak <span aria-hidden="true">▸</span></a
						>
					</div>
				</div>
				<img
					class:list={[
						cloud,
						"bottom-52.5 -left-17.5 w-37.5 md:bottom-68.75 md:-left-26.25 md:w-87.5",
					]}
					src={bumpy}
					alt=""
					width="449"
					height="195"
				/>
				<img
					class:list={[
						cloud,
						"-right-21.25 bottom-55 w-37.5 md:-right-8.75 md:bottom-78.75 md:w-66.25",
					]}
					src={puffy}
					alt=""
					width="451"
					height="196"
				/>
				<img
					class:list={[cloud, "-bottom-0.75 -left-15 w-65 md:left-0 md:w-125"]}
					src={puffy}
					alt=""
					width="451"
					height="196"
				/>
				<img
					class:list={[
						cloud,
						"-right-25 -bottom-0.75 w-87.5 md:right-0 md:w-168.75",
					]}
					src={longCloud}
					alt=""
					width="735"
					height="272"
				/>
				<img
					class="absolute right-[8%] bottom-6.25 w-52.5 md:right-[7%] md:bottom-12 md:w-67.5 lg:right-[13%] lg:w-81.5 xl:right-[calc(50%-530px)]"
					src={flying}
					alt=""
					width="326"
					height="269"
				/>
			</section>

			<section
				class:list={[
					"wrap grid grid-cols-[minmax(0,1fr)] gap-9 md:grid-cols-[1fr_1fr] lg:min-h-229.75",
					sectionPadding,
				]}
				aria-labelledby="intro-title"
			>
				<div class="contents md:block">
					<h2 class="title" id="intro-title">
						The ATProto<br />conference is<br />back
					</h2>
					<div
						class="relative order-3 mx-auto h-70 w-85 md:order-0 md:mx-0 md:mt-17.5 md:-mb-17.5 md:h-92.5 md:w-117.5 md:max-w-full md:origin-top-left md:scale-80 lg:mb-0 lg:scale-100"
					>
						<img
							class="absolute top-6.25 left-0 w-[53%] md:w-61.25"
							src={vancouver.src}
							alt="A speaker at the Vancouver ATProto conference"
							width={vancouver.width}
							height={vancouver.height}
							loading="lazy"
						/>
						<img
							class="absolute top-0 left-[44%] w-[53%] md:left-55 md:w-61.25"
							src={seattle.src}
							alt="The audience at the Seattle ATProto conference"
							width={seattle.width}
							height={seattle.height}
							loading="lazy"
						/>
						<img
							class="absolute bottom-0 left-[38%] w-[56%] md:left-47.5 md:w-62.5"
							src={postmark}
							alt=""
							width="250"
							height="125"
							loading="lazy"
						/>
					</div>
				</div>
				<div class="text-slate md:pt-10">
					<p>
						ATProto is the foundation: a shared protocol layer for building
						decentralized, interoperable, and resilient digital environments.
					</p>
					<p class="mt-8">
						The Atmosphere is the space where that protocol meets practice: a
						gathering of builders, researchers, and operators shaping the next
						network.
					</p>
					<p class="mt-8">
						This conference is designed to move from theory to implementation:
						aligning standards, testing real-world use cases, and building the
						teams that will carry the work forward.
					</p>
					<div
						class="mt-10 flex flex-wrap items-center gap-3 rounded-xl bg-cream p-4 text-navy md:gap-4 md:px-6 lg:flex-nowrap"
					>
						<img
							class="w-11 shrink-0 md:w-16"
							src={microphone}
							alt=""
							width="64"
							height="64"
						/><p class="flex-1 max-md:basis-[calc(100%-56px)]">
							<span class="block text-lg tracking-[-0.02em]"
								>Interested in speaking?</span
							><span class="block text-base text-slate"
								>View our Call for papers</span
							>
						</p><a class="btn btn-outline max-lg:ml-auto" href="/speak"
							>Call for papers <span aria-hidden="true">▸</span></a
						>
					</div>
				</div>
			</section>

			<section class="bg-cream" aria-labelledby="sponsors-title">
				<div class:list={["wrap", sectionPadding]}>
					<h2 class="title" id="sponsors-title">Sponsors</h2>
					<p class="mt-10 mb-4 eyebrow text-steel">Platinum</p>
					<div class="grid grid-cols-2 gap-3 md:gap-4">
						<a
							class="grid min-h-32.5 place-items-center rounded-[10px] bg-white px-3 py-2 md:min-h-50 md:rounded-2xl md:px-4"
							href="https://bsky.social"
							aria-label="Bluesky"
							><img
								src={bluesky}
								alt=""
								width="292"
								height="64"
								loading="lazy"
							/></a
						>
						<a
							class="grid min-h-32.5 place-items-center rounded-[10px] bg-white px-3 py-2 md:min-h-50 md:rounded-2xl md:px-4"
							href="https://opensource.google/"
							aria-label="Google Open Source"
							><img
								src={google.src}
								alt=""
								width="231"
								height="135"
								loading="lazy"
							/></a
						>
					</div>
					<div
						class="mt-10 flex flex-wrap items-center gap-3 rounded-xl bg-white p-4 text-navy md:gap-4 md:px-6 lg:flex-nowrap"
					>
						<img
							class="w-11 shrink-0 md:w-16"
							src={crown}
							alt=""
							width="64"
							height="64"
						/><p class="flex-1 max-md:basis-[calc(100%-56px)]">
							<span class="block text-lg tracking-[-0.02em]"
								>Interested in becoming a sponsor?</span
							><span class="block text-base text-slate"
								>Community sponsorship starts at €1.2k</span
							>
						</p><button
							class="btn btn-outline max-lg:ml-auto"
							disabled
							title="Sponsorship contact coming soon"
							>Get in touch <span aria-hidden="true">▸</span></button
						>
					</div>
				</div>
			</section>

			<section
				id="tickets"
				class="text-white sky-gradient"
				aria-labelledby="tickets-title"
			>
				<div class:list={["wrap", sectionPadding]}>
					<div class="mb-10 grid items-start gap-6 md:grid-cols-2 md:gap-9">
						<h2 class="title" id="tickets-title">Tickets</h2><p>
							Choose your ticket and join the community. All tickets include
							three days of entry, food and drinks, and an afterparty on the
							final day.
						</p>
					</div>
					<div class="grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-4 lg:gap-6">
						{
							tickets.map((ticket) => (
								<article class="flex min-h-90 flex-col items-center rounded-xl border border-line bg-white px-3 py-5 text-center text-navy md:min-h-105 md:py-6 lg:min-h-117.75 lg:px-4">
									<>
										<img
											class="mb-4 w-33.75 md:w-43.25"
											src={ticket.image}
											alt=""
											width="173"
											height="180"
											loading="lazy"
										/>
										<h3 class="text-[11px]/4 font-medium tracking-[0.03em] uppercase md:text-sm/4">
											{ticket.name}
										</h3>
										<p class="mt-2 font-display text-[32px]/12 tracking-normal">
											€{ticket.price}
										</p>
										<p class="mt-2 text-sm text-slate">Exc. 21% VAT</p>
										<button
											class="mt-8 btn uppercase md:mt-auto"
											disabled
											aria-label={`Purchase ${ticket.name} ticket — coming soon`}
										>
											Purchase <span aria-hidden="true">▸</span>
										</button>
									</>
								</article>
							))
						}
					</div>
					<div
						class="mt-4 flex flex-wrap items-center gap-5 rounded-[10px] bg-white p-6 text-navy md:flex-nowrap md:gap-8 md:px-12"
					>
						<div class="basis-full md:flex-1 md:basis-auto">
							<h3 class="font-display text-[19px]/10 uppercase md:text-xl/10">
								Opportunity ticket
							</h3><p class="mt-2 text-sm text-slate">
								We do not have any specific criteria for the opportunity
								tickets. If you think you deserve a free ticket or sponsorship
								to attend, then please apply.
							</p>
						</div><button class="btn" disabled title="Applications coming soon"
							>Apply <span aria-hidden="true">▸</span></button
						>
					</div>
				</div>
			</section>

			<section class="bg-blue text-white" aria-labelledby="audience-title">
				<div
					class="wrap grid gap-10 pt-16 pb-17.5 md:grid-cols-2 md:gap-12 md:pt-20 md:pb-25 lg:gap-19 lg:pt-30 lg:pb-46"
				>
					<h2 class="title" id="audience-title">
						Who attends &amp;<br />what to expect
					</h2><dl class="space-y-10 pb-6 md:space-y-16 md:py-6">
						{
							audiences.map((audience) => (
								<div>
									<>
										<dt class="eyebrow">{audience.name}</dt>
										<dd class="mt-4 max-w-152.5 display text-xl leading-[1.6] md:leading-loose">
											{audience.description}
										</dd>
									</>
								</div>
							))
						}
					</dl>
				</div>
				<img
					class="w-full max-md:min-h-47.5 max-md:object-cover max-md:object-center"
					src={canal}
					alt="Amsterdam canal houses, tulips, and boats, with a goose walking across a bridge"
					width="1440"
					height="448"
					loading="lazy"
				/>
			</section>

			<section class="bg-cream" aria-labelledby="invite-title">
				<div
					class="wrap flex flex-col items-center justify-center gap-8 py-16 md:flex-row md:gap-6 md:py-30 lg:gap-10"
				>
					<img
						class="w-57.5 md:w-[30%] lg:w-88"
						src={stamp}
						alt="An Amsterdam postage stamp with a cycling goose"
						width="381"
						height="489"
						loading="lazy"
					/>
					<div class="text-center">
						<img
							class="mx-auto mb-6 w-27.5 md:mb-10 md:w-auto"
							src={postmark}
							alt=""
							width="150"
							height="75"
							loading="lazy"
						/><h2 class="mb-10 title max-md:text-2xl/normal" id="invite-title">
							Send a postcard to<br />invite a friend
						</h2><dl class={eventDetails}>
							<div>
								<dt class={eventTerm}>Three days</dt><dd class={eventValue}>
									29 Apr — 1 May
								</dd>
							</div><div>
								<dt class={eventTerm}>Venue</dt><dd class={eventValue}>
									KIT, Amsterdam
								</dd>
							</div>
						</dl><div class="flex flex-wrap justify-center gap-2">
							<a class="btn" href="/postcard"
								>Send a postcard <span aria-hidden="true">▸</span></a
							><a class="btn btn-outline" href="#tickets"
								>Early-bird tickets <span aria-hidden="true">▸</span></a
							>
						</div>
					</div>
				</div>
			</section>
		</main>
		<footer
			class="relative overflow-hidden text-white sky-gradient max-md:min-h-162.5"
		>
			<div class="relative z-1 wrap pt-16 pb-40 md:pt-30 md:pb-45">
				<div
					class="grid grid-cols-2 gap-10 md:grid-cols-[1fr_150px_150px] md:gap-6 lg:grid-cols-[1fr_204px_204px]"
				>
					<div class="max-md:col-span-full">
						<dl class="mb-6 flex gap-6 text-left md:gap-12">
							<div>
								<dt class="eyebrow">Dates</dt><dd
									class="mt-1 text-sm uppercase"
								>
									29 Apr — 1 May
								</dd>
							</div><div>
								<dt class="eyebrow">Location</dt><dd
									class="mt-1 text-sm uppercase"
								>
									KIT, Amsterdam
								</dd>
							</div>
						</dl><div class="flex flex-wrap gap-2">
							<a class="btn" href="#tickets"
								>Early-bird tickets <span aria-hidden="true">▸</span></a
							><button
								class:list={[themeButton, "text-white"]}
								disabled
								title="Atmo theme"
								><svg
									width="20"
									height="20"
									viewBox="0 0 20 20"
									fill="none"
									stroke="currentColor"
									aria-hidden="true"
									><rect x="3" y="2" width="7" height="16" rx="1"></rect><path
										d="m10 4 6 5a1 1 0 0 1 0 2l-6 6M6.5 14v1"></path></svg
								>Atmo</button
							>
						</div>
					</div><nav
						class="*:mb-4.75 [&>*:last-child]:mb-0 [&>a]:block [&>a]:w-fit [&>a]:text-base/6 md:[&>a]:text-lg [&>a:hover]:underline [&>a:hover]:underline-offset-4"
						aria-label="Conference"
					>
						<h2 class="eyebrow before:mr-2 before:content-['▪']">
							Join Atmo27
						</h2><a href="#tickets">Attend</a><a href="/speak"
							>Call for papers</a
						>
					</nav><nav
						class="*:mb-4.75 [&>*:last-child]:mb-0 [&>a]:block [&>a]:w-fit [&>a]:text-base/6 md:[&>a]:text-lg [&>a:hover]:underline [&>a:hover]:underline-offset-4"
						aria-label="Community"
					>
						<h2 class="eyebrow before:mr-2 before:content-['▪']">
							Community
						</h2><a
							href="https://bsky.app/profile/did:plc:3xewinw4wtimo2lqfy5fm5sw"
							>Bluesky</a
						><a href="https://github.com/ATProtocol-Community/atmosphereconf"
							>GitHub</a
						>
						<span
							class="block cursor-not-allowed text-lg opacity-65"
							role="link"
							aria-disabled="true">YouTube</span
						><span
							class="block cursor-not-allowed text-lg opacity-65"
							role="link"
							aria-disabled="true">LinkedIn</span
						>
					</nav>
				</div>
				<p
					class="mt-14 flex flex-wrap items-center gap-3 font-display text-[27px] leading-[1.3] uppercase md:mt-30 md:flex-nowrap md:gap-[0.25em] md:text-[clamp(20px,5.4vw,78px)]/26.5 md:whitespace-nowrap"
				>
					<span class="max-md:basis-full">Atmosphere Conf</span><img
						class="w-16.25 md:w-[12%]"
						src={heart}
						alt=""
						width="206"
						height="129"
					/><span>2027</span>
				</p><p class="mt-6 text-xs/5 md:text-sm">
					Copyright 2026 © Atmosphere Conference
				</p>
			</div>
			<img
				class:list={[cloud, "-bottom-3.75 -left-7.5 w-57.5 md:left-0 md:w-105"]}
				src={bumpy}
				alt=""
				width="449"
				height="195"
				loading="lazy"
			/><img
				class:list={[
					cloud,
					"-bottom-7.5 left-[20%] w-60 md:left-[34%] md:w-115",
				]}
				src={puffy}
				alt=""
				width="451"
				height="196"
				loading="lazy"
			/><img
				class:list={[
					cloud,
					"-right-30 -bottom-1.25 w-80 md:-right-17.5 md:w-130",
				]}
				src={longCloud}
				alt=""
				width="735"
				height="272"
				loading="lazy"
			/>
		</footer>
	</body>
</html>
