---
import logo from "../../images/logo/logo-large.svg?url";
import heart from "../../images/logo/heart.svg?url";
import flying from "../../images/guus/flying.svg?url";
import running from "../../images/guus/running.svg?url";
import walking from "../../images/guus/walking.svg?url";
import drinking from "../../images/guus/drinking.svg?url";
import puffy from "../../images/clouds/puffy.svg?url";
import bumpy from "../../images/clouds/bumpy.svg?url";
import longCloud from "../../images/clouds/long.svg?url";
import canal from "../../images/illustrations/canal.svg?url";
import stamp from "../../images/illustrations/stamp.svg?url";
import seattle from "../../images/illustrations/seattle-stamp.png";
import vancouver from "../../images/illustrations/vancouver-stamp.png";
import postmark from "../../images/postmark.svg?url";
import microphone from "../../images/icons/microphone.svg?url";
import crown from "../../images/icons/crown.svg?url";
import bluesky from "../../images/logo/bluesky-wordmark.svg?url";
import google from "../../images/logo/google-open-source.png";

const tickets = [
	{ name: "Early goose", price: "50", image: running },
	{ name: "Community goose", price: "199", image: walking },
	{ name: "Employed goose", price: "350", image: drinking },
	{ name: "Online goose", price: "10", image: running },
];
const audiences = [
	{
		name: "Builders",
		description: "Communities that care: developers, scientists & makers",
	},
	{
		name: "Creators",
		description:
			"Connoisseurs of internet culture: artists, musicians, creators",
	},
	{ name: "Storytellers", description: "News, media, and journalists" },
	{ name: "Stewards", description: "Policy makers and officials" },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>AtmosphereConf 2027 — Building for a new internet</title>
		<meta
			name="description"
			content="The ATProto conference is back. Join builders, creators, storytellers, and stewards in Amsterdam, 29 April–1 May 2027."
		/>
		<meta
			property="og:title"
			content="AtmosphereConf 2027 — Building for a new internet"
		/>
		<meta
			property="og:description"
			content="29 April–1 May 2027 · KIT, Amsterdam. Three days building for a new internet."
		/>
		<meta property="og:image" content="https://atmosphereconf.org/og.png" />
		<meta property="og:type" content="website" />
		<meta name="twitter:card" content="summary_large_image" />
		<link rel="icon" href="/favicon.png" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Boldonse&family=Stack+Sans+Text:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<header class="site-header">
			<nav class="navigation container" aria-label="Main navigation">
				<a class="brand" href="/" aria-label="AtmosphereConf 2027 home"
					><img
						src={logo}
						alt="AtmosphereConf 2027"
						width="141"
						height="40"
					/></a
				>
				<div class="nav-links">
					<a href="#tickets">Attend</a><a href="/speak">Call for papers</a>
				</div>
				<button class="button theme-button outline" disabled title="Atmo theme"
					><svg
						width="20"
						height="20"
						viewBox="0 0 20 20"
						fill="none"
						stroke="currentColor"
						aria-hidden="true"
						><rect x="3" y="2" width="7" height="16" rx="1"></rect><path
							d="m10 4 6 5a1 1 0 0 1 0 2l-6 6M6.5 14v1"></path></svg
					>Atmo</button
				>
				<a class="button nav-ticket" href="#tickets"
					>Early-bird tickets <span aria-hidden="true">▸</span></a
				>
			</nav>
		</header>
		<main id="main">
			<section class="hero gradient" aria-labelledby="hero-title">
				<div class="hero-content">
					<h1 id="hero-title">
						<img
							src={logo}
							alt="AtmosphereConf 2027"
							width="944"
							height="268"
							fetchpriority="high"
						/>
					</h1>
					<p class="hero-tagline display">Building for a new internet</p>
					<dl class="event-details">
						<div><dt>Three days</dt><dd>29 Apr — 1 May</dd></div><div>
							<dt>Venue</dt><dd>KIT, Amsterdam</dd>
						</div>
					</dl>
					<div class="actions">
						<a class="button" href="#tickets"
							>Early-bird tickets <span aria-hidden="true">▸</span></a
						><a class="button outline" href="/speak"
							>Apply to speak <span aria-hidden="true">▸</span></a
						>
					</div>
				</div>
				<img
					class="cloud cloud-left"
					src={bumpy}
					alt=""
					width="449"
					height="195"
				/>
				<img
					class="cloud cloud-right"
					src={puffy}
					alt=""
					width="451"
					height="196"
				/>
				<img
					class="cloud cloud-bottom-left"
					src={puffy}
					alt=""
					width="451"
					height="196"
				/>
				<img
					class="cloud cloud-bottom-right"
					src={longCloud}
					alt=""
					width="735"
					height="272"
				/>
				<img class="hero-goose" src={flying} alt="" width="326" height="269" />
			</section>

			<section
				class="introduction section container"
				aria-labelledby="intro-title"
			>
				<div class="intro-art">
					<h2 id="intro-title">The ATProto<br />conference is<br />back</h2>
					<div class="photo-stamps">
						<img
							class="vancouver"
							src={vancouver.src}
							alt="A speaker at the Vancouver ATProto conference"
							width={vancouver.width}
							height={vancouver.height}
							loading="lazy"
						/>
						<img
							class="seattle"
							src={seattle.src}
							alt="The audience at the Seattle ATProto conference"
							width={seattle.width}
							height={seattle.height}
							loading="lazy"
						/>
						<img
							class="photo-postmark"
							src={postmark}
							alt=""
							width="250"
							height="125"
							loading="lazy"
						/>
					</div>
				</div>
				<div class="intro-copy">
					<p>
						ATProto is the foundation: a shared protocol layer for building
						decentralized, interoperable, and resilient digital environments.
					</p>
					<p>
						The Atmosphere is the space where that protocol meets practice: a
						gathering of builders, researchers, and operators shaping the next
						network.
					</p>
					<p>
						This conference is designed to move from theory to implementation:
						aligning standards, testing real-world use cases, and building the
						teams that will carry the work forward.
					</p>
					<div class="callout">
						<img src={microphone} alt="" width="64" height="64" /><p>
							<span class="callout-title">Interested in speaking?</span><span
								class="callout-subtitle">View our Call for papers</span
							>
						</p><a class="button outline" href="/speak"
							>Call for papers <span aria-hidden="true">▸</span></a
						>
					</div>
				</div>
			</section>

			<section class="sponsors cream" aria-labelledby="sponsors-title">
				<div class="section container">
					<h2 id="sponsors-title">Sponsors</h2>
					<p class="eyebrow sponsor-level">Platinum</p>
					<div class="sponsor-grid">
						<a class="sponsor" href="https://bsky.social" aria-label="Bluesky"
							><img
								src={bluesky}
								alt=""
								width="292"
								height="64"
								loading="lazy"
							/></a
						>
						<a
							class="sponsor"
							href="https://opensource.google/"
							aria-label="Google Open Source"
							><img
								src={google.src}
								alt=""
								width="231"
								height="135"
								loading="lazy"
							/></a
						>
					</div>
					<div class="callout">
						<img src={crown} alt="" width="64" height="64" /><p>
							<span class="callout-title">Interested in becoming a sponsor?</span
							><span class="callout-subtitle"
								>Community sponsorship starts at €1.2k</span
							>
						</p><button
							class="button outline"
							disabled
							title="Sponsorship contact coming soon"
							>Get in touch <span aria-hidden="true">▸</span></button
						>
					</div>
				</div>
			</section>

			<section
				id="tickets"
				class="tickets gradient"
				aria-labelledby="tickets-title"
			>
				<div class="section container">
					<div class="section-heading">
						<h2 id="tickets-title">Tickets</h2><p>
							Choose your ticket and join the community. All tickets include
							three days of entry, food and drinks, and an afterparty on the
							final day.
						</p>
					</div>
					<div class="ticket-grid">
						{
							tickets.map((ticket) => (
								<article class="ticket">
									<>
										<img
											src={ticket.image}
											alt=""
											width="173"
											height="180"
											loading="lazy"
										/>
										<h3>{ticket.name}</h3>
										<p class="price">€{ticket.price}</p>
										<p class="tax">Exc. 21% VAT</p>
										<button
											class="button"
											disabled
											aria-label={`Purchase ${ticket.name} ticket — coming soon`}
										>
											Purchase <span aria-hidden="true">▸</span>
										</button>
									</>
								</article>
							))
						}
					</div>
					<div class="opportunity">
						<div>
							<h3>Opportunity ticket</h3><p>
								We do not have any specific criteria for the opportunity
								tickets. If you think you deserve a free ticket or sponsorship
								to attend, then please apply.
							</p>
						</div><button
							class="button"
							disabled
							title="Applications coming soon"
							>Apply <span aria-hidden="true">▸</span></button
						>
					</div>
				</div>
			</section>

			<section class="audience" aria-labelledby="audience-title">
				<div class="section audience-content container">
					<h2 id="audience-title">Who attends &amp;<br />what to expect</h2><dl
						class="audience-list"
					>
						{
							audiences.map((audience) => (
								<div>
									<>
										<dt class="eyebrow">{audience.name}</dt>
										<dd class="display">{audience.description}</dd>
									</>
								</div>
							))
						}
					</dl>
				</div>
				<img
					class="canal"
					src={canal}
					alt="Amsterdam canal houses, tulips, and boats, with a goose walking across a bridge"
					width="1440"
					height="448"
					loading="lazy"
				/>
			</section>

			<section class="invite cream" aria-labelledby="invite-title">
				<div class="invite-content container">
					<img
						class="amsterdam-stamp"
						src={stamp}
						alt="An Amsterdam postage stamp with a cycling goose"
						width="381"
						height="489"
						loading="lazy"
					/>
					<div class="invite-copy">
						<img
							class="invite-postmark"
							src={postmark}
							alt=""
							width="150"
							height="75"
							loading="lazy"
						/><h2 id="invite-title">
							Send a postcard to<br />invite a friend
						</h2><dl class="event-details">
							<div><dt>Three days</dt><dd>29 Apr — 1 May</dd></div><div>
								<dt>Venue</dt><dd>KIT, Amsterdam</dd>
							</div>
						</dl><div class="actions">
							<a class="button" href="/postcard"
								>Send a postcard <span aria-hidden="true">▸</span></a
							><a class="button outline" href="#tickets"
								>Early-bird tickets <span aria-hidden="true">▸</span></a
							>
						</div>
					</div>
				</div>
			</section>
		</main>
		<footer class="footer gradient">
			<div class="footer-content container">
				<div class="footer-top">
					<div>
						<dl class="event-details">
							<div><dt>Dates</dt><dd>29 Apr — 1 May</dd></div><div>
								<dt>Location</dt><dd>KIT, Amsterdam</dd>
							</div>
						</dl><div class="actions footer-actions">
							<a class="button" href="#tickets"
								>Early-bird tickets <span aria-hidden="true">▸</span></a
							><button
								class="button theme-button outline"
								disabled
								title="Atmo theme"
								><svg
									width="20"
									height="20"
									viewBox="0 0 20 20"
									fill="none"
									stroke="currentColor"
									aria-hidden="true"
									><rect x="3" y="2" width="7" height="16" rx="1"></rect><path
										d="m10 4 6 5a1 1 0 0 1 0 2l-6 6M6.5 14v1"></path></svg
								>Atmo</button
							>
						</div>
					</div><nav aria-label="Conference">
						<h2 class="eyebrow">Join Atmo27</h2><a href="#tickets">Attend</a><a
							href="/speak">Call for papers</a
						>
					</nav><nav aria-label="Community">
						<h2 class="eyebrow">Community</h2><a
							href="https://bsky.app/profile/did:plc:3xewinw4wtimo2lqfy5fm5sw"
							>Bluesky</a
						><a href="https://github.com/ATProtocol-Community/atmosphereconf"
							>GitHub</a
						>
						<span class="unavailable-link" role="link" aria-disabled="true"
							>YouTube</span
						><span class="unavailable-link" role="link" aria-disabled="true"
							>LinkedIn</span
						>
					</nav>
				</div>
				<p class="footer-wordmark">
					<span>Atmosphere Conf</span><img
						src={heart}
						alt=""
						width="206"
						height="129"
					/><span>2027</span>
				</p><p class="copyright">Copyright 2026 © Atmosphere Conference</p>
			</div>
			<img
				class="cloud footer-cloud-one"
				src={bumpy}
				alt=""
				width="449"
				height="195"
				loading="lazy"
			/><img
				class="cloud footer-cloud-two"
				src={puffy}
				alt=""
				width="451"
				height="196"
				loading="lazy"
			/><img
				class="cloud footer-cloud-three"
				src={longCloud}
				alt=""
				width="735"
				height="272"
				loading="lazy"
			/>
		</footer>
	</body>
</html>

<style>
	:global(*) {
		box-sizing: border-box;
	}
	:global(html) {
		scroll-behavior: smooth;
		scroll-padding-top: 24px;
	}
	:global(body) {
		margin: 0;
		color: #001941;
		background: #fff;
		font-family: "Stack Sans Text", Arial, sans-serif;
		font-size: 20px;
		line-height: 1.6;
		letter-spacing: -0.01em;
	}
	:global(button),
	:global(a) {
		-webkit-tap-highlight-color: transparent;
	}
	:global(a) {
		color: inherit;
	}
	:global(a:focus-visible),
	:global(button:focus-visible) {
		outline: 3px solid #fe6e25;
		outline-offset: 5px;
	}
	:global(img) {
		display: block;
		max-width: 100%;
		height: auto;
	}
	h1,
	h2,
	h3,
	p,
	dl,
	dd {
		margin: 0;
	}
	h2,
	.display {
		font-family: "Boldonse", Impact, sans-serif;
		font-weight: 400;
		text-transform: uppercase;
	}
	h2 {
		font-size: 48px;
		line-height: 1.33;
	}
	.container {
		width: min(100% - 96px, 1344px);
		margin-inline: auto;
	}
	.section {
		padding-block: 120px;
	}
	.gradient {
		background: linear-gradient(
			180deg,
			#005fe2 0%,
			#7d7cd8 42%,
			#ea97df 77%,
			#eb9b9b 100%
		);
	}
	.cream {
		background: #faf7f2;
	}
	.skip-link {
		position: absolute;
		top: 10px;
		left: 20px;
		z-index: 10;
		padding: 12px;
		background: white;
		transform: translateY(-160%);
	}
	.skip-link:focus {
		transform: translateY(0);
	}
	.site-header {
		border-bottom: 1px solid #cdced0;
		background: #fff;
	}
	.navigation {
		display: flex;
		align-items: center;
		gap: 40px;
		min-height: 79px;
		font-size: 14px;
	}
	.brand {
		padding-right: 40px;
		border-right: 1px solid #ddd;
	}
	.brand img {
		width: 120px;
		filter: brightness(0) saturate(100%) invert(9%) sepia(59%) saturate(2454%)
			hue-rotate(197deg) brightness(92%) contrast(106%);
	}
	.nav-links {
		display: flex;
		align-items: center;
		gap: 40px;
	}
	.nav-links a,
	.footer nav a {
		text-decoration: none;
	}
	.nav-links a:hover,
	.footer nav a:hover {
		text-decoration: underline;
		text-underline-offset: 4px;
	}
	.button.theme-button {
		width: 120px;
		justify-content: space-between;
		padding-inline: 12px;
		border-color: #cdced0;
	}
	.navigation .theme-button {
		margin-left: auto;
	}
	.nav-ticket {
		margin-left: -28px;
	}
	.button {
		display: inline-flex;
		justify-content: center;
		align-items: center;
		gap: 8px;
		min-height: 48px;
		padding: 12px 16px;
		border: 1px solid #001941;
		border-radius: 4px;
		background: #001941;
		color: #fff;
		font:
			400 14px/1.4 "Stack Sans Text",
			Arial,
			sans-serif;
		text-decoration: none;
		white-space: nowrap;
	}
	a.button:hover {
		background: #023a97;
		border-color: #023a97;
		color: white;
	}
	.button.outline {
		background: transparent;
		color: #001941;
	}
	a.button.outline:hover {
		background: #001941;
		color: white;
	}
	button:disabled {
		cursor: not-allowed;
		opacity: 0.65;
	}
	.actions {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 8px;
	}
	.hero {
		min-height: 992px;
		position: relative;
		overflow: hidden;
		color: white;
	}
	.hero-content {
		position: relative;
		z-index: 2;
		padding: 128px 24px 280px;
		text-align: center;
	}
	h1 img {
		width: min(944px, 80vw);
		margin-inline: auto;
	}
	.hero-tagline {
		margin: 40px auto;
		font-size: 48px;
		line-height: 1.33;
	}
	.event-details {
		display: flex;
		justify-content: center;
		gap: 48px;
		margin-bottom: 40px;
		text-align: left;
	}
	.event-details dt,
	.eyebrow {
		font-size: 12px;
		line-height: 16px;
		text-transform: uppercase;
		font-weight: 500;
		letter-spacing: 0.03em;
	}
	.event-details dt {
		font-size: 14px;
	}
	.event-details dd {
		margin-top: 16px;
		font:
			400 20px/40px "Boldonse",
			Impact,
			sans-serif;
		text-transform: uppercase;
	}
	.cloud {
		position: absolute;
		pointer-events: none;
	}
	.cloud-left {
		width: 350px;
		left: -105px;
		bottom: 275px;
	}
	.cloud-right {
		width: 265px;
		right: -35px;
		bottom: 315px;
	}
	.cloud-bottom-left {
		width: 500px;
		left: 0;
		bottom: -3px;
	}
	.cloud-bottom-right {
		width: 675px;
		right: 0;
		bottom: -3px;
	}
	.hero-goose {
		position: absolute;
		width: 326px;
		right: 13%;
		bottom: 48px;
	}
	.introduction {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 36px;
		min-height: 919px;
	}
	.intro-copy {
		padding-top: 40px;
		color: #525c6c;
	}
	.intro-copy > p + p {
		margin-top: 32px;
	}
	.photo-stamps {
		position: relative;
		width: 470px;
		max-width: 100%;
		height: 370px;
		margin-top: 70px;
	}
	.photo-stamps .vancouver {
		position: absolute;
		width: 245px;
		left: 0;
		top: 25px;
	}
	.photo-stamps .seattle {
		position: absolute;
		width: 245px;
		left: 220px;
		top: 0;
	}
	.photo-postmark {
		position: absolute;
		width: 250px;
		left: 190px;
		bottom: 0;
	}
	.callout {
		display: flex;
		align-items: center;
		gap: 16px;
		padding: 16px 24px;
		margin-top: 40px;
		border-radius: 12px;
		background: #faf7f2;
		color: #001941;
	}
	.callout > img {
		flex: 0 0 64px;
		width: 64px;
	}
	.callout p {
		flex: 1;
	}
	.callout-title {
		display: block;
		font-size: 18px;
		line-height: 24px;
		letter-spacing: -0.02em;
	}
	.callout-subtitle {
		display: block;
		font-size: 16px;
		line-height: 20px;
		color: #525c6c;
	}
	.sponsor-level {
		margin: 40px 0 16px;
		color: #777e89;
	}
	.sponsor-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 16px;
	}
	.sponsor {
		display: grid;
		place-items: center;
		min-height: 200px;
		padding: 8px 16px;
		border-radius: 16px;
		background: white;
		text-decoration: none;
