---
import SignupPostcard from "../components/postcard/SignupPostcard.astro";
import { signupCard } from "../components/lib/subscribe";
import PostcardLayout from "../layouts/PostcardLayout.astro";

const title = "Back At It — AtmosphereConf #3";
const description =
	"AtmosphereConf #3. Spring 2027. Somewhere in Amsterdam (and online).";
const card = await signupCard(Astro);
---

<PostcardLayout title={title} description={description}>
	<Fragment slot="head">
		<script is:inline>
			// First-time visitors see the RSVP card before the homepage. It's
			// done here rather than as a server redirect so link previews and
			// crawlers (which never keep state) still get the homepage.
			try {
				if (!localStorage.getItem("2027:last-visit")) {
					location.replace("/rsvp");
				}
			} catch {
				// no storage access, so no way to do it only once: skip it
			}
		</script>
	</Fragment>
	<SignupPostcard card={card} />
</PostcardLayout>
