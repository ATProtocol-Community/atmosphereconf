---
import PostcardFrame from "../components/postcard/PostcardFrame.astro";
import PostcardHeader from "../components/postcard/PostcardHeader.astro";
import PostcardLayout from "../layouts/PostcardLayout.astro";
import BuildIcon from "../components/talks/build.svg";
import CreateIcon from "../components/talks/create.svg";
import GovernIcon from "../components/talks/govern.svg";
import InformIcon from "../components/talks/inform.svg";
import Microphone from "../components/talks/microphone.svg";

const title = "Talks — AtmosphereConf 2027";
const description =
	"Speak at AtmosphereConf 2027 in Amsterdam, 29 April to 2 May. Submit a talk on building, creating, informing, or governing the Atmosphere.";
const topics = [
	{
		name: "Build",
		Icon: BuildIcon,
		description:
			"Apps, infra, protocol, tooling. How they work, and how they break.",
	},
	{
		name: "Create",
		Icon: CreateIcon,
		description:
			"Art, games, fandom, and culture, made and connected in the open.",
	},
	{
		name: "Inform",
		Icon: InformIcon,
		description:
			"Journalism, publishing, and the fight for reliable, trustworthy information.",
	},
	{
		name: "Govern",
		Icon: GovernIcon,
		description:
			"Moderation, safety, policy, and the rules that shape and protect our spaces.",
	},
];
// Replace with the external submission form URL.
const submissionUrl = "#";
const scribblePath =
	"M5 73 Q32 48 60 29 L34 75 Q82 48 130 31 L106 74 Q155 48 202 32 L177 73 Q235 48 301 35 L279 67";
---

<PostcardLayout title={title} description={description}>
	<PostcardFrame
		label="AtmosphereConf 2027 call for talks"
	>
		<span slot="first-word" class="corrected-word">
			<span class="crossed-out" aria-hidden="true">Back</span>
			<svg
				class="scribble"
				viewBox="0 0 320 100"
				preserveAspectRatio="none"
				aria-hidden="true"
				focusable="false"
			>
				<path class="scribble-edge" d={scribblePath}></path>
				<path class="scribble-core" d={scribblePath}></path>
			</svg>
			<span class="replacement">speak</span>
		</span>
		<PostcardHeader
			decorationLane={0.3}
			title="Spread your wings...and thoughts!"
		>
			<Fragment slot="decoration"><Microphone class="talks-mic" /></Fragment>
			<Fragment slot="subtitle">
				AtmosphereConf’s first Call for Talks is here: developers, artists,
				journalists, moderators, writers, informers, informed, and all who make
				the atmosphere,{" "}
				<a class="form-actions-link" href={submissionUrl}>let’s hear from you!</a>
			</Fragment>
		</PostcardHeader>
		<ul class="topics" aria-label="Talk tracks">
			{
				topics.map((topic) => (
					<li class="topic">
						<h2>
							<topic.Icon class="topic-icon" aria-hidden="true" />
							{topic.name}
						</h2>
						<p>{topic.description}</p>
					</li>
				))
			}
		</ul>
		<a class="postcard-action small-action" href={submissionUrl}>
			Submit your talk <span aria-hidden="true">↗</span>
		</a>
		<p class="keep-in-touch">
			Not ready yet? <a class="form-actions-link" href="/rsvp">RSVP</a> or{" "}
			<a class="form-actions-link" href="/">Keep in Touch!</a>
		</p>
	</PostcardFrame>
</PostcardLayout>

<style>
	.corrected-word {
		position: relative;
		display: inline-block;
		margin-top: 0.25em;
	}

	.scribble {
		position: absolute;
		inset: 0 -14% 0 -2%;
		width: 116%;
		height: 100%;
		fill: none;
		stroke-linecap: round;
		stroke-linejoin: round;
		pointer-events: none;
	}

	.scribble-edge {
		stroke: var(--strong);
		stroke-width: 9;
	}

	.scribble-core {
		stroke: var(--butter);
		stroke-width: 4;
	}

	.replacement {
		position: absolute;
		top: -10%;
		right: 0;
		left: 0;
		text-align: center;
		font: inherit;
		font-family: "Yellowtail", var(--heading-font), sans-serif;
		font-weight: 400;
		letter-spacing: 0;
		white-space: nowrap;
		color: white;
		-webkit-text-stroke: 0.09em var(--strong);
		paint-order: stroke fill;
		transform: rotate(-5deg) scale(0.92);
		transform-origin: center;
	}

	.talks-mic {
		translate: 0 -45%;
	}

	.topics {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 12px;
		margin: 0 0 20px;
		padding: 0;
		list-style: none;
	}

	.topic {
		padding: 16px;
		border: 1px solid var(--ink);
		border-radius: 16px;
		background: color-mix(in srgb, var(--paper) 78%, white);
	}

	.topic h2 {
		margin: 0 0 8px;
		font-family: var(--heading-font), "Avenir Next", sans-serif;
		font-size: 18px;
		font-weight: 700;
		line-height: 1.2;
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.topic-icon {
		flex: none;
		width: 30px;
		height: 30px;
	}

	.topic p {
		margin: 0;
		font-size: 13px;
		line-height: 1.4;
	}

	/* Full width like the topic grid, label centered over "Not ready yet?". */
	.small-action {
		display: flex;
		justify-content: center;
	}

	:global(body[data-palette="pronouns"]) .small-action {
		--fill: var(--strong);
		color: var(--accent-contrast);
	}

	.keep-in-touch {
		margin: 14px 0 0;
		font-size: 14px;
		line-height: 1.5;
		text-align: center;
	}

	@media (max-width: 660px) {
		.topics {
			grid-template-columns: 1fr;
		}
	}
</style>
